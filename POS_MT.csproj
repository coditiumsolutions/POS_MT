<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.31">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Publish output lives under build/ — exclude it so publish does not recurse into itself. -->
  <ItemGroup>
    <Content Remove="build\**;pos_mt\**;pos_mt_02\**;pos_mt_03\**;pos_mt_3\**;pos_mt_4\**;pos_16Oct26\**;pos_mt_17Oct2026\**;pos_22_oct_26\**;pos_23_oct_26\**;bin\**;obj\**" />
    <None Remove="build\**;pos_mt\**;pos_mt_02\**;pos_mt_03\**;pos_mt_3\**;pos_mt_4\**;pos_16Oct26\**;pos_mt_17Oct2026\**;pos_22_oct_26\**;pos_23_oct_26\**;bin\**;obj\**" />
    <EmbeddedResource Remove="build\**;pos_mt\**;pos_mt_02\**;pos_mt_03\**;pos_mt_3\**;pos_mt_4\**;pos_16Oct26\**;pos_mt_17Oct2026\**;pos_22_oct_26\**;pos_23_oct_26\**;bin\**;obj\**" />
  </ItemGroup>

  <!--
    Local runs use ASPNETCORE_ENVIRONMENT=Development (appsettings.Development.json).
    IIS / published hosts default to Production and only read appsettings.json.
    After publish, copy the real POS_MT connection string into the published appsettings.json
    so the server uses the same DB as local without committing secrets to source control.
  -->
  <Target Name="ApplyDevConnectionStringOnPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_DevSettings>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\appsettings.Development.json'))</_DevSettings>
      <_PublishSettings>$([System.IO.Path]::GetFullPath('$(PublishDir)appsettings.json'))</_PublishSettings>
      <_ApplyCsScript>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\scripts\apply-dev-connection-string.ps1'))</_ApplyCsScript>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DevSettings)')" Text="appsettings.Development.json is missing. Create it from appsettings.Example.json before publishing." />
    <Error Condition="!Exists('$(_ApplyCsScript)')" Text="Missing scripts\apply-dev-connection-string.ps1" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_ApplyCsScript)&quot; -DevSettings &quot;$(_DevSettings)&quot; -PublishSettings &quot;$(_PublishSettings)&quot;" />
    <Message Importance="high" Text="Applied Development connection string to $(PublishDir)appsettings.json" />
  </Target>

  <!-- Optional: include local offline catalog in publish output (App_Data is gitignored). -->
  <Target Name="CopyOfflineSqliteOnPublish" AfterTargets="ApplyDevConnectionStringOnPublish">
    <PropertyGroup>
      <_OfflineDb>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\App_Data\pos-offline.db'))</_OfflineDb>
      <_PublishAppData>$([System.IO.Path]::GetFullPath('$(PublishDir)App_Data\'))</_PublishAppData>
    </PropertyGroup>
    <MakeDir Directories="$(_PublishAppData)" Condition="Exists('$(_OfflineDb)')" />
    <Copy SourceFiles="$(_OfflineDb)" DestinationFolder="$(_PublishAppData)" SkipUnchangedFiles="true" Condition="Exists('$(_OfflineDb)')" />
    <Message Importance="high" Condition="Exists('$(_OfflineDb)')" Text="Copied offline SQLite to $(PublishDir)App_Data\" />
    <Warning Condition="!Exists('$(_OfflineDb)')"
             Text="No App_Data\pos-offline.db — run 'dotnet run -- offline pull' before publish for Local Hub Offline mode." />
  </Target>

</Project>
