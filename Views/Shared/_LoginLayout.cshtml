<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coditium POS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login-split">
        <section class="login-split-visual" aria-label="Coditium POS branding">
            <div class="login-visual-media" aria-hidden="true">
                <img class="login-visual-photo"
                     src="~/images/login/bg-inventory.jpg"
                     asp-append-version="true"
                     width="1400"
                     height="933"
                     alt=""
                     loading="eager"
                     decoding="async" />
                <div class="login-visual-overlay"></div>
                <div class="login-visual-glow login-visual-glow-1"></div>
                <div class="login-visual-glow login-visual-glow-2"></div>
            </div>

            <div class="login-visual-content">
                <h1 class="login-visual-brand">Smart POS</h1>

                <div class="login-visual-showcase" aria-hidden="true">
                    <figure class="login-showcase-card">
                        <img src="~/images/login/pos-checkout.jpg"
                             asp-append-version="true"
                             width="640"
                             height="420"
                             alt="Point of Sale"
                             loading="eager"
                             decoding="async" />
                        <figcaption>Point of Sale</figcaption>
                    </figure>
                    <figure class="login-showcase-card">
                        <img src="~/images/login/inventory-warehouse.jpg"
                             asp-append-version="true"
                             width="640"
                             height="420"
                             alt="Inventory"
                             loading="eager"
                             decoding="async" />
                        <figcaption>Inventory</figcaption>
                    </figure>
                </div>

                <div class="login-modules">
                    <ul class="login-visual-features">
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-receipt"></i></span>
                            <span>Sales Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-bag-check"></i></span>
                            <span>Purchase Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-box-seam"></i></span>
                            <span>Stock Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
                            <span>Employee Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-truck"></i></span>
                            <span>Vendor Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                            <span>Expense Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-boxes"></i></span>
                            <span>Inventories Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-sliders"></i></span>
                            <span>Adjustments Management</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-file-earmark-bar-graph"></i></span>
                            <span>Advance Reporting</span>
                        </li>
                        <li>
                            <span class="login-feature-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
                            <span>AI Analysis</span>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <section class="login-split-form">
            <div class="login-form-panel">
                @RenderBody()
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
