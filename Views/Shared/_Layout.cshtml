@using Microsoft.AspNetCore.Antiforgery
@using POS_MT.Interfaces
@using POS_MT.Services
@inject INavContextService NavContext
@inject IAntiforgery Antiforgery
@{
    var currentArea = NavContext.CurrentArea;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var afTokens = Antiforgery.GetAndStoreTokens(Context);
    var sessionUserName = Context.Session.GetString(POS_MT.Controllers.AccountController.SessionUserNameKey);
    var sessionTerminal = Context.Session.GetString(POS_MT.Controllers.AccountController.SessionTerminalNameKey);
    var sessionBranch = Context.Session.GetString(POS_MT.Controllers.AccountController.SessionBranchKey);
    if (string.IsNullOrWhiteSpace(sessionUserName))
        sessionUserName = User.FindFirst("UserName")?.Value ?? User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(sessionTerminal))
        sessionTerminal = User.FindFirst("TerminalName")?.Value;
    if (string.IsNullOrWhiteSpace(sessionBranch))
        sessionBranch = User.FindFirst("Branch")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coditium POS</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#0f766e" />
    <meta name="request-verification-token" content="@afTokens.RequestToken" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="pos-shell">
        <div class="pos-header-bars">
            <header class="pos-topbar-primary">
                <div class="pos-brand">
                    <span>Coditium POS</span>
                </div>
                <div class="pos-user">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span id="hubStatusBadge"
                              class="hub-status-badge hub-status-unknown"
                              title="Checking connectivity..."
                              data-hub-status
                              role="status"
                              aria-live="polite">
                            <span class="hub-status-dot" aria-hidden="true"></span>
                            <span class="hub-status-text">Checking…</span>
                        </span>
                        <div class="pos-top-dropdown hub-mode-dropdown" data-top-dropdown data-work-mode-menu title="Database work mode (Local Hub)">
                            <div class="pos-top-dropdown-trigger">
                                <span class="hub-mode-label" data-work-mode-label>Mode: Auto</span>
                                <button type="button"
                                        class="hub-mode-twistee"
                                        aria-expanded="false"
                                        aria-label="Expand Mode"
                                        data-top-twistee>
                                    <i class="bi bi-caret-down-fill" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="pos-top-dropdown-menu hub-mode-menu" hidden>
                                <button type="button" class="pos-top-dropdown-item" data-work-mode="Offline">Offline</button>
                                <button type="button" class="pos-top-dropdown-item" data-work-mode="Auto">Auto</button>
                                <button type="button" class="pos-top-dropdown-item" data-work-mode="Online">Online</button>
                            </div>
                        </div>
                        <div id="hubModeMessage" class="hub-mode-message" hidden role="status" aria-live="polite"></div>
                        <div class="pos-session-meta" title="Signed-in user session">
                            <span class="pos-session-item"><span class="pos-session-label">User</span> @(string.IsNullOrWhiteSpace(sessionUserName) ? "—" : sessionUserName)</span>
                            <span class="pos-session-item"><span class="pos-session-label">Terminal</span> @(string.IsNullOrWhiteSpace(sessionTerminal) ? "—" : sessionTerminal)</span>
                            <span class="pos-session-item"><span class="pos-session-label">Branch</span> @(string.IsNullOrWhiteSpace(sessionBranch) ? "—" : sessionBranch)</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
            </header>

            <header class="pos-topbar-secondary">
                <nav class="pos-top-nav">
                    <a class="pos-top-link @(IsController("Dashboard") || string.Equals(currentArea?.Key, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       asp-controller="Nav" asp-action="Clear">Home</a>
                    @foreach (var area in NavigationCatalog.TopAreas)
                    {
                        var areaActive = string.Equals(area.Key, "AllModules", StringComparison.OrdinalIgnoreCase)
                            ? NavigationCatalog.IsUnderAllModules(currentArea?.Key)
                            : string.Equals(currentArea?.Key, area.Key, StringComparison.OrdinalIgnoreCase);
                        if (string.Equals(area.Key, "AllModules", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="pos-top-dropdown @(areaActive ? "active" : "")" data-top-dropdown>
                                <div class="pos-top-dropdown-trigger">
                                    <a class="pos-top-link @(areaActive ? "active" : "")"
                                       asp-controller="Nav"
                                       asp-action="Select"
                                       asp-route-key="@area.Key">@area.Title</a>
                                    <button type="button"
                                            class="pos-top-twistee"
                                            aria-expanded="false"
                                            aria-label="Expand @area.Title"
                                            data-top-twistee>
                                        <i class="bi bi-caret-right-fill" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <div class="pos-top-dropdown-menu" hidden>
                                    @foreach (var link in area.SubLinks)
                                    {
                                        <a class="pos-top-dropdown-item"
                                           asp-controller="@link.Controller"
                                           asp-action="@link.Action">@link.Title</a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="pos-top-link @(areaActive ? "active" : "")"
                               asp-controller="Nav"
                               asp-action="Select"
                               asp-route-key="@area.Key">@area.Title</a>
                        }
                    }
                </nav>
            </header>

            <div class="pos-gold-bar" aria-hidden="true"></div>
        </div>

        <div class="pos-body">
            <aside class="pos-sidebar" id="posSidebar">
                <div class="pos-sidebar-toggle-row">
                    <button type="button"
                            class="pos-sidebar-toggle"
                            id="posSidebarToggle"
                            aria-label="Collapse sidebar"
                            title="Collapse sidebar"
                            aria-expanded="true">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                </div>
                <nav class="pos-nav" id="posSidebarNav">
                    @if (currentArea is not null)
                    {
                        <div class="pos-nav-label">@currentArea.Title</div>
                        @foreach (var link in currentArea.SubLinks)
                        {
                            if (link.Children is { Count: > 0 })
                            {
                                var groupActive = link.Children.Any(child =>
                                    !string.IsNullOrWhiteSpace(child.Controller)
                                    && IsController(child.Controller)
                                    && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), child.Action, StringComparison.OrdinalIgnoreCase));
                                var groupGold = string.Equals(link.Title, "Categories", StringComparison.OrdinalIgnoreCase);
                                <div class="pos-nav-group @(groupActive ? "open active" : "open")" data-side-nav-group>
                                    <button type="button"
                                            class="pos-nav-link pos-nav-group-toggle @(groupGold ? "pos-nav-gold" : "")"
                                            aria-expanded="true"
                                            data-side-nav-twistee>
                                        @if (!string.IsNullOrWhiteSpace(link.IconClass))
                                        {
                                            <i class="bi @link.IconClass" aria-hidden="true"></i>
                                        }
                                        <span>@link.Title</span>
                                        <i class="bi bi-caret-right-fill pos-nav-group-caret" aria-hidden="true"></i>
                                    </button>
                                    <div class="pos-nav-group-menu">
                                        @foreach (var child in link.Children)
                                        {
                                            if (string.IsNullOrWhiteSpace(child.Controller))
                                            {
                                                continue;
                                            }
                                            var childActive = IsController(child.Controller)
                                                              && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), child.Action, StringComparison.OrdinalIgnoreCase);
                                            <a class="pos-nav-link pos-nav-sublink @(childActive ? "active" : "")"
                                               asp-controller="@child.Controller"
                                               asp-action="@child.Action"
                                               asp-route-filter="@child.Filter"
                                               asp-route-itemMonth="@child.ItemMonth"
                                               asp-route-navArea="@child.NavArea">
                                                @if (!string.IsNullOrWhiteSpace(child.IconClass))
                                                {
                                                    <i class="bi @child.IconClass" aria-hidden="true"></i>
                                                }
                                                <span>@child.Title</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(link.Controller))
                            {
                                var linkActive = IsController(link.Controller)
                                                 && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), link.Action, StringComparison.OrdinalIgnoreCase);
                                <a class="pos-nav-link @(linkActive ? "active" : "")"
                                   asp-controller="@link.Controller"
                                   asp-action="@link.Action"
                                   asp-route-filter="@link.Filter"
                                   asp-route-itemMonth="@link.ItemMonth"
                                   asp-route-navArea="@link.NavArea">
                                    <i class="bi @link.IconClass" aria-hidden="true"></i>
                                    <span>@link.Title</span>
                                </a>
                            }
                            else
                            {
                                <a class="pos-nav-link" href="#">
                                    <i class="bi @link.IconClass" aria-hidden="true"></i>
                                    <span>@link.Title</span>
                                </a>
                            }
                        }
                    }
                    else
                    {
                        <div class="pos-nav-label">Dashboard</div>
                    }

                    <div class="pos-nav-permanent">
                        <a class="pos-nav-link pos-nav-accent @(IsController("Modules") ? "active" : "")"
                           asp-controller="Modules" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
                            <span>Modules</span>
                        </a>
                        <a class="pos-nav-link pos-nav-accent @(IsController("Setup") ? "active" : "")"
                           asp-controller="Setup" asp-action="Index">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                            <span>Setup</span>
                        </a>
                    </div>
                </nav>
            </aside>
            <div class="pos-backdrop" id="posBackdrop"></div>

            <div class="pos-main">
                <main class="pos-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private bool IsController(string controller)
    {
        var current = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(current, controller, StringComparison.OrdinalIgnoreCase);
    }
}
