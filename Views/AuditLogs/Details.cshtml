@model AuditLog
@{ ViewData["Title"] = "Audit Log Details"; }
<h1 class="page-heading mb-3">Audit Log Details</h1>
<div class="bg-white border rounded p-3"><dl class="row mb-0">
<dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.LogDate</dd>
<dt class="col-sm-3">Module</dt><dd class="col-sm-9">@Model.ModuleName</dd>
<dt class="col-sm-3">Action</dt><dd class="col-sm-9">@Model.ActionName</dd>
<dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
<dt class="col-sm-3">IP</dt><dd class="col-sm-9">@Model.Ipaddress</dd>
</dl><div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
