@model IEnumerable<AuditLog>
@{ ViewData["Title"] = "Audit Logs"; }
<div class="mb-3"><h1 class="page-heading mb-1">Audit Logs</h1><p class="text-muted mb-0">Read-only activity history (latest 500).</p></div>
<div class="table-responsive bg-white border rounded p-2"><table id="crudTable" class="table table-striped table-hover w-100"><thead><tr><th>Date</th><th>Module</th><th>Action</th><th>UserUID</th><th>Description</th><th></th></tr></thead><tbody>
@foreach (var item in Model){<tr><td>@item.LogDate.ToString("yyyy-MM-dd HH:mm")</td><td>@item.ModuleName</td><td>@item.ActionName</td><td>@item.UserUid</td><td>@item.Description</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a></td></tr>}
</tbody></table></div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
