@model EmployeeFormViewModel
@{ ViewData["Title"] = "Edit Employee"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-heading mb-0">Edit Employee</h1>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Uid">Back</a>
</div>
<form asp-action="Edit" method="post" class="bg-white border rounded p-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Uid" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <partial name="_Form" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Uid">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
