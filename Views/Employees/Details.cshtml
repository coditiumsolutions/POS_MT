@model EmployeeDetailsViewModel
@{
    ViewData["Title"] = Model.Employee.EmployeeName;
    var e = Model.Employee;
    var monthName = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(Model.PeriodMonth);
}
<div class="employee-details-page">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="page-heading mb-1">@e.EmployeeName</h1>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@e.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">All Employees</a>
    </div>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" class="bg-white border rounded p-2 mb-3">
    <input type="hidden" name="id" value="@e.Uid" />
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label mb-1" for="month">Salary period</label>
            <select class="form-select form-select-sm" id="month" name="month">
                @for (var m = 1; m <= 12; m++)
                {
                    var name = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m);
                    if (m == Model.PeriodMonth) { <option value="@m" selected>@name</option> }
                    else { <option value="@m">@name</option> }
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label mb-1" for="year">Year</label>
            <select class="form-select form-select-sm" id="year" name="year">
                @for (var y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                {
                    if (y == Model.PeriodYear) { <option value="@y" selected>@y</option> }
                    else { <option value="@y">@y</option> }
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Show</button>
        </div>
    </div>
</form>

<div class="product-tabs" id="employeeDetailsTabs">
    <div class="product-tab-buttons" role="tablist" aria-label="Employee detail tabs">
        <button type="button" class="product-tab-btn active" data-tab="personal" role="tab" aria-selected="true" aria-controls="emp-panel-personal">Personal Detail</button>
        <button type="button" class="product-tab-btn" data-tab="salary" role="tab" aria-selected="false" aria-controls="emp-panel-salary">Salary Details</button>
        <button type="button" class="product-tab-btn" data-tab="allowances" role="tab" aria-selected="false" aria-controls="emp-panel-allowances">Allowances - Deductions</button>
        <button type="button" class="product-tab-btn" data-tab="payments" role="tab" aria-selected="false" aria-controls="emp-panel-payments">Payments</button>
    </div>

    <div class="product-tab-panel active" id="emp-panel-personal" data-panel="personal" role="tabpanel">
        <div class="bg-white border rounded p-3 mb-3">
            <h2 class="h5 mb-3">Personal Detail</h2>
            <div class="row g-3">
                <div class="col-md-3"><div class="employee-details-title">Employee Code</div><div class="employee-details-value">@e.EmployeeCode</div></div>
                <div class="col-md-3"><div class="employee-details-title">Employee Name</div><div class="employee-details-value">@e.EmployeeName</div></div>
                <div class="col-md-3"><div class="employee-details-title">CNIC</div><div class="employee-details-value">@(e.Cnic ?? "—")</div></div>
                <div class="col-md-3"><div class="employee-details-title">Status</div><div class="employee-details-value">@(e.IsActive ? "Active" : "Inactive")</div></div>
            </div>
        </div>
        <div class="bg-white border rounded p-3">
            <h2 class="h5 mb-3">Contact Information</h2>
            <div class="row g-3">
                <div class="col-md-3"><div class="employee-details-title">Mobile 1</div><div class="employee-details-value">@(e.MobileNo1 ?? "—")</div></div>
                <div class="col-md-3"><div class="employee-details-title">Mobile 2</div><div class="employee-details-value">@(e.MobileNo2 ?? "—")</div></div>
                <div class="col-md-3"><div class="employee-details-title">Present Address</div><div class="employee-details-value">@(e.PresentAddress ?? "—")</div></div>
                <div class="col-md-3"><div class="employee-details-title">Permanent Address</div><div class="employee-details-value">@(e.PermanentAddress ?? "—")</div></div>
            </div>
        </div>
    </div>

    <div class="product-tab-panel" id="emp-panel-salary" data-panel="salary" role="tabpanel" hidden>
        <div class="row g-3">
            <div class="col-md-4 col-sm-6"><div class="bg-white border rounded p-3 h-100"><div class="employee-details-title">Total Salary</div><div class="employee-details-value">@Model.TotalSalary.ToString("N2")</div></div></div>
            <div class="col-md-4 col-sm-6"><div class="bg-white border rounded p-3 h-100"><div class="employee-details-title">Allowances</div><div class="employee-details-value">+@Model.TotalAllowances.ToString("N2")</div></div></div>
            <div class="col-md-4 col-sm-6"><div class="bg-white border rounded p-3 h-100"><div class="employee-details-title">Deductions</div><div class="employee-details-value">-@Model.TotalDeductions.ToString("N2")</div></div></div>
            <div class="col-md-4 col-sm-6"><div class="bg-white border rounded p-3 h-100"><div class="employee-details-title">Net Payable</div><div class="employee-details-value">@Model.NetPayable.ToString("N2")</div></div></div>
            <div class="col-md-4 col-sm-6"><div class="bg-white border rounded p-3 h-100"><div class="employee-details-title">Paid (@monthName)</div><div class="employee-details-value">@Model.PaidAmount.ToString("N2")</div></div></div>
            <div class="col-md-4 col-sm-6"><div class="bg-white border rounded p-3 h-100"><div class="employee-details-title">Remaining / Balance</div><div class="employee-details-value">@Model.RemainingAmount.ToString("N2")</div></div></div>
        </div>
    </div>

    <div class="product-tab-panel" id="emp-panel-allowances" data-panel="allowances" role="tabpanel" hidden>
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="bg-white border rounded p-3 h-100">
                    <h2 class="h5 mb-3">Allowances</h2>
                    <table class="table table-sm align-middle mb-3">
                        <thead><tr><th>Title</th><th class="text-end">Amount</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var a in Model.Allowances.Where(x => x.IsActive))
                        {
                            <tr>
                                <td>@a.Title</td>
                                <td class="text-end">@a.Amount.ToString("N2")</td>
                                <td class="text-end">
                                    <form asp-action="RemoveAllowance" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Uid" />
                                        <input type="hidden" name="employeeUid" value="@e.Uid" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this allowance?');">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Allowances.Any(x => x.IsActive))
                        {
                            <tr><td colspan="3" class="text-muted text-center">No allowances.</td></tr>
                        }
                        </tbody>
                    </table>
                    <form asp-action="AddAllowance" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="employeeUid" value="@e.Uid" />
                        <div class="col-md-6">
                            <label class="form-label mb-1">Title</label>
                            <input name="title" class="form-control form-control-sm" required maxlength="150" placeholder="e.g. Transport" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label mb-1">Amount</label>
                            <input name="amount" type="number" step="0.01" min="0.01" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-primary w-100">Add</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="bg-white border rounded p-3 h-100">
                    <h2 class="h5 mb-3">Deductions (month-wise)</h2>
                    <p class="text-muted small mb-2">
                        Salary for <strong>@monthName @Model.PeriodYear</strong> deducts matching month rows plus any <strong>All Months</strong> rows.
                    </p>
                    <table class="table table-sm align-middle mb-3">
                        <thead><tr><th>Month / Year</th><th>Title</th><th class="text-end">Amount</th><th></th></tr></thead>
                        <tbody>
                        @{
                            var visibleDeductions = Model.Deductions.Where(x => x.IsActive).ToList();
                        }
                        @foreach (var d in visibleDeductions)
                        {
                            var periodLabel = d.PeriodMonth is >= 1 and <= 12 && d.PeriodYear is > 0
                                ? $"{System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(d.PeriodMonth.Value)} {d.PeriodYear}"
                                : "All Months";
                            var appliesNow = d.PeriodMonth == null
                                || (d.PeriodMonth == Model.PeriodMonth && d.PeriodYear == Model.PeriodYear);
                            <tr class="@(appliesNow ? "" : "table-light")">
                                <td>@periodLabel</td>
                                <td>@d.Title</td>
                                <td class="text-end">@d.Amount.ToString("N2")</td>
                                <td class="text-end">
                                    <form asp-action="RemoveDeduction" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.Uid" />
                                        <input type="hidden" name="employeeUid" value="@e.Uid" />
                                        <input type="hidden" name="month" value="@Model.PeriodMonth" />
                                        <input type="hidden" name="year" value="@Model.PeriodYear" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this deduction?');">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (visibleDeductions.Count == 0)
                        {
                            <tr><td colspan="4" class="text-muted text-center">No deductions.</td></tr>
                        }
                        </tbody>
                    </table>
                    <form asp-action="AddDeduction" method="post" class="row g-2 align-items-end" id="addDeductionForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="employeeUid" value="@e.Uid" />
                        <input type="hidden" name="returnMonth" value="@Model.PeriodMonth" />
                        <input type="hidden" name="returnYear" value="@Model.PeriodYear" />
                        <div class="col-md-3">
                            <label class="form-label mb-1" for="deductionPeriodMonth">Month</label>
                            <select name="periodMonth" id="deductionPeriodMonth" class="form-select form-select-sm" required>
                                <option value="0">All Months</option>
                                @for (var m = 1; m <= 12; m++)
                                {
                                    var name = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m);
                                    if (m == Model.PeriodMonth)
                                    {
                                        <option value="@m" selected>@name</option>
                                    }
                                    else
                                    {
                                        <option value="@m">@name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2" id="deductionYearWrap">
                            <label class="form-label mb-1" for="deductionPeriodYear">Year</label>
                            <select name="periodYear" id="deductionPeriodYear" class="form-select form-select-sm">
                                @for (var y = Model.PeriodYear - 1; y <= Model.PeriodYear + 1; y++)
                                {
                                    if (y == Model.PeriodYear)
                                    {
                                        <option value="@y" selected>@y</option>
                                    }
                                    else
                                    {
                                        <option value="@y">@y</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1">Title</label>
                            <input name="title" class="form-control form-control-sm" required maxlength="150" placeholder="e.g. Leaves / Loan" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label mb-1">Amount</label>
                            <input name="amount" type="number" step="0.01" min="0.01" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-primary w-100">Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="product-tab-panel" id="emp-panel-payments" data-panel="payments" role="tabpanel" hidden>
        <div class="bg-white border rounded p-3">
            <h2 class="h5 mb-3">Payments — @monthName @Model.PeriodYear</h2>
            <form asp-action="AddPayment" method="post" class="row g-2 align-items-end mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="employeeUid" value="@e.Uid" />
                <input type="hidden" name="periodMonth" value="@Model.PeriodMonth" />
                <input type="hidden" name="periodYear" value="@Model.PeriodYear" />
                <div class="col-md-3">
                    <label class="form-label mb-1">Payment date</label>
                    <input name="paymentDate" type="date" class="form-control form-control-sm" value="@Model.NewPaymentDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1">Amount</label>
                    <input name="amount" type="number" step="0.01" min="0.01" class="form-control form-control-sm" required placeholder="@Model.RemainingAmount.ToString("0.00")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label mb-1">Remarks</label>
                    <input name="remarks" class="form-control form-control-sm" maxlength="500" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-success btn-sm">Record Payment</button>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Payment No</th>
                            <th>Date</th>
                            <th class="text-end">Amount</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr>
                            <td>@p.PaymentNo</td>
                            <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@p.Amount.ToString("N2")</td>
                            <td>@(p.Remarks ?? "—")</td>
                        </tr>
                    }
                    @if (Model.Payments.Count == 0)
                    {
                        <tr><td colspan="4" class="text-muted text-center py-3">No payments for this period.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>

<script>
(function () {
    var root = document.getElementById('employeeDetailsTabs');
    if (!root) return;
    var buttons = root.querySelectorAll('.product-tab-btn');
    var panels = root.querySelectorAll('.product-tab-panel');
    var storageKey = 'employeeDetailsTab:' + '@e.Uid';

    function activate(tabName) {
        buttons.forEach(function (btn) {
            var on = btn.getAttribute('data-tab') === tabName;
            btn.classList.toggle('active', on);
            btn.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
            var on = panel.getAttribute('data-panel') === tabName;
            panel.classList.toggle('active', on);
            if (on) {
                panel.removeAttribute('hidden');
            } else {
                panel.setAttribute('hidden', 'hidden');
            }
        });
        try { sessionStorage.setItem(storageKey, tabName); } catch (e) { }
    }

    buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            activate(btn.getAttribute('data-tab'));
        });
    });

    var saved = null;
    try { saved = sessionStorage.getItem(storageKey); } catch (e) { }
    if (saved && root.querySelector('[data-panel="' + saved + '"]')) {
        activate(saved);
    }

    var monthSelect = document.getElementById('deductionPeriodMonth');
    var yearWrap = document.getElementById('deductionYearWrap');
    var yearSelect = document.getElementById('deductionPeriodYear');
    function syncDeductionYear() {
        if (!monthSelect || !yearWrap || !yearSelect) return;
        var allMonths = monthSelect.value === '0';
        yearWrap.style.display = allMonths ? 'none' : '';
        yearSelect.disabled = allMonths;
        if (allMonths) {
            yearSelect.removeAttribute('name');
        } else {
            yearSelect.setAttribute('name', 'periodYear');
        }
    }
    if (monthSelect) {
        monthSelect.addEventListener('change', syncDeductionYear);
        syncDeductionYear();
    }
})();
</script>
