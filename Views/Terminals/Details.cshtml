@model Terminal
@{
    ViewData["Title"] = "Terminal Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<h1 class="page-heading invoice-details-heading mb-3">Terminal Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Terminal Code</div>
            <div class="invoice-meta-field">@Model.TerminalCode</div>
            <div class="invoice-meta-title">Terminal Name</div>
            <div class="invoice-meta-field">@Model.TerminalName</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Computer</div>
            <div class="invoice-meta-field">@Text(Model.ComputerName)</div>
            <div class="invoice-meta-title">IP Address</div>
            <div class="invoice-meta-field">@Text(Model.Ipaddress)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Active</div>
            <div class="invoice-meta-field">@(Model.IsActive ? "Yes" : "No")</div>
            <div class="invoice-meta-title"></div>
            <div class="invoice-meta-field"></div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
