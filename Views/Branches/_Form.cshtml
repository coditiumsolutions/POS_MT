@model BranchFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="invoice-meta-grid invoice-meta-form">
    <div class="invoice-meta-row">
        <label asp-for="BranchCode" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="BranchCode" class="form-control form-control-sm invoice-meta-input" />
            <span asp-validation-for="BranchCode" class="text-danger"></span>
        </div>
        <label asp-for="BranchName" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="BranchName" class="form-control form-control-sm invoice-meta-input" />
            <span asp-validation-for="BranchName" class="text-danger"></span>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="Address" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="Address" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="City" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="City" class="form-control form-control-sm invoice-meta-input" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="ContactPerson" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="ContactPerson" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="MobileNo" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="MobileNo" class="form-control form-control-sm invoice-meta-input" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="PhoneNo" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="PhoneNo" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="Email" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="Email" class="form-control form-control-sm invoice-meta-input" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="IsActive" class="invoice-meta-title"></label>
        <div class="invoice-meta-field d-flex align-items-center">
            <input asp-for="IsActive" class="form-check-input m-0" />
        </div>
        <div class="invoice-meta-title"></div>
        <div class="invoice-meta-field"></div>
    </div>
</div>
