@model Inventory
@{ ViewData["Title"] = "Inventory Details"; }
<h1 class="page-heading invoice-details-heading mb-3">Inventory Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Product UID</div>
            <div class="invoice-meta-field">@Model.ProductUid</div>
            <div class="invoice-meta-title">Warehouse UID</div>
            <div class="invoice-meta-field">@Model.WarehouseUid</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Qty In</div>
            <div class="invoice-meta-field">@Model.QuantityIn.ToString("N1")</div>
            <div class="invoice-meta-title">Qty Out</div>
            <div class="invoice-meta-field">@Model.QuantityOut.ToString("N1")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Current Qty</div>
            <div class="invoice-meta-field">@Model.CurrentQuantity.ToString("N1")</div>
            <div class="invoice-meta-title">Average Cost</div>
            <div class="invoice-meta-field">@Model.AverageCost.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Last Purchase</div>
            <div class="invoice-meta-field">@Model.LastPurchasePrice.ToString("N2")</div>
            <div class="invoice-meta-title">Last Sale</div>
            <div class="invoice-meta-field">@Model.LastSalePrice.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Min Stock</div>
            <div class="invoice-meta-field">@Model.MinimumStock.ToString("N1")</div>
            <div class="invoice-meta-title">Max Stock</div>
            <div class="invoice-meta-field">@Model.MaximumStock.ToString("N1")</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
