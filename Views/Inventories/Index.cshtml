@model IEnumerable<InventoryListItemViewModel>
@{ ViewData["Title"] = "Inventories"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-heading mb-1">Inventories</h1><p class="text-muted mb-0">Manage inventory balances.</p></div><a class="btn btn-primary" asp-action="Create">Add Inventory</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-hover w-100 inventory-grid">
        <thead>
            <tr>
                <th>Product</th>
                <th>Warehouse</th>
                <th>Current Qty</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.WarehouseName</td>
                <td>@item.CurrentQuantity.ToString("N3")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
