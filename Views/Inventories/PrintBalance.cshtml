@model InventoryBalancePrintViewModel
@{
    Layout = null;
    ViewData["Title"] = "Inventory Balance";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --ink: #0f172a;
            --muted: #64748b;
            --line: #cbd5e1;
        }

        * { box-sizing: border-box; }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            margin: 0;
            background: #e2e8f0;
        }

        .toolbar {
            width: 210mm;
            margin: 12px auto 0;
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
        }

        .toolbar button {
            border: 1px solid #94a3b8;
            background: #0f172a;
            color: #fff;
            border-radius: 4px;
            padding: 0.4rem 0.9rem;
            font-size: 0.875rem;
            cursor: pointer;
        }

        .toolbar button.secondary {
            background: #fff;
            color: #0f172a;
        }

        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 12px auto;
            padding: 10mm 12mm 12mm;
            background: #fff;
            box-shadow: 0 1px 8px rgba(15, 23, 42, 0.12);
        }

        h1 {
            margin: 0;
            font-size: 1.25rem;
        }

        .sub {
            margin-top: 0.15rem;
            color: var(--muted);
            font-size: 0.8rem;
        }

        .header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            border-bottom: 2px solid var(--ink);
            padding-bottom: 0.5rem;
            margin-bottom: 0.65rem;
        }

        .meta {
            text-align: right;
            font-size: 0.8rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.78rem;
        }

        th, td {
            border: 1px solid var(--line);
            padding: 0.2rem 0.4rem;
            vertical-align: middle;
            text-align: left;
            line-height: 1.25;
        }

        th {
            background: #f8fafc;
            font-size: 0.68rem;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        td.qty {
            text-align: right;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        td.qty.neg { color: #b91c1c; font-weight: 600; }

        .empty {
            padding: 1rem 0;
            color: var(--muted);
        }

        .footer {
            margin-top: 0.75rem;
            color: var(--muted);
            font-size: 0.72rem;
            display: flex;
            justify-content: space-between;
        }

        @@page { size: A4 portrait; margin: 8mm; }

        @@media print {
            body { background: #fff; }
            .toolbar { display: none !important; }
            .sheet {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
            tr { break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" class="secondary" onclick="window.close()">Close</button>
        <button type="button" onclick="window.print()">Print</button>
    </div>
    <div class="sheet">
        <div class="header">
            <div>
                <h1>Inventory Balance</h1>
                <div class="sub">Product · Branch · Current Quantity</div>
            </div>
            <div class="meta">
                <div>Printed @Model.PrintedAt.ToString("dd-MMM-yyyy HH:mm")</div>
                <div>@Model.Rows.Count line(s)</div>
            </div>
        </div>

        @if (Model.Rows.Count == 0)
        {
            <p class="empty">No inventory rows found.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th style="width: 48%;">Product Name</th>
                        <th style="width: 32%;">Branch</th>
                        <th style="width: 20%;" class="qty">Current Quantity</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.ProductName</td>
                        <td>@row.BranchName</td>
                        <td class="qty @(row.CurrentQuantity < 0 ? "neg" : null)">@row.CurrentQuantity.ToString("N3")</td>
                    </tr>
                }
                </tbody>
            </table>
            <div class="footer">
                <span>End of report</span>
                <span>Total lines: @Model.Rows.Count</span>
            </div>
        }
    </div>
    <script>
        window.addEventListener('load', function () {
            // Ready for print; user clicks Print or can use Ctrl+P.
        });
    </script>
</body>
</html>
