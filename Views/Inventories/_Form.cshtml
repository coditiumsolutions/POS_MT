@model InventoryFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="invoice-meta-grid invoice-meta-form">
    <div class="invoice-meta-row">
        <label asp-for="ProductUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="ProductUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Products"></select>
            <span asp-validation-for="ProductUid" class="text-danger"></span>
        </div>
        <label asp-for="WarehouseUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="WarehouseUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Warehouses"></select>
            <span asp-validation-for="WarehouseUid" class="text-danger"></span>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="QuantityIn" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="QuantityIn" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="QuantityOut" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="QuantityOut" class="form-control form-control-sm invoice-meta-input" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="CurrentQuantity" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="CurrentQuantity" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="AverageCost" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="AverageCost" class="form-control form-control-sm invoice-meta-input" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="LastPurchasePrice" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="LastPurchasePrice" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="LastSalePrice" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="LastSalePrice" class="form-control form-control-sm invoice-meta-input" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="MinimumStock" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="MinimumStock" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="MaximumStock" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="MaximumStock" class="form-control form-control-sm invoice-meta-input" />
        </div>
    </div>
</div>
