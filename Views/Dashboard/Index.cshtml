@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Bar Graphs";
    var monthLabelsJson = JsonSerializer.Serialize(Model.MonthLabels);
    var amountsJson = JsonSerializer.Serialize(Model.MonthlySalesAmounts);
    var itemLabelsJson = JsonSerializer.Serialize(Model.ItemNameLabels);
    var itemQtyJson = JsonSerializer.Serialize(Model.ItemQuantities);
    var cashWalkInJson = JsonSerializer.Serialize(Model.MonthlyCashWalkInAmounts);
    var creditJson = JsonSerializer.Serialize(Model.MonthlyCreditAmounts);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-heading mb-1">Bar Graphs</h1>
        <p class="text-muted mb-0">Sales charts for @Model.ChartYear.</p>
    </div>
</div>

@if (!Model.DatabaseConnected)
{
    <div class="alert alert-warning" role="alert">@Model.StatusMessage</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="dashboard-chart-card">
            <div class="dashboard-chart-card__header">
                <h2 class="dashboard-chart-card__title">Monthly Sales — Amount</h2>
                <p class="dashboard-chart-card__subtitle mb-0">Total net sales amount by month (@Model.ChartYear)</p>
            </div>
            <div class="dashboard-chart-card__body">
                <canvas id="salesAmountChart" aria-label="Monthly sales amount bar chart" role="img"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="dashboard-chart-card">
            <div class="dashboard-chart-card__header dashboard-chart-card__header--with-filter">
                <div>
                    <h2 class="dashboard-chart-card__title">Sales by Item Name</h2>
                    <p class="dashboard-chart-card__subtitle mb-0">
                        Top items by quantity sold — @Model.SelectedItemMonthName @Model.ChartYear
                    </p>
                </div>
                <form method="get" asp-action="Index" class="dashboard-item-month-filter">
                    <label class="form-label mb-1 small text-muted" for="itemMonth">Month</label>
                    <select id="itemMonth"
                            name="itemMonth"
                            class="form-select form-select-sm"
                            asp-items="Model.ItemMonthOptions"
                            onchange="this.form.submit()"></select>
                </form>
            </div>
            <div class="dashboard-chart-card__body dashboard-chart-card__body--tall">
                <canvas id="salesItemsChart" aria-label="Sales by item name bar chart" role="img"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="dashboard-chart-card">
            <div class="dashboard-chart-card__header">
                <h2 class="dashboard-chart-card__title">Cash / Walk-in vs Monthly Customers</h2>
                <p class="dashboard-chart-card__subtitle mb-0">Month-wise net sales for Cash / Walk-in and Monthly customers (@Model.ChartYear)</p>
            </div>
            <div class="dashboard-chart-card__body">
                <canvas id="cashWalkInChart" aria-label="Cash walk-in versus monthly customers chart" role="img"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const monthLabels = @Html.Raw(monthLabelsJson);
            const amounts = @Html.Raw(amountsJson);
            const itemLabels = @Html.Raw(itemLabelsJson);
            const itemQty = @Html.Raw(itemQtyJson);
            const cashWalkIn = @Html.Raw(cashWalkInJson);
            const credit = @Html.Raw(creditJson);

            function baseOptions(showLegend) {
                return {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: !!showLegend, position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    const value = ctx.parsed.y ?? ctx.parsed.x ?? 0;
                                    return ctx.dataset.label + ': ' + Number(value).toLocaleString(undefined, {
                                        minimumFractionDigits: 0,
                                        maximumFractionDigits: 2
                                    });
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b' }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(148, 163, 184, 0.25)' },
                            ticks: { color: '#64748b' }
                        }
                    }
                };
            }

            const amountCtx = document.getElementById('salesAmountChart');
            if (amountCtx) {
                new Chart(amountCtx, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [{
                            label: 'Amount',
                            data: amounts,
                            backgroundColor: 'rgba(202, 162, 39, 0.85)',
                            hoverBackgroundColor: 'rgba(184, 134, 11, 0.95)',
                            borderRadius: 6,
                            maxBarThickness: 42
                        }]
                    },
                    options: baseOptions(false)
                });
            }

            const itemsCtx = document.getElementById('salesItemsChart');
            if (itemsCtx) {
                const itemOptions = baseOptions(false);
                itemOptions.indexAxis = 'y';
                itemOptions.scales.x.beginAtZero = true;
                itemOptions.scales.y.grid = { display: false };
                itemOptions.scales.x.grid = { color: 'rgba(148, 163, 184, 0.25)' };

                new Chart(itemsCtx, {
                    type: 'bar',
                    data: {
                        labels: itemLabels.length ? itemLabels : ['No items'],
                        datasets: [{
                            label: 'Qty',
                            data: itemLabels.length ? itemQty : [0],
                            backgroundColor: 'rgba(37, 99, 235, 0.75)',
                            hoverBackgroundColor: 'rgba(29, 78, 216, 0.9)',
                            borderRadius: 6,
                            maxBarThickness: 28
                        }]
                    },
                    options: itemOptions
                });
            }

            const cashCtx = document.getElementById('cashWalkInChart');
            if (cashCtx) {
                new Chart(cashCtx, {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            {
                                label: 'Cash / Walk-in',
                                data: cashWalkIn,
                                backgroundColor: 'rgba(234, 88, 12, 0.8)',
                                hoverBackgroundColor: 'rgba(194, 65, 12, 0.95)',
                                borderRadius: 6,
                                maxBarThickness: 28
                            },
                            {
                                label: 'Monthly',
                                data: credit,
                                backgroundColor: 'rgba(8, 145, 178, 0.8)',
                                hoverBackgroundColor: 'rgba(14, 116, 144, 0.95)',
                                borderRadius: 6,
                                maxBarThickness: 28
                            }
                        ]
                    },
                    options: baseOptions(true)
                });
            }
        })();
    </script>
}
