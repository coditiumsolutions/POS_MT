@model ModuleCardsViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var cardLayout = string.Equals(Model.PosItemLayout, "Card", StringComparison.OrdinalIgnoreCase);
}

<div class="setup-page">
    <aside class="setup-pos-panel">
        <h2 class="setup-pos-title">POS screen</h2>
        <p class="setup-pos-note">This controls the Cash page. Grid keeps the product table. Cards uses category buttons and item cards.</p>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 px-3 small">@TempData["Success"]</div>
        }
        <form asp-action="SavePosLayout" method="post" class="setup-pos-form">
            @Html.AntiForgeryToken()
            <label class="setup-pos-choice @(cardLayout ? "" : "active")">
                <input type="radio" name="layout" value="Grid" @(cardLayout ? null : "checked") />
                <span>Grid</span>
                <small>Current product table</small>
            </label>
            <label class="setup-pos-choice @(cardLayout ? "active" : "")">
                <input type="radio" name="layout" value="Card" @(cardLayout ? "checked" : null) />
                <span>Cards</span>
                <small>Category buttons and item cards</small>
            </label>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
        </form>

        <div class="mt-4 pt-3 border-top">
            <h2 class="setup-pos-title">Offline sync</h2>
            <p class="setup-pos-note">Choose which tables offline pull copies from online SQL.</p>
            <a class="btn btn-outline-primary btn-sm w-100"
               asp-controller="OfflineSyncTables"
               asp-action="Index">
                <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>
                Sync Tables
            </a>
        </div>
    </aside>

    <div class="setup-page-main">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <div>
                <h1 class="page-heading mb-1">@Model.PageTitle</h1>
                <p class="text-muted mb-0">@Model.PageSubtitle</p>
            </div>
            <div class="module-search-wrap">
                <input type="search"
                       id="moduleSearch"
                       class="form-control form-control-sm"
                       placeholder="Search modules..."
                       autocomplete="off"
                       aria-label="Search modules" />
            </div>
        </div>

        <div class="module-grid" id="moduleGrid">
            @foreach (var module in Model.Modules)
            {
                if (!string.IsNullOrWhiteSpace(module.Controller))
                {
                    <a class="module-card"
                       asp-controller="@module.Controller"
                       asp-action="@module.Action"
                       title="@module.Name"
                       data-module-name="@module.Name">
                        <span class="module-card-icon">
                            <i class="bi @module.IconClass" aria-hidden="true"></i>
                        </span>
                        <span class="module-card-name">@module.Name</span>
                    </a>
                }
                else
                {
                    <a class="module-card module-card-disabled"
                       href="#"
                       title="@module.Name — no matching table"
                       data-module-name="@module.Name">
                        <span class="module-card-icon">
                            <i class="bi @module.IconClass" aria-hidden="true"></i>
                        </span>
                        <span class="module-card-name">@module.Name</span>
                    </a>
                }
            }
        </div>
        <p id="moduleSearchEmpty" class="text-muted d-none mt-3 mb-0">No modules match your search.</p>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const input = document.getElementById('moduleSearch');
    const grid = document.getElementById('moduleGrid');
    const empty = document.getElementById('moduleSearchEmpty');
    if (!input || !grid) return;

    input.addEventListener('input', function () {
        const q = input.value.trim().toLowerCase();
        let visible = 0;
        grid.querySelectorAll('.module-card').forEach(function (card) {
            const name = (card.getAttribute('data-module-name') || '').toLowerCase();
            const show = !q || name.indexOf(q) !== -1;
            card.style.display = show ? '' : 'none';
            if (show) visible += 1;
        });
        if (empty) empty.classList.toggle('d-none', visible > 0);
    });

    document.querySelectorAll('.setup-pos-choice input').forEach(function (inputEl) {
        inputEl.addEventListener('change', function () {
            document.querySelectorAll('.setup-pos-choice').forEach(function (label) {
                label.classList.toggle('active', label.querySelector('input')?.checked === true);
            });
        });
    });
})();
</script>
}
