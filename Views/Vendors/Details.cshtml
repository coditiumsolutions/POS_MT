@model Vendor
@{ ViewData["Title"] = "Vendor Details"; }
<h1 class="page-heading mb-3">Vendor Details</h1>
<div class="bg-white border rounded p-3"><dl class="row mb-0">
<dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.VendorCode</dd>
<dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.VendorName</dd>
<dt class="col-sm-3">Mobile</dt><dd class="col-sm-9">@Model.MobileNo</dd>
<dt class="col-sm-3">City</dt><dd class="col-sm-9">@Model.City</dd>
<dt class="col-sm-3">Active</dt><dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
</dl><div class="mt-3"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a> <a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
