@model Vendor
@{
    ViewData["Title"] = "Vendor Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<h1 class="page-heading invoice-details-heading mb-3">Vendor Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Vendor Code</div>
            <div class="invoice-meta-field">@Model.VendorCode</div>
            <div class="invoice-meta-title">Vendor Name</div>
            <div class="invoice-meta-field">@Model.VendorName</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Contact Person</div>
            <div class="invoice-meta-field">@Text(Model.ContactPerson)</div>
            <div class="invoice-meta-title">Mobile No</div>
            <div class="invoice-meta-field">@Text(Model.MobileNo)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Phone No</div>
            <div class="invoice-meta-field">@Text(Model.PhoneNo)</div>
            <div class="invoice-meta-title">Email</div>
            <div class="invoice-meta-field">@Text(Model.Email)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Address</div>
            <div class="invoice-meta-field">@Text(Model.Address)</div>
            <div class="invoice-meta-title">City</div>
            <div class="invoice-meta-field">@Text(Model.City)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">NTN</div>
            <div class="invoice-meta-field">@Text(Model.Ntn)</div>
            <div class="invoice-meta-title">STRN</div>
            <div class="invoice-meta-field">@Text(Model.Strn)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Opening Balance</div>
            <div class="invoice-meta-field">@Model.OpeningBalance.ToString("N2")</div>
            <div class="invoice-meta-title">Credit Limit</div>
            <div class="invoice-meta-field">@Model.CreditLimit.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Payment Terms</div>
            <div class="invoice-meta-field">@Text(Model.PaymentTerms)</div>
            <div class="invoice-meta-title">Active</div>
            <div class="invoice-meta-field">@(Model.IsActive ? "Yes" : "No")</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
