@model VendorPayViewModel
@{
    ViewData["Title"] = "Pay Vendor";
}
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="page-heading mb-1">Pay Vendor</h1>
        <p class="text-muted mb-0">@Model.VendorCode — @Model.VendorName</p>
    </div>
    <div class="text-muted small align-self-center">
        Outstanding <strong>@Model.TotalOutstanding.ToString("N2")</strong>
        · Paid (all time) <strong>@Model.TotalPaid.ToString("N2")</strong>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="bg-white border rounded p-3 mb-3">
    <h2 class="invoice-meta-section-title">Payment</h2>
    <form asp-action="Pay" method="post" class="mt-2">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="VendorUid" />
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label asp-for="PurchaseInvoiceUid" class="form-label small text-muted mb-1"></label>
                <select asp-for="PurchaseInvoiceUid"
                        class="form-select form-select-sm"
                        style="width:auto; min-width:14rem;"
                        asp-items="Model.InvoiceOptions"
                        id="vendorPayInvoice">
                    <option value="">-- Select unpaid invoice --</option>
                </select>
            </div>
            <div>
                <label asp-for="Amount" class="form-label small text-muted mb-1"></label>
                <input asp-for="Amount" class="form-control form-control-sm" style="width:8.5rem" step="0.01" min="0.01" id="vendorPayAmount" />
            </div>
            <div>
                <label asp-for="PaymentMethodUid" class="form-label small text-muted mb-1"></label>
                <select asp-for="PaymentMethodUid"
                        class="form-select form-select-sm"
                        style="width:auto; min-width:10rem;"
                        asp-items="Model.PaymentMethodOptions">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div>
                <label asp-for="PaymentDate" class="form-label small text-muted mb-1"></label>
                <input asp-for="PaymentDate" class="form-control form-control-sm" type="datetime-local" />
            </div>
            <div>
                <label asp-for="ReferenceNo" class="form-label small text-muted mb-1"></label>
                <input asp-for="ReferenceNo" class="form-control form-control-sm" style="width:10rem" placeholder="Optional" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary" style="background-color:#4f46e5;border-color:#4338ca;">
                Pay Vendor
            </button>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Back</a>
        </div>
        <div class="mt-2" style="max-width:28rem;">
            <label asp-for="Remarks" class="form-label small text-muted mb-1"></label>
            <textarea asp-for="Remarks" class="form-control form-control-sm" rows="2" placeholder="Optional notes"></textarea>
        </div>
    </form>
</div>

<div class="bg-white border rounded p-3 mb-3">
    <h2 class="invoice-meta-section-title">Unpaid / partial purchase invoices</h2>
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0" id="vendorOpenInvoicesTable">
            <thead>
                <tr>
                    <th>Invoice No</th>
                    <th>Date</th>
                    <th class="text-end">Net</th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var inv in Model.OpenInvoices)
            {
                <tr data-invoice-uid="@inv.Uid" data-balance="@inv.BalanceAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <td>@inv.PurchaseInvoiceNo</td>
                    <td>@inv.PurchaseDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@inv.NetAmount.ToString("N2")</td>
                    <td class="text-end">@inv.PaidAmount.ToString("N2")</td>
                    <td class="text-end">@inv.BalanceAmount.ToString("N2")</td>
                    <td>@inv.PaymentStatus</td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary vendor-pick-invoice"
                                data-uid="@inv.Uid"
                                data-balance="@inv.BalanceAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            Use
                        </button>
                    </td>
                </tr>
            }
            @if (Model.OpenInvoices.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-muted text-center py-3">
                        No purchase invoices for this vendor yet. Create one under Purchases, then return here to pay.
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="bg-white border rounded p-3">
    <h2 class="invoice-meta-section-title">Payment history</h2>
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle mb-0">
            <thead>
                <tr>
                    <th>Payment No</th>
                    <th>Date</th>
                    <th>Invoice</th>
                    <th class="text-end">Amount</th>
                    <th>Reference</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td>@p.PaymentNo</td>
                    <td>@p.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@p.PurchaseInvoiceNo</td>
                    <td class="text-end">@p.Amount.ToString("N2")</td>
                    <td>@(string.IsNullOrWhiteSpace(p.ReferenceNo) ? "—" : p.ReferenceNo)</td>
                </tr>
            }
            @if (Model.Payments.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted text-center py-3">No payments recorded for this vendor yet.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var invoiceSelect = document.getElementById('vendorPayInvoice');
            var amountInput = document.getElementById('vendorPayAmount');
            document.querySelectorAll('.vendor-pick-invoice').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var uid = btn.getAttribute('data-uid');
                    var balance = btn.getAttribute('data-balance');
                    if (invoiceSelect && uid) invoiceSelect.value = uid;
                    if (amountInput && balance) amountInput.value = Number(balance).toFixed(2);
                });
            });
            var balances = {
                @foreach (var inv in Model.OpenInvoices)
                {
                    <text>@inv.Uid: @inv.BalanceAmount.ToString(System.Globalization.CultureInfo.InvariantCulture),</text>
                }
            };
            if (invoiceSelect && amountInput) {
                invoiceSelect.addEventListener('change', function () {
                    var bal = balances[invoiceSelect.value];
                    if (bal != null) amountInput.value = Number(bal).toFixed(2);
                });
            }
        })();
    </script>
}
