@model IEnumerable<Vendor>
@{ ViewData["Title"] = "Vendors"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-heading mb-1">Vendors</h1>
        <p class="text-muted mb-0">Manage vendor master records.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Vendor</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="d-flex flex-wrap gap-2 align-items-center mb-2">
    <button type="button" id="btnPayVendor" class="btn btn-sm btn-primary"
            style="background-color:#4f46e5;border-color:#4338ca;" disabled>Pay Vendor</button>
    <button type="button" id="btnEditVendor" class="btn btn-sm btn-outline-primary" disabled>Edit</button>
    <button type="button" id="btnViewVendor" class="btn btn-sm btn-outline-secondary" disabled>View</button>
    <button type="button" id="btnDeleteVendor" class="btn btn-sm btn-outline-danger" disabled>Delete</button>
</div>

<form id="deleteVendorForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-hover w-100 inventory-grid">
        <thead>
            <tr>
                <th style="width:42px" class="text-center">
                    <span class="visually-hidden">Select</span>
                </th>
                <th>Code</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>City</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="vendor-row" data-uid="@item.Uid">
                <td class="text-center">
                    <input type="radio"
                           class="form-check-input vendor-select"
                           name="selectedVendor"
                           value="@item.Uid"
                           aria-label="Select vendor @item.VendorCode" />
                </td>
                <td>@item.VendorCode</td>
                <td>@item.VendorName</td>
                <td>@item.MobileNo</td>
                <td>@item.City</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        (function () {
            const payUrlBase = '@Url.Action("Pay", "Vendors")';
            const editUrlBase = '@Url.Action("Edit", "Vendors")';
            const viewUrlBase = '@Url.Action("Details", "Vendors")';
            const deleteUrlBase = '@Url.Action("Delete", "Vendors")';

            const btnPay = document.getElementById('btnPayVendor');
            const btnEdit = document.getElementById('btnEditVendor');
            const btnView = document.getElementById('btnViewVendor');
            const btnDelete = document.getElementById('btnDeleteVendor');
            const deleteForm = document.getElementById('deleteVendorForm');
            const table = document.getElementById('crudTable');

            let selectedUid = null;

            function updateActions() {
                const hasSelection = selectedUid != null;
                btnPay.disabled = !hasSelection;
                btnEdit.disabled = !hasSelection;
                btnView.disabled = !hasSelection;
                btnDelete.disabled = !hasSelection;
            }

            function selectFromRadio(radio) {
                selectedUid = radio ? radio.value : null;
                updateActions();
            }

            table.addEventListener('change', function (e) {
                const radio = e.target.closest('.vendor-select');
                if (!radio) return;
                selectFromRadio(radio);
            });

            table.addEventListener('click', function (e) {
                if (e.target.closest('.vendor-select')) return;
                const row = e.target.closest('.vendor-row');
                if (!row) return;
                const radio = row.querySelector('.vendor-select');
                if (!radio) return;
                radio.checked = true;
                selectFromRadio(radio);
            });

            btnPay.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = payUrlBase + '/' + selectedUid;
            });

            btnEdit.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = editUrlBase + '/' + selectedUid;
            });

            btnView.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = viewUrlBase + '/' + selectedUid;
            });

            btnDelete.addEventListener('click', function () {
                if (!selectedUid) return;
                if (!confirm('Delete this vendor?')) return;
                deleteForm.action = deleteUrlBase + '/' + selectedUid;
                deleteForm.submit();
            });

            updateActions();
            posDataTable('#crudTable', { lengthBelow: true });
        })();
    </script>
}
