@model StockAdjustment
@{ ViewData["Title"] = "Stock Adjustment Details"; }
<h1 class="page-heading mb-3">Stock Adjustment Details</h1>
<div class="bg-white border rounded p-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Adjustment No</dt><dd class="col-sm-9">@Model.AdjustmentNo</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.AdjustmentDate</dd>
        <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.AdjustmentType</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Remarks</dt><dd class="col-sm-9">@Model.Remarks</dd>
    </dl>
    <div class="mt-3">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
