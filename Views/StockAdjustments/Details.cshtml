@model StockAdjustment
@{
    ViewData["Title"] = "Stock Adjustment Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<h1 class="page-heading invoice-details-heading mb-3">Stock Adjustment Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Adjustment No</div>
            <div class="invoice-meta-field">@Model.AdjustmentNo</div>
            <div class="invoice-meta-title">Date</div>
            <div class="invoice-meta-field">@Model.AdjustmentDate.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Type</div>
            <div class="invoice-meta-field">@Model.AdjustmentType</div>
            <div class="invoice-meta-title">Status</div>
            <div class="invoice-meta-field">@Model.Status</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Remarks</div>
            <div class="invoice-meta-field invoice-meta-field-span">@Text(Model.Remarks)</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
