@model StockAdjustmentFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="invoice-meta-grid invoice-meta-form">
    <div class="invoice-meta-row">
        <label asp-for="AdjustmentNo" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="AdjustmentNo" class="form-control form-control-sm invoice-meta-input" />
            <span asp-validation-for="AdjustmentNo" class="text-danger"></span>
        </div>
        <label asp-for="AdjustmentDate" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="AdjustmentDate" class="form-control form-control-sm invoice-meta-input" type="datetime-local" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="AdjustmentType" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="AdjustmentType" class="form-select form-select-sm invoice-meta-input">
                <option>Correction</option>
                <option>Damage</option>
                <option>Found</option>
                <option>Transfer</option>
            </select>
        </div>
        <label asp-for="Status" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="Status" class="form-select form-select-sm invoice-meta-input">
                <option>Completed</option>
                <option>Draft</option>
                <option>Cancelled</option>
            </select>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="BranchUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="BranchUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Branches">
                <option value="">-- Select --</option>
            </select>
        </div>
        <label asp-for="WarehouseUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="WarehouseUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Warehouses"></select>
            <span asp-validation-for="WarehouseUid" class="text-danger"></span>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="ProductUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="ProductUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Products">
                <option value="">-- Select product --</option>
            </select>
            <span asp-validation-for="ProductUid" class="text-danger"></span>
        </div>
        <label asp-for="Direction" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="Direction" class="form-select form-select-sm invoice-meta-input">
                <option>Increase</option>
                <option>Decrease</option>
            </select>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="Quantity" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="Quantity" class="form-control form-control-sm invoice-meta-input" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <label asp-for="Remarks" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <textarea asp-for="Remarks" class="form-control form-control-sm invoice-meta-input" rows="2"></textarea>
        </div>
    </div>
</div>
