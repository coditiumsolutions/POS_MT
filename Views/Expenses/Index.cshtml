@model IEnumerable<Expense>
@{
    ViewData["Title"] = "Expenses";
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="page-heading mb-1">Expenses</h1>
        <p class="text-muted mb-0">Manage Expenses.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-dark btn-sm"
           asp-action="Print"
           asp-route-dateFrom="@(dateFrom?.ToString("yyyy-MM-dd"))"
           asp-route-dateTo="@(dateTo?.ToString("yyyy-MM-dd"))"
           target="_blank"
           title="Open compact printable report (Print / Save as PDF)">
            <i class="bi bi-printer" aria-hidden="true"></i> Report
        </a>
        <a class="btn btn-primary btn-sm" asp-action="Create">Add New</a>
    </div>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" class="bg-white border rounded p-2 mb-3" id="expensesFilterForm">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3 col-lg-2">
            <label class="form-label mb-1" for="dateFromDisplay">Date From</label>
            <div class="expense-date-field">
                <input type="text"
                       class="form-control form-control-sm"
                       id="dateFromDisplay"
                       value="@(dateFrom?.ToString("dd MMM yyyy") ?? string.Empty)"
                       placeholder="16 Nov 2026"
                       autocomplete="off" />
                <input type="date"
                       class="expense-date-picker"
                       id="dateFromPicker"
                       value="@(dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)"
                       aria-label="Pick Date From" />
                <input type="hidden" name="dateFrom" id="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)" />
            </div>
        </div>
        <div class="col-sm-6 col-md-3 col-lg-2">
            <label class="form-label mb-1" for="dateToDisplay">Date To</label>
            <div class="expense-date-field">
                <input type="text"
                       class="form-control form-control-sm"
                       id="dateToDisplay"
                       value="@(dateTo?.ToString("dd MMM yyyy") ?? string.Empty)"
                       placeholder="16 Nov 2026"
                       autocomplete="off" />
                <input type="date"
                       class="expense-date-picker"
                       id="dateToPicker"
                       value="@(dateTo?.ToString("yyyy-MM-dd") ?? string.Empty)"
                       aria-label="Pick Date To" />
                <input type="hidden" name="dateTo" id="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<style>
    .expense-date-field {
        position: relative;
    }
    .expense-date-field .form-control {
        padding-right: 2.1rem;
    }
    .expense-date-field .expense-date-picker {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 2.1rem;
        opacity: 0;
        cursor: pointer;
        border: 0;
        background: transparent;
    }
    .expense-date-field::after {
        content: "\F214";
        font-family: "bootstrap-icons";
        position: absolute;
        right: 0.45rem;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 0.9rem;
        pointer-events: none;
    }
</style>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Expense No</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Description</th>
                <th style="width:240px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExpenseNo</td>
                <td>@item.ExpenseDate.ToString("dd MMMM yyyy")</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.Description</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
                    <form asp-action="Delete" asp-route-id="@item.Uid" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        @if (dateFrom.HasValue)
                        {
                            <input type="hidden" name="dateFrom" value="@dateFrom.Value.ToString("yyyy-MM-dd")" />
                        }
                        @if (dateTo.HasValue)
                        {
                            <input type="hidden" name="dateTo" value="@dateTo.Value.ToString("yyyy-MM-dd")" />
                        }
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete expense @item.ExpenseNo?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
<script>
    posDataTable('#crudTable');

    (function () {
        var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function formatDisplay(iso) {
            if (!iso) return '';
            var p = String(iso).split('-');
            if (p.length !== 3) return '';
            var d = Number(p[2]), m = Number(p[1]), y = Number(p[0]);
            if (!d || !m || !y) return '';
            return String(d).padStart(2, '0') + ' ' + months[m - 1] + ' ' + y;
        }

        function parseDisplay(text) {
            var t = String(text || '').trim().replace(/\s+/g, ' ');
            if (!t) return '';
            var m = t.match(/^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})$/);
            if (!m) return '';
            var mon = months.findIndex(function (x) { return x.toLowerCase() === m[2].toLowerCase(); });
            if (mon < 0) return '';
            var day = Number(m[1]), year = Number(m[3]);
            if (day < 1 || day > 31) return '';
            return year + '-' + String(mon + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
        }

        function wire(displayId, pickerId, hiddenId) {
            var display = document.getElementById(displayId);
            var picker = document.getElementById(pickerId);
            var hidden = document.getElementById(hiddenId);
            if (!display || !picker || !hidden) return;

            picker.addEventListener('change', function () {
                hidden.value = picker.value || '';
                display.value = formatDisplay(picker.value);
            });

            display.addEventListener('change', function () {
                var iso = parseDisplay(display.value);
                if (!iso && display.value.trim()) {
                    display.value = formatDisplay(hidden.value);
                    return;
                }
                hidden.value = iso;
                picker.value = iso;
                display.value = iso ? formatDisplay(iso) : '';
            });

            display.addEventListener('blur', function () {
                var iso = parseDisplay(display.value);
                if (!iso && display.value.trim()) {
                    display.value = formatDisplay(hidden.value);
                    return;
                }
                hidden.value = iso;
                picker.value = iso;
                if (iso) display.value = formatDisplay(iso);
            });
        }

        wire('dateFromDisplay', 'dateFromPicker', 'dateFrom');
        wire('dateToDisplay', 'dateToPicker', 'dateTo');
    })();
</script>
}
