@model IEnumerable<Expense>
@{
    ViewData["Title"] = "Expenses";
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-heading mb-1">Expenses</h1>
        <p class="text-muted mb-0">Manage Expenses.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add New</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" class="bg-white border rounded p-2 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3 col-lg-2">
            <label class="form-label mb-1" for="dateFrom">Date From</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="dateFrom"
                   name="dateFrom"
                   value="@(dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <div class="col-sm-6 col-md-3 col-lg-2">
            <label class="form-label mb-1" for="dateTo">Date To</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="dateTo"
                   name="dateTo"
                   value="@(dateTo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Expense No</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Description</th>
                <th style="width:190px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExpenseNo</td>
                <td>@item.ExpenseDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.Description</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
