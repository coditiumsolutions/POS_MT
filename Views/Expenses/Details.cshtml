@model Expense
@{ ViewData["Title"] = "Expense Details"; }
<h1 class="page-heading mb-3">Expense Details</h1>
<div class="bg-white border rounded p-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Expense No</dt><dd class="col-sm-9">@Model.ExpenseNo</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.ExpenseDate</dd>
        <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("N2")</dd>
        <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Reference</dt><dd class="col-sm-9">@Model.ReferenceNo</dd>
    </dl>
    <div class="mt-3">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
