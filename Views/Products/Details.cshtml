@model Product
@{
    ViewData["Title"] = "Product Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<h1 class="page-heading invoice-details-heading mb-3">Product Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Product Code</div>
            <div class="invoice-meta-field">@Model.ProductCode</div>
            <div class="invoice-meta-title">Barcode</div>
            <div class="invoice-meta-field">@Text(Model.Barcode)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Product Name</div>
            <div class="invoice-meta-field">@Model.ProductName</div>
            <div class="invoice-meta-title">Brand</div>
            <div class="invoice-meta-field">@Text(Model.BrandName)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Purchase Price</div>
            <div class="invoice-meta-field">@Model.PurchasePrice.ToString("N2")</div>
            <div class="invoice-meta-title">Sale Price</div>
            <div class="invoice-meta-field">@Model.SalePrice.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Wholesale Price</div>
            <div class="invoice-meta-field">@Model.WholesalePrice.ToString("N2")</div>
            <div class="invoice-meta-title">Tax %</div>
            <div class="invoice-meta-field">@Model.TaxPercent.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Discount %</div>
            <div class="invoice-meta-field">@Model.DiscountPercent.ToString("N2")</div>
            <div class="invoice-meta-title">Min / Max Stock</div>
            <div class="invoice-meta-field">@Model.MinimumStock.ToString("N1") / @Model.MaximumStock.ToString("N1")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Taxable</div>
            <div class="invoice-meta-field">@(Model.IsTaxable ? "Yes" : "No")</div>
            <div class="invoice-meta-title">Active</div>
            <div class="invoice-meta-field">@(Model.IsActive ? "Yes" : "No")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Description</div>
            <div class="invoice-meta-field invoice-meta-field-span">@Text(Model.Description)</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        <form asp-action="Delete" asp-route-id="@Model.Uid" method="post" class="ms-auto">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn btn-outline-danger"
                    onclick="return confirm('Delete this product permanently?');">Delete</button>
        </form>
    </div>
</div>
