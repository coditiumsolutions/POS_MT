@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-heading mb-1">Products</h1><p class="text-muted mb-0">Manage Products.</p></div><div class="d-flex gap-2 crud-form-actions"><a class="btn btn-primary crud-form-btn" asp-controller="ProductCategories" asp-action="Index" asp-route-navArea="Products">Categories</a><a class="btn btn-primary crud-form-btn" asp-action="Create">Add New</a></div></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="table-responsive bg-white border rounded p-2"><table id="crudTable" class="table table-striped table-hover w-100"><thead><tr><th>Code</th><th>Name</th><th>Sale Price</th><th>Active</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.ProductCode</td><td>@item.ProductName</td><td>@item.SalePrice.ToString("N2")</td><td>@(item.IsActive?"Yes":"No")</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
@if (item.IsActive) { <form asp-action="Deactivate" asp-route-id="@item.Uid" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate?');">Deactivate</button></form> }
<form asp-action="Delete" asp-route-id="@item.Uid" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product and its sales, purchase, stock, and inventory records?');">Delete</button></form></td></tr> }
</tbody></table></div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
