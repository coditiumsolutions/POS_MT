@model ExpenseCategory
@{
    ViewData["Title"] = "Expense Category Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<h1 class="page-heading invoice-details-heading mb-3">Expense Category Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Category Code</div>
            <div class="invoice-meta-field">@Model.CategoryCode</div>
            <div class="invoice-meta-title">Category Name</div>
            <div class="invoice-meta-field">@Model.CategoryName</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Active</div>
            <div class="invoice-meta-field">@(Model.IsActive ? "Yes" : "No")</div>
            <div class="invoice-meta-title">Description</div>
            <div class="invoice-meta-field">@Text(Model.Description)</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
