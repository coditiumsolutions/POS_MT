@model SalesInvoiceDetailsPageViewModel
@{
    ViewData["Title"] = "Sales Invoice Details";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="page-heading invoice-details-heading mb-1">Sales Invoice Details</h1>
        <p class="text-muted mb-0">Invoice <strong>@Model.InvoiceNo</strong> — line items for this customer.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (!string.Equals(Model.InvoiceStatus, "Cancelled", StringComparison.OrdinalIgnoreCase))
        {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="bg-white border rounded p-3 mb-3">
    <div class="invoice-meta-grid">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Invoice No</div>
            <div class="invoice-meta-field">@Model.InvoiceNo</div>
            <div class="invoice-meta-title">Date</div>
            <div class="invoice-meta-field">@Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Customer</div>
            <div class="invoice-meta-field">
                @Model.CustomerName
                <span class="invoice-meta-sub">@Model.CustomerCode · @Model.CustomerType</span>
            </div>
            <div class="invoice-meta-title">Status</div>
            <div class="invoice-meta-field">@Model.InvoiceStatus · @Model.PaymentStatus</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Sub Total</div>
            <div class="invoice-meta-field">@Model.SubTotal.ToString("N2")</div>
            <div class="invoice-meta-title">Net Amount</div>
            <div class="invoice-meta-field">@Model.NetAmount.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Paid / Balance</div>
            <div class="invoice-meta-field">@Model.PaidAmount.ToString("N2") / @Model.BalanceAmount.ToString("N2")</div>
            <div class="invoice-meta-title">Remarks</div>
            <div class="invoice-meta-field">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "—" : Model.Remarks)</div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white border rounded p-2">
    <table class="table table-striped table-hover w-100 mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>Product</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Price</th>
                <th class="text-end">Discount</th>
                <th class="text-end">Tax</th>
                <th class="text-end">Line Total</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Lines.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-muted text-center py-4">No sales invoice detail records for this invoice.</td>
            </tr>
        }
        else
        {
            var i = 0;
            foreach (var line in Model.Lines)
            {
                i++;
                <tr>
                    <td>@i</td>
                    <td>
                        <div class="fw-semibold">@line.ProductName</div>
                        <div class="small text-muted">@line.ProductCode</div>
                    </td>
                    <td class="text-end">@line.Quantity.ToString("N1")</td>
                    <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                    <td class="text-end">@line.DiscountAmount.ToString("N2")</td>
                    <td class="text-end">@line.TaxAmount.ToString("N2")</td>
                    <td class="text-end fw-semibold">@line.LineTotal.ToString("N2")</td>
                    <td>@(string.IsNullOrWhiteSpace(line.Remarks) ? "—" : line.Remarks)</td>
                </tr>
            }
        }
        </tbody>
        @if (Model.Lines.Count > 0)
        {
            <tfoot>
                <tr>
                    <td colspan="6" class="text-end fw-semibold">Lines Total</td>
                    <td class="text-end fw-semibold">@Model.Lines.Sum(x => x.LineTotal).ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
