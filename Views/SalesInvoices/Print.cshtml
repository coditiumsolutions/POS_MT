@model SalesInvoiceDetailsPageViewModel
@{
    Layout = null;
    ViewData["Title"] = $"Invoice {Model.InvoiceNo}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; color: #111; margin: 0; padding: 20px; }
        h1 { font-size: 1.35rem; margin: 0 0 0.35rem; }
        .meta { color: #444; font-size: 0.92rem; margin-bottom: 0.2rem; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 1.5rem; margin: 1rem 0 1.25rem; font-size: 0.92rem; }
        .label { color: #64748b; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.03em; }
        .value { font-weight: 600; }
        table { width: 100%; border-collapse: collapse; margin-top: 0.75rem; }
        th, td { border-bottom: 1px solid #ddd; padding: 0.45rem 0.35rem; font-size: 0.9rem; text-align: left; }
        th { background: #f8fafc; }
        .text-end { text-align: right; }
        .totals { margin-top: 1rem; max-width: 280px; margin-left: auto; font-size: 0.92rem; }
        .totals div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.15rem 0; }
        .totals .net { font-weight: 700; font-size: 1.05rem; border-top: 1px solid #cbd5e1; margin-top: 0.35rem; padding-top: 0.4rem; }
        .no-print { margin-bottom: 1rem; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()">Print</button>
        <button type="button" onclick="window.close()">Close</button>
    </div>

    <h1>Sales Invoice</h1>
    <div class="meta">Invoice: @Model.InvoiceNo</div>
    <div class="meta">Date: @Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</div>

    <div class="grid">
        <div>
            <div class="label">Customer</div>
            <div class="value">@Model.CustomerName</div>
            <div class="meta">@Model.CustomerCode · @Model.CustomerType</div>
        </div>
        <div>
            <div class="label">Status</div>
            <div class="value">@Model.InvoiceStatus · @Model.PaymentStatus</div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Product</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Price</th>
                <th class="text-end">Discount</th>
                <th class="text-end">Tax</th>
                <th class="text-end">Line Total</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Lines.Count == 0)
        {
            <tr>
                <td colspan="7">No line items.</td>
            </tr>
        }
        else
        {
            var i = 0;
            foreach (var line in Model.Lines)
            {
                i++;
                <tr>
                    <td>@i</td>
                    <td>
                        <div>@line.ProductName</div>
                        <div class="meta">@line.ProductCode</div>
                    </td>
                    <td class="text-end">@line.Quantity.ToString("N1")</td>
                    <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                    <td class="text-end">@line.DiscountAmount.ToString("N2")</td>
                    <td class="text-end">@line.TaxAmount.ToString("N2")</td>
                    <td class="text-end">@line.LineTotal.ToString("N2")</td>
                </tr>
            }
        }
        </tbody>
    </table>

    <div class="totals">
        <div><span>Sub Total</span><span>@Model.SubTotal.ToString("N2")</span></div>
        <div><span>Discount</span><span>@Model.DiscountAmount.ToString("N2")</span></div>
        <div><span>Tax</span><span>@Model.TaxAmount.ToString("N2")</span></div>
        <div><span>Other Charges</span><span>@Model.OtherCharges.ToString("N2")</span></div>
        <div class="net"><span>Net Amount</span><span>@Model.NetAmount.ToString("N2")</span></div>
        <div><span>Paid</span><span>@Model.PaidAmount.ToString("N2")</span></div>
        <div><span>Balance</span><span>@Model.BalanceAmount.ToString("N2")</span></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <p class="meta" style="margin-top:1.25rem">Remarks: @Model.Remarks</p>
    }

    <script>
        window.addEventListener('load', function () {
            window.print();
        });
    </script>
</body>
</html>
