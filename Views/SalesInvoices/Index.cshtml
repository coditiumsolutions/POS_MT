@model SalesInvoiceIndexViewModel
@{
    ViewData["Title"] = "Sales Invoices";
    var type = Model.CustomerType ?? string.Empty;
    var selectedMonth = Model.Month;
}
<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <span class="sales-invoices-heading">Sales Invoices</span>
    <a class="btn btn-primary btn-sm" asp-action="Create">Add New</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" id="salesInvoicesFilterForm" class="bg-white border rounded p-2 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label class="form-label mb-1" for="customerType">Type</label>
            <select class="form-select form-select-sm" id="customerType" name="customerType">
                @if (string.IsNullOrWhiteSpace(type))
                {
                    <option value="" selected>All</option>
                }
                else
                {
                    <option value="">All</option>
                }
                @if (string.Equals(type, "monthly", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="monthly" selected>Monthly</option>
                }
                else
                {
                    <option value="monthly">Monthly</option>
                }
                @if (string.Equals(type, "credit", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="credit" selected>Credit</option>
                }
                else
                {
                    <option value="credit">Credit</option>
                }
                @if (string.Equals(type, "walkin", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="walkin" selected>Walk-in</option>
                }
                else
                {
                    <option value="walkin">Walk-in</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-4 col-lg-3">
            <label class="form-label mb-1" for="month">Month</label>
            <select class="form-select form-select-sm" id="month" name="month">
                @if (selectedMonth is null)
                {
                    <option value="" selected>All Months</option>
                }
                else
                {
                    <option value="">All Months</option>
                }
                @for (var m = 1; m <= 12; m++)
                {
                    var name = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m);
                    if (selectedMonth == m)
                    {
                        <option value="@m" selected>@name</option>
                    }
                    else
                    {
                        <option value="@m">@name</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-4 col-lg-2">
            <label class="form-label mb-1" for="dateFrom">Date From</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="dateFrom"
                   name="dateFrom"
                   value="@(Model.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <div class="col-sm-6 col-md-4 col-lg-2">
            <label class="form-label mb-1" for="dateTo">Date To</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="dateTo"
                   name="dateTo"
                   value="@(Model.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="sales-invoice-toolbar mb-2 d-flex flex-wrap gap-2 align-items-center">
    <button type="button" id="btnEditInvoice" class="btn btn-sm btn-outline-primary" disabled>Edit</button>
    <button type="button" id="btnViewInvoice" class="btn btn-sm btn-outline-secondary" disabled>View</button>
    <button type="button" id="btnCancelInvoice" class="btn btn-sm btn-outline-warning" disabled>Cancel</button>
    <button type="button" id="btnDeleteInvoice" class="btn btn-sm btn-outline-danger" disabled>Delete</button>
    <button type="button" id="btnPrintInvoice" class="btn btn-sm btn-outline-dark" disabled>
        <i class="bi bi-printer" aria-hidden="true"></i> Print Invoice
    </button>
    <button type="button" id="btnSalesReport" class="btn btn-sm btn-outline-dark"
            title="Print all sales for the selected dates / filters">
        <i class="bi bi-printer" aria-hidden="true"></i> Sales Report
    </button>
</div>

<form id="cancelInvoiceForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>
<form id="deleteInvoiceForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="customerType" value="@Model.CustomerType" />
    <input type="hidden" name="month" value="@Model.Month" />
    <input type="hidden" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)" />
    <input type="hidden" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th style="width:42px" class="text-center">
                    <span class="visually-hidden">Select</span>
                </th>
                <th>Date</th>
                <th>Customer Name</th>
                <th>Type</th>
                <th class="text-end">Total</th>
                <th class="text-end">Payment</th>
                <th>Status</th>
                <th style="width:90px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Rows)
        {
            <tr class="sales-invoice-row"
                data-uid="@item.Uid"
                data-status="@item.InvoiceStatus">
                <td class="text-center">
                    <input type="radio"
                           class="form-check-input sales-invoice-select"
                           name="selectedInvoice"
                           value="@item.Uid"
                           data-status="@item.InvoiceStatus"
                           aria-label="Select invoice @item.InvoiceNo" />
                </td>
                <td data-order="@item.InvoiceDate.ToString("yyyy-MM-dd HH:mm:ss")">@item.InvoiceDate.ToString("dd-MMM-yyyy HH:mm")</td>
                <td>@item.CustomerName</td>
                <td>@item.CustomerType</td>
                <td class="text-end">@item.NetAmount.ToString("N2")</td>
                <td class="text-end">@item.PaidAmount.ToString("N2")</td>
                <td>@item.InvoiceStatus</td>
                <td class="text-nowrap">
                    <form asp-action="Delete" asp-route-id="@item.Uid" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerType" value="@Model.CustomerType" />
                        <input type="hidden" name="month" value="@Model.Month" />
                        <input type="hidden" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                        <input type="hidden" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete sales invoice @item.InvoiceNo?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr class="fw-semibold">
                <td></td>
                <td colspan="3" class="text-end">Sales Total</td>
                <td class="text-end">@Model.TotalNet.ToString("N2")</td>
                <td class="text-end">@Model.TotalPaid.ToString("N2")</td>
                <td></td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>
@section Scripts {
    <script>
        (function () {
            const editUrlBase = '@Url.Action("Edit", "SalesInvoices")';
            const viewUrlBase = '@Url.Action("Details", "SalesInvoices")';
            const cancelUrlBase = '@Url.Action("Cancel", "SalesInvoices")';
            const deleteUrlBase = '@Url.Action("Delete", "SalesInvoices")';
            const printUrlBase = '@Url.Action("Print", "SalesInvoices")';
            const salesReportUrl = '@Url.Action("SalesReport", "SalesInvoices")';

            const btnEdit = document.getElementById('btnEditInvoice');
            const btnView = document.getElementById('btnViewInvoice');
            const btnCancel = document.getElementById('btnCancelInvoice');
            const btnDelete = document.getElementById('btnDeleteInvoice');
            const btnPrint = document.getElementById('btnPrintInvoice');
            const btnSalesReport = document.getElementById('btnSalesReport');
            const cancelForm = document.getElementById('cancelInvoiceForm');
            const deleteForm = document.getElementById('deleteInvoiceForm');
            const table = document.getElementById('crudTable');
            const filterForm = document.getElementById('salesInvoicesFilterForm');

            let selectedUid = null;
            let selectedStatus = '';

            function updateActions() {
                const hasSelection = selectedUid != null;
                const isCancelled = (selectedStatus || '').toLowerCase() === 'cancelled';
                btnEdit.disabled = !hasSelection || isCancelled;
                btnView.disabled = !hasSelection;
                btnCancel.disabled = !hasSelection || isCancelled;
                btnDelete.disabled = !hasSelection;
                btnPrint.disabled = !hasSelection;
            }

            function selectFromRadio(radio) {
                if (!radio) {
                    selectedUid = null;
                    selectedStatus = '';
                    updateActions();
                    return;
                }
                selectedUid = radio.value;
                selectedStatus = radio.getAttribute('data-status') || '';
                updateActions();
            }

            table.addEventListener('change', function (e) {
                const radio = e.target.closest('.sales-invoice-select');
                if (!radio) return;
                selectFromRadio(radio);
            });

            table.addEventListener('click', function (e) {
                if (e.target.closest('.sales-invoice-select, form, button, a')) return;
                const row = e.target.closest('.sales-invoice-row');
                if (!row) return;
                const radio = row.querySelector('.sales-invoice-select');
                if (!radio) return;
                radio.checked = true;
                selectFromRadio(radio);
            });

            btnEdit.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = editUrlBase + '/' + selectedUid;
            });

            btnView.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = viewUrlBase + '/' + selectedUid;
            });

            btnCancel.addEventListener('click', function () {
                if (!selectedUid) return;
                if (!confirm('Cancel this record?')) return;
                cancelForm.action = cancelUrlBase + '/' + selectedUid;
                cancelForm.submit();
            });

            btnDelete.addEventListener('click', function () {
                if (!selectedUid) return;
                if (!confirm('Delete this sales invoice? If it has sales items, delete those first.')) return;
                deleteForm.action = deleteUrlBase + '/' + selectedUid;
                deleteForm.submit();
            });

            btnPrint.addEventListener('click', function () {
                if (!selectedUid) return;
                const url = printUrlBase + '/' + selectedUid;
                const w = window.open(url, '_blank', 'width=900,height=700');
                if (!w) {
                    alert('Pop-up blocked. Allow pop-ups to print the invoice.');
                }
            });

            if (btnSalesReport && filterForm) {
                btnSalesReport.addEventListener('click', function () {
                    const params = new URLSearchParams(new FormData(filterForm));
                    const url = salesReportUrl + '?' + params.toString();
                    const w = window.open(url, '_blank', 'width=980,height=720');
                    if (!w) {
                        alert('Pop-up blocked. Allow pop-ups to open the sales report.');
                    }
                });
            }

            updateActions();

            posDataTable('#crudTable', {
                lengthBelow: true,
                order: [[1, 'desc']],
                columnDefs: [{ orderable: false, targets: [0, 7] }]
            });

            const form = filterForm;
            const type = document.getElementById('customerType');
            const month = document.getElementById('month');
            if (!form || !type || !month) return;
            function submitFilter() { form.submit(); }
            type.addEventListener('change', submitFilter);
            month.addEventListener('change', submitFilter);
        })();
    </script>
}
