@model DailyReportViewModel
@{
    ViewData["Title"] = "Daily Report";
}

<div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
    <span class="sales-invoices-heading">Daily Report</span>
</div>

<form method="get" asp-action="DailyReport" class="bg-white border rounded px-2 py-2 mb-2 report-filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="Date">Date</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="Date"
                   name="Date"
                   value="@Model.Date.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="SaleType">Customer Type</label>
            <select asp-for="SaleType" asp-items="Model.SaleTypes" class="form-select form-select-sm" id="SaleType" name="saleType"></select>
        </div>
        <div class="col-md-auto col-sm-6">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3">Apply</button>
                <a class="btn btn-outline-secondary btn-sm px-3" asp-action="DailyReport" asp-route-SaleType="All">Reset</a>
            </div>
        </div>
    </div>
</form>

<div class="row g-2 mb-2">
    <div class="col-md-3 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--lines">
            <div class="small mb-0">Lines</div>
            <div class="fs-5 fw-semibold mb-0">@Model.Rows.Count</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--qty">
            <div class="small mb-0">Total Quantity</div>
            <div class="fs-5 fw-semibold mb-0">@Model.TotalQuantity.ToString("N3")</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--amount">
            <div class="small mb-0">Total Amount</div>
            <div class="fs-5 fw-semibold mb-0">@Model.TotalAmount.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--extra">
            <div class="small mb-0">Delivery Charges</div>
            <div class="fs-5 fw-semibold mb-0">@Model.TotalDeliveryCharges.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white border rounded p-2">
    <table id="dailyReportTable" class="table table-sm table-striped table-hover align-middle w-100 mb-0 report-grid-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Item</th>
                <th class="text-end">Quantity</th>
                <th class="text-end report-col-amount">Amount</th>
                <th class="text-end">Delivery Charges</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted text-center py-3">No sales found for the selected filters.</td>
            </tr>
        }
        else
        {
            foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@row.Item</td>
                    <td class="text-end">@row.Quantity.ToString("N3")</td>
                    <td class="text-end report-col-amount">@row.Amount.ToString("N2")</td>
                    <td class="text-end">@row.DeliveryCharges.ToString("N2")</td>
                </tr>
            }
        }
        </tbody>
        @if (Model.Rows.Count > 0)
        {
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="2" class="text-end">Total</td>
                    <td class="text-end">@Model.TotalQuantity.ToString("N3")</td>
                    <td class="text-end report-col-amount">@Model.TotalAmount.ToString("N2")</td>
                    <td class="text-end">@Model.TotalDeliveryCharges.ToString("N2")</td>
                </tr>
            </tfoot>
        }
    </table>
</div>

@section Scripts {
    @if (Model.Rows.Count > 0)
    {
        <script>posDataTable('#dailyReportTable', { lengthBelow: true, hideFilter: true, ordering: false });</script>
    }
}
