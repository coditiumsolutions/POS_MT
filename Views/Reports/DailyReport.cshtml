@model DailyReportViewModel
@{
    ViewData["Title"] = "Daily Report";
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <span class="sales-invoices-heading">Daily Report</span>
</div>

<form method="get" asp-action="DailyReport" class="bg-white border rounded p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="Date">Date</label>
            <input type="date"
                   class="form-control"
                   id="Date"
                   name="Date"
                   value="@Model.Date.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="SaleType">Sale Type</label>
            <select asp-for="SaleType" asp-items="Model.SaleTypes" class="form-select" id="SaleType"></select>
        </div>
        <div class="col-md-auto col-sm-6">
            <label class="form-label d-none d-md-block">&nbsp;</label>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-4 daily-report-filter-btn">Apply</button>
                <a class="btn btn-primary btn-sm px-4 daily-report-filter-btn" asp-action="DailyReport" asp-route-SaleType="All">Reset</a>
            </div>
        </div>
    </div>
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="dailyReportTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Date</th>
                <th>Item</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Amount</th>
                <th class="text-end">Delivery Charges</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted text-center py-4">No sales found for the selected filters.</td>
            </tr>
        }
        else
        {
            foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@row.Item</td>
                    <td class="text-end">@row.Quantity.ToString("N3")</td>
                    <td class="text-end">@row.Amount.ToString("N2")</td>
                    <td class="text-end">@row.DeliveryCharges.ToString("N2")</td>
                </tr>
            }
        }
        </tbody>
        @if (Model.Rows.Count > 0)
        {
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="2">Total</td>
                    <td class="text-end">@Model.TotalQuantity.ToString("N3")</td>
                    <td class="text-end">@Model.TotalAmount.ToString("N2")</td>
                    <td class="text-end">@Model.TotalDeliveryCharges.ToString("N2")</td>
                </tr>
            </tfoot>
        }
    </table>
</div>

@section Scripts {
    @if (Model.Rows.Count > 0)
    {
        <script>posDataTable('#dailyReportTable', { lengthBelow: true, hideFilter: true });</script>
    }
}
