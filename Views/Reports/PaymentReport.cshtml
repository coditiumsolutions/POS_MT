@model PaymentReportViewModel
@{
    ViewData["Title"] = "Payment Report";
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <span class="sales-invoices-heading">Payment Report</span>
    <a class="btn btn-outline-dark btn-sm"
       asp-action="PrintPaymentReport"
       asp-route-dateFrom="@Model.DateFrom.ToString("yyyy-MM-dd")"
       asp-route-dateTo="@Model.DateTo.ToString("yyyy-MM-dd")"
       target="_blank"
       rel="noopener">
        <i class="bi bi-printer" aria-hidden="true"></i> Print Report
    </a>
</div>

<form method="get" asp-action="PaymentReport" class="bg-white border rounded p-3 mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="DateFrom">Start Date</label>
            <input type="date"
                   class="form-control"
                   id="DateFrom"
                   name="dateFrom"
                   value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3 col-sm-6">
            <label class="form-label" for="DateTo">End Date</label>
            <input type="date"
                   class="form-control"
                   id="DateTo"
                   name="dateTo"
                   value="@Model.DateTo.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-auto col-sm-6">
            <label class="form-label d-none d-md-block">&nbsp;</label>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-4">Apply</button>
                <a class="btn btn-outline-secondary btn-sm px-4" asp-action="PaymentReport">Reset</a>
            </div>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    <div class="col-md-3 col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted small">Payments</div>
            <div class="fs-4 fw-semibold">@Model.PaymentCount</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted small">Total Amount</div>
            <div class="fs-4 fw-semibold text-success">@Model.TotalAmount.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted small">To Invoice</div>
            <div class="fs-4 fw-semibold">@Model.TotalAppliedToInvoice.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="bg-white border rounded p-3 h-100">
            <div class="text-muted small">To Advance</div>
            <div class="fs-4 fw-semibold">@Model.TotalAdvance.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white border rounded p-2">
    <table id="paymentReportTable" class="table table-striped table-hover w-100 mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Payment No</th>
                <th>Customer</th>
                <th>Type</th>
                <th>Invoice</th>
                <th>Method</th>
                <th class="text-end">Amount</th>
                <th class="text-end">To Invoice</th>
                <th class="text-end">To Advance</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-muted text-center py-4">
                    No payments for @Model.DateFrom.ToString("dd MMM yyyy") – @Model.DateTo.ToString("dd MMM yyyy").
                </td>
            </tr>
        }
        else
        {
            foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.PaymentDate.ToString("dd-MMM-yyyy")</td>
                    <td>@row.PaymentNo</td>
                    <td>@row.CustomerName</td>
                    <td>@row.PaymentType</td>
                    <td>@(row.InvoiceNo ?? "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(row.PaymentMethod) ? "—" : row.PaymentMethod)</td>
                    <td class="text-end">@row.Amount.ToString("N2")</td>
                    <td class="text-end">@row.AppliedToInvoiceAmount.ToString("N2")</td>
                    <td class="text-end">@row.AdvanceAmount.ToString("N2")</td>
                </tr>
            }
        }
        </tbody>
        @if (Model.Rows.Count > 0)
        {
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="6">Total</td>
                    <td class="text-end">@Model.TotalAmount.ToString("N2")</td>
                    <td class="text-end">@Model.TotalAppliedToInvoice.ToString("N2")</td>
                    <td class="text-end">@Model.TotalAdvance.ToString("N2")</td>
                </tr>
            </tfoot>
        }
    </table>
</div>

@section Scripts {
    @if (Model.Rows.Count > 0)
    {
        <script>posDataTable('#paymentReportTable', { lengthBelow: true, hideFilter: true });</script>
    }
}
