@model TerminalDailyReportViewModel
@{
    ViewData["Title"] = "Terminal Report";
}

<div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
    <span class="sales-invoices-heading">Terminal Report</span>
</div>

<form method="get" asp-action="TerminalReport" class="bg-white border rounded px-2 py-2 mb-2 report-filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="DateFrom">Start Date</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="DateFrom"
                   name="dateFrom"
                   value="@Model.DateFrom.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="DateTo">End Date</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="DateTo"
                   name="dateTo"
                   value="@Model.DateTo.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="Branch">Branch</label>
            <select asp-for="Branch" asp-items="Model.Branches" class="form-select form-select-sm" id="Branch" name="branch"></select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="Terminal">Terminal</label>
            <select asp-for="Terminal" asp-items="Model.Terminals" class="form-select form-select-sm" id="Terminal" name="terminal"></select>
        </div>
        <div class="col-md-2 col-sm-6">
            <label class="form-label small mb-1" for="UserName">User</label>
            <select asp-for="UserName" asp-items="Model.Users" class="form-select form-select-sm" id="UserName" name="user"></select>
        </div>
        <div class="col-md-auto col-sm-6">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3">Apply</button>
                <a class="btn btn-outline-secondary btn-sm px-3" asp-action="TerminalReport">Reset</a>
            </div>
        </div>
    </div>
</form>

<div class="row g-2 mb-2">
    <div class="col-md-4 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--lines">
            <div class="small mb-0">Invoices</div>
            <div class="fs-5 fw-semibold mb-0">@Model.TotalInvoices</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--amount">
            <div class="small mb-0">Total Net Sale</div>
            <div class="fs-5 fw-semibold mb-0">@Model.TotalNetAmount.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4 col-sm-6">
        <div class="border rounded px-2 py-2 h-100 report-metric report-metric--qty">
            <div class="small mb-0">Total Paid</div>
            <div class="fs-5 fw-semibold mb-0">@Model.TotalPaidAmount.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white border rounded p-2">
    <table id="terminalReportTable" class="table table-sm table-striped table-hover align-middle w-100 mb-0 report-grid-table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Terminal</th>
                <th>User</th>
                <th class="text-end">Invoices</th>
                <th class="text-end report-col-amount">Net Amount</th>
                <th class="text-end">Paid Amount</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-muted text-center py-3">
                    No sales invoices for @Model.DateFrom.ToString("dd-MMM-yyyy") – @Model.DateTo.ToString("dd-MMM-yyyy").
                </td>
            </tr>
        }
        else
        {
            foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.BranchName</td>
                    <td>@row.TerminalName</td>
                    <td>@row.UserName</td>
                    <td class="text-end">@row.InvoiceCount</td>
                    <td class="text-end report-col-amount">@row.TotalNetAmount.ToString("N2")</td>
                    <td class="text-end">@row.TotalPaidAmount.ToString("N2")</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@section Scripts {
    @if (Model.Rows.Count > 0)
    {
        <script>posDataTable('#terminalReportTable', { lengthBelow: true, hideFilter: true, ordering: false });</script>
    }
}
