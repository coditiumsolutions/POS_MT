@model SalesInvoiceDetailViewModel
@{
    ViewData["Title"] = "Invoice Detail";
}

<h1 class="page-heading mb-3">Invoice Detail</h1>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="bg-white border rounded p-3 h-100">
            <h2 class="h5 mb-3">Sales Invoice Detail</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Detail UID</dt><dd class="col-sm-8">@Model.DetailUid</dd>
                <dt class="col-sm-4">Product Code</dt><dd class="col-sm-8">@Model.ProductCode</dd>
                <dt class="col-sm-4">Product Name</dt><dd class="col-sm-8">@Model.ProductName</dd>
                <dt class="col-sm-4">Quantity</dt><dd class="col-sm-8">@Model.Quantity.ToString("N3")</dd>
                <dt class="col-sm-4">Unit Price</dt><dd class="col-sm-8">@Model.UnitPrice.ToString("N2")</dd>
                <dt class="col-sm-4">Discount %</dt><dd class="col-sm-8">@Model.DiscountPercent.ToString("N2")</dd>
                <dt class="col-sm-4">Discount Amount</dt><dd class="col-sm-8">@Model.DiscountAmount.ToString("N2")</dd>
                <dt class="col-sm-4">Tax %</dt><dd class="col-sm-8">@Model.TaxPercent.ToString("N2")</dd>
                <dt class="col-sm-4">Tax Amount</dt><dd class="col-sm-8">@Model.TaxAmount.ToString("N2")</dd>
                <dt class="col-sm-4">Line Total</dt><dd class="col-sm-8 fw-semibold">@Model.LineTotal.ToString("N2")</dd>
                <dt class="col-sm-4">Cost Price</dt><dd class="col-sm-8">@Model.CostPrice.ToString("N2")</dd>
                <dt class="col-sm-4">Line Remarks</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.DetailRemarks) ? "—" : Model.DetailRemarks)</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="bg-white border rounded p-3 h-100">
            <h2 class="h5 mb-3">Sales Invoice</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Invoice No</dt><dd class="col-sm-8">@Model.InvoiceNo</dd>
                <dt class="col-sm-4">Invoice Date</dt><dd class="col-sm-8">@Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-sm-4">Invoice Status</dt><dd class="col-sm-8">@Model.InvoiceStatus</dd>
                <dt class="col-sm-4">Payment Status</dt><dd class="col-sm-8">@Model.PaymentStatus</dd>
                <dt class="col-sm-4">Invoice Net</dt><dd class="col-sm-8">@Model.InvoiceNetAmount.ToString("N2")</dd>
                <dt class="col-sm-4">Invoice Remarks</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.InvoiceRemarks) ? "—" : Model.InvoiceRemarks)</dd>
            </dl>

            <h2 class="h5 mt-4 mb-3">Customer</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Customer Code</dt><dd class="col-sm-8">@Model.CustomerCode</dd>
                <dt class="col-sm-4">Customer Name</dt><dd class="col-sm-8">@Model.CustomerName</dd>
                <dt class="col-sm-4">Customer Type</dt><dd class="col-sm-8">@Model.CustomerType</dd>
            </dl>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-primary"
       asp-controller="SalesInvoices"
       asp-action="Details"
       asp-route-id="@Model.SalesInvoiceUid">Open Invoice</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Invoice Details</a>
</div>
