@model SalesInvoiceDetailViewModel
@{
    ViewData["Title"] = "Invoice Detail";
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <span class="sales-invoices-heading">Invoice Detail</span>
</div>

<div class="bg-white border rounded p-3 invoice-detail-report">
    <div class="invoice-detail-grid" role="list">
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Detail UID</div>
            <div class="invoice-detail-value">@Model.DetailUid</div>
            <div class="invoice-detail-label">Invoice No</div>
            <div class="invoice-detail-value">@Model.InvoiceNo</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Invoice Date</div>
            <div class="invoice-detail-value">@Model.InvoiceDate.ToString("yyyy-MM-dd HH:mm")</div>
            <div class="invoice-detail-label">Customer Name</div>
            <div class="invoice-detail-value">@Model.CustomerName</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Customer Code</div>
            <div class="invoice-detail-value">@Model.CustomerCode</div>
            <div class="invoice-detail-label">Customer Type</div>
            <div class="invoice-detail-value">@Model.CustomerType</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Product Code</div>
            <div class="invoice-detail-value">@Model.ProductCode</div>
            <div class="invoice-detail-label">Product Name</div>
            <div class="invoice-detail-value">@Model.ProductName</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Quantity</div>
            <div class="invoice-detail-value">@Model.Quantity.ToString("N3")</div>
            <div class="invoice-detail-label">Unit Price</div>
            <div class="invoice-detail-value">@Model.UnitPrice.ToString("N2")</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Discount %</div>
            <div class="invoice-detail-value">@Model.DiscountPercent.ToString("N2")</div>
            <div class="invoice-detail-label">Discount Amount</div>
            <div class="invoice-detail-value">@Model.DiscountAmount.ToString("N2")</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Tax %</div>
            <div class="invoice-detail-value">@Model.TaxPercent.ToString("N2")</div>
            <div class="invoice-detail-label">Tax Amount</div>
            <div class="invoice-detail-value">@Model.TaxAmount.ToString("N2")</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Line Total</div>
            <div class="invoice-detail-value fw-semibold">@Model.LineTotal.ToString("N2")</div>
            <div class="invoice-detail-label">Cost Price</div>
            <div class="invoice-detail-value">@Model.CostPrice.ToString("N2")</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Invoice Status</div>
            <div class="invoice-detail-value">@Model.InvoiceStatus</div>
            <div class="invoice-detail-label">Payment Status</div>
            <div class="invoice-detail-value">@Model.PaymentStatus</div>
        </div>
        <div class="invoice-detail-row" role="listitem">
            <div class="invoice-detail-label">Invoice Net</div>
            <div class="invoice-detail-value invoice-detail-value--net">@Model.InvoiceNetAmount.ToString("N2")</div>
            <div class="invoice-detail-label">Line Remarks</div>
            <div class="invoice-detail-value">@(string.IsNullOrWhiteSpace(Model.DetailRemarks) ? "—" : Model.DetailRemarks)</div>
        </div>
        <div class="invoice-detail-row invoice-detail-row--last" role="listitem">
            <div class="invoice-detail-label">Invoice Remarks</div>
            <div class="invoice-detail-value invoice-detail-value--span">@(string.IsNullOrWhiteSpace(Model.InvoiceRemarks) ? "—" : Model.InvoiceRemarks)</div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2 flex-wrap">
    <a class="btn btn-outline-primary"
       asp-controller="SalesInvoices"
       asp-action="Details"
       asp-route-id="@Model.SalesInvoiceUid">Open Invoice</a>
    <a class="btn btn-outline-secondary" asp-action="Index">Back to Invoice Details</a>
</div>
