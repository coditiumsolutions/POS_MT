@model SalesInvoiceDetailIndexViewModel
@{
    ViewData["Title"] = "Invoice Details";
    var type = Model.CustomerType ?? string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="page-heading mb-1">Invoice Details</h1>
        <p class="text-muted mb-0">All line items from sales invoices.</p>
    </div>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" class="bg-white border rounded p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label mb-1" for="customerType">Customer Type</label>
            <select class="form-select" id="customerType" name="customerType">
                @if (string.IsNullOrWhiteSpace(type))
                {
                    <option value="" selected>All Customers</option>
                }
                else
                {
                    <option value="">All Customers</option>
                }
                @if (string.Equals(type, "walkin", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="walkin" selected>Walk-in Customers</option>
                }
                else
                {
                    <option value="walkin">Walk-in Customers</option>
                }
                @if (string.Equals(type, "monthly", StringComparison.OrdinalIgnoreCase))
                {
                    <option value="monthly" selected>Monthly Customers</option>
                }
                else
                {
                    <option value="monthly">Monthly Customers</option>
                }
            </select>
        </div>
        <div class="col-md-5">
            <label class="form-label mb-1" for="search">Search</label>
            <input type="search" class="form-control" id="search" name="search" value="@Model.Search"
                   placeholder="Invoice no, customer, product..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Invoice No</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Type</th>
                <th>Product</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Price</th>
                <th class="text-end">Total</th>
                <th>Status</th>
                <th style="width:140px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Rows)
        {
            <tr>
                <td>@item.InvoiceNo</td>
                <td>@item.InvoiceDate.ToString("yyyy-MM-dd")</td>
                <td>@item.CustomerName</td>
                <td>@item.CustomerType</td>
                <td>
                    <div class="fw-semibold">@item.ProductName</div>
                    <div class="small text-muted">@item.ProductCode</div>
                </td>
                <td class="text-end">@item.Quantity.ToString("N3")</td>
                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                <td class="text-end">@item.LineTotal.ToString("N2")</td>
                <td>@item.InvoiceStatus</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Details"
                       asp-route-id="@item.DetailUid">View</a>
                    <form asp-action="Delete" asp-route-id="@item.DetailUid" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerType" value="@Model.CustomerType" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Delete this invoice detail line?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>posDataTable('#crudTable');</script>
}
