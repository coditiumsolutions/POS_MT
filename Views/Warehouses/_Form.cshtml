@model WarehouseFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row g-3">
<div class="col-md-4"><label asp-for="WarehouseCode" class="form-label"></label><input asp-for="WarehouseCode" class="form-control" /><span asp-validation-for="WarehouseCode" class="text-danger"></span></div>
<div class="col-md-8"><label asp-for="WarehouseName" class="form-label"></label><input asp-for="WarehouseName" class="form-control" /><span asp-validation-for="WarehouseName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="BranchUid" class="form-label"></label><select asp-for="BranchUid" class="form-select" asp-items="ViewBag.Branches"><option value="">-- Select --</option></select></div>
<div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div>
<div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div>
<div class="col-md-4"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /></div>
<div class="col-md-4"><label asp-for="MobileNo" class="form-label"></label><input asp-for="MobileNo" class="form-control" /></div>
<div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
</div>
