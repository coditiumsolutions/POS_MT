@model IEnumerable<EmployeePaymentListItemViewModel>
@{
    ViewData["Title"] = "Salary Payments";
    var month = ViewBag.Month as int?;
    var year = ViewBag.Year as int?;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="page-heading mb-1">Salary Payments</h1>
        <p class="text-muted mb-0">All employee salary payments.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Record Payment</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

<form method="get" class="bg-white border rounded p-2 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-4 col-md-2">
            <label class="form-label mb-1" for="month">Month</label>
            <select class="form-select form-select-sm" id="month" name="month">
                <option value="">All</option>
                @for (var m = 1; m <= 12; m++)
                {
                    var name = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m);
                    if (month == m) { <option value="@m" selected>@name</option> }
                    else { <option value="@m">@name</option> }
                }
            </select>
        </div>
        <div class="col-sm-4 col-md-2">
            <label class="form-label mb-1" for="year">Year</label>
            <select class="form-select form-select-sm" id="year" name="year">
                <option value="">All</option>
                @for (var y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                {
                    if (year == y) { <option value="@y" selected>@y</option> }
                    else { <option value="@y">@y</option> }
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Payment No</th>
                <th>Date</th>
                <th>Employee</th>
                <th>Period</th>
                <th class="text-end">Amount</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var period = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(item.PeriodMonth) + " " + item.PeriodYear;
            <tr>
                <td>@item.PaymentNo</td>
                <td>@item.PaymentDate.ToString("yyyy-MM-dd")</td>
                <td>@item.EmployeeCode — @item.EmployeeName</td>
                <td>@period</td>
                <td class="text-end">@item.Amount.ToString("N2")</td>
                <td>@(item.Remarks ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
