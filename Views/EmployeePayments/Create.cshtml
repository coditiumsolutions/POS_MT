@model EmployeePaymentCreateViewModel
@{ ViewData["Title"] = "Record Salary Payment"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-heading mb-0">Record Salary Payment</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>
<form asp-action="Create" method="post" class="bg-white border rounded p-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="EmployeeUid" class="form-label">Employee</label>
            <select asp-for="EmployeeUid" asp-items="ViewBag.Employees" class="form-select">
                <option value="">Select employee…</option>
            </select>
            <span asp-validation-for="EmployeeUid" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PaymentDate" class="form-label"></label>
            <input asp-for="PaymentDate" type="date" class="form-control" />
            <span asp-validation-for="PaymentDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="PeriodMonth" class="form-label">Salary Month</label>
            <select asp-for="PeriodMonth" class="form-select">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="PeriodYear" class="form-label">Salary Year</label>
            <input asp-for="PeriodYear" type="number" class="form-control" />
            <span asp-validation-for="PeriodYear" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Remarks" class="form-label"></label>
            <input asp-for="Remarks" class="form-control" />
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Payment</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
