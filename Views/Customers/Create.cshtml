@model CustomerFormViewModel
@{
    ViewData["Title"] = "Add Customer";
}
<h1 class="page-heading invoice-details-heading mb-3">Add Customer</h1>
<form asp-action="Create" method="post" class="bg-white border rounded p-3">
    @Html.AntiForgeryToken()
    <partial name="_CustomerForm" />
    <partial name="_CrudFormActions" />
</form>

@section Scripts {
    <script>
        (function () {
            const prefix = document.getElementById('CodePrefix');
            const code = document.getElementById('CustomerCode');
            if (!prefix || !code) return;
            const number = code.getAttribute('data-number') || '';
            function applyPrefix() {
                const cleaned = (prefix.value || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase().slice(0, 8);
                if (prefix.value !== cleaned) prefix.value = cleaned;
                code.value = cleaned + number;
            }
            prefix.addEventListener('input', applyPrefix);
        })();
    </script>
}
