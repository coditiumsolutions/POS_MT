@model Customer
@{
    ViewData["Title"] = "Customer Details";
    string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
<h1 class="page-heading invoice-details-heading mb-3">Customer Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Customer Code</div>
            <div class="invoice-meta-field">@Model.CustomerCode</div>
            <div class="invoice-meta-title">Customer Name</div>
            <div class="invoice-meta-field">@Model.CustomerName</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Mobile No</div>
            <div class="invoice-meta-field">@Text(Model.MobileNo)</div>
            <div class="invoice-meta-title">Phone No</div>
            <div class="invoice-meta-field">@Text(Model.PhoneNo)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Email</div>
            <div class="invoice-meta-field">@Text(Model.Email)</div>
            <div class="invoice-meta-title">City</div>
            <div class="invoice-meta-field">@Text(Model.City)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Area</div>
            <div class="invoice-meta-field">@Text(Model.Area)</div>
            <div class="invoice-meta-title">Address</div>
            <div class="invoice-meta-field">@Text(Model.Address)</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">NTN</div>
            <div class="invoice-meta-field">@Text(Model.Ntn)</div>
            <div class="invoice-meta-title"></div>
            <div class="invoice-meta-field"></div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Opening Balance</div>
            <div class="invoice-meta-field">@Model.OpeningBalance.ToString("N2")</div>
            <div class="invoice-meta-title">Advance Credit</div>
            <div class="invoice-meta-field fw-semibold text-success">@Model.AdvanceBalance.ToString("N2")</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Credit Limit</div>
            <div class="invoice-meta-field">@Model.CreditLimit.ToString("N2")</div>
            <div class="invoice-meta-title"></div>
            <div class="invoice-meta-field"></div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Discount %</div>
            <div class="invoice-meta-field">@Model.DiscountPercent.ToString("N2")</div>
            <div class="invoice-meta-title">Active</div>
            <div class="invoice-meta-field">@(Model.IsActive ? "Yes" : "No")</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-primary" asp-controller="CustomerPayments" asp-action="Create" asp-route-customerUid="@Model.Uid">Add Advance / Payment</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
        @{
            var isSystemCustomer = string.Equals(Model.CustomerCode, "C001", StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(Model.CustomerName)
                    && (Model.CustomerName.Contains("Walk-in", StringComparison.OrdinalIgnoreCase)
                        || Model.CustomerName.Contains("Walk In", StringComparison.OrdinalIgnoreCase)));
        }
        @if (!isSystemCustomer)
        {
            <form asp-action="Delete" asp-route-id="@Model.Uid" method="post" class="ms-auto">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-outline-danger"
                        onclick="return confirm('Delete this customer and related sales, payments, and monthly supply records?');">Delete</button>
            </form>
        }
    </div>
</div>
