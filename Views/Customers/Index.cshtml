@model IEnumerable<Customer>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Customers";
    var filter = ViewData["Filter"] as string;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="page-heading mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Manage customer master records.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add Customer</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>City</th>
                <th>Credit Limit</th>
                <th>Active</th>
                <th style="width:180px">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerCode</td>
                <td>@item.CustomerName</td>
                <td>@item.MobileNo</td>
                <td>@item.City</td>
                <td>@item.CreditLimit.ToString("N2")</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
                    @if (item.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@item.Uid" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this customer?');">Deactivate</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
