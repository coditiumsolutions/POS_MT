@model IEnumerable<Customer>
@{
    ViewData["Title"] = ViewData["Title"] ?? "Customers";
    var filter = ViewData["Filter"] as string;
}
<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <span class="sales-invoices-heading">@ViewData["Title"]</span>
    <a class="btn btn-primary btn-sm" asp-action="Create">Add Customer</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form asp-action="OpenItems" method="post" id="customersOpenItemsForm">
    @Html.AntiForgeryToken()
    @if (!string.IsNullOrWhiteSpace(filter))
    {
        <input type="hidden" name="filter" value="@filter" />
    }
    <div class="mb-2 d-flex flex-wrap gap-2 align-items-center">
        <button type="submit" class="btn btn-sm btn-primary" id="customersOpenItemsBtn" disabled>
            Open Items for Selected Customers
        </button>
        <span class="text-muted small">Selected: <strong id="customersSelectedCount">0</strong></span>
    </div>
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th style="width:42px">
                    <input type="checkbox" id="customersSelectAll" class="form-check-input" title="Select all" />
                </th>
                <th>Code</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>City</th>
                <th>Credit Limit</th>
                <th>Advance</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var isSystemCustomer = string.Equals(item.CustomerCode, "C001", StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(item.CustomerName)
                    && (item.CustomerName.Contains("Walk-in", StringComparison.OrdinalIgnoreCase)
                        || item.CustomerName.Contains("Walk In", StringComparison.OrdinalIgnoreCase)));
            <tr>
                <td>
                    <input type="checkbox"
                           class="form-check-input customer-select-check"
                           form="customersOpenItemsForm"
                           name="selectedCustomerUids"
                           value="@item.Uid"
                           @(item.IsActive ? null : "disabled")
                           title="@(item.IsActive ? "Select customer" : "Inactive customers cannot open items")" />
                </td>
                <td>@item.CustomerCode</td>
                <td>@item.CustomerName</td>
                <td>@item.MobileNo</td>
                <td>@item.City</td>
                <td>@item.CreditLimit.ToString("N2")</td>
                <td>@item.AdvanceBalance.ToString("N2")</td>
                <td>@(item.IsActive ? "Yes" : "No")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
                    @if (item.IsActive)
                    {
                        <a class="btn btn-sm btn-outline-success"
                           asp-controller="POS"
                           asp-action="MonthlySupplyItems"
                           asp-route-customerUids="@item.Uid"
                           asp-route-returnTo="Customers">Items</a>
                        <form asp-action="Deactivate" asp-route-id="@item.Uid" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this customer?');">Deactivate</button>
                        </form>
                    }
                    @if (!isSystemCustomer)
                    {
                        <form asp-action="Delete" asp-route-id="@item.Uid" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (!string.IsNullOrWhiteSpace(filter))
                            {
                                <input type="hidden" name="filter" value="@filter" />
                            }
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Delete this customer and related sales, payments, and monthly supply records?');">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        posDataTable('#crudTable');
        (function () {
            const selectAll = document.getElementById('customersSelectAll');
            const countLabel = document.getElementById('customersSelectedCount');
            const openBtn = document.getElementById('customersOpenItemsBtn');
            const form = document.getElementById('customersOpenItemsForm');

            function checks() {
                return Array.from(document.querySelectorAll('.customer-select-check:not([disabled])'));
            }

            function refresh() {
                const selected = checks().filter(function (c) { return c.checked; }).length;
                if (countLabel) countLabel.textContent = String(selected);
                if (openBtn) openBtn.disabled = selected === 0;
                if (selectAll) {
                    const all = checks();
                    selectAll.checked = all.length > 0 && selected === all.length;
                    selectAll.indeterminate = selected > 0 && selected < all.length;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checks().forEach(function (c) { c.checked = selectAll.checked; });
                    refresh();
                });
            }

            document.addEventListener('change', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('customer-select-check')) {
                    refresh();
                }
            });

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (checks().filter(function (c) { return c.checked; }).length === 0) {
                        e.preventDefault();
                        alert('Select at least one customer.');
                    }
                });
            }

            refresh();
        })();
    </script>
}
