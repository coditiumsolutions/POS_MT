@model PurchaseInvoiceFormViewModel
@{ ViewData["Title"] = "Edit Purchase Invoice"; }
<h1 class="page-heading invoice-details-heading mb-3">Edit Purchase Invoice</h1>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<form asp-action="Edit" method="post" class="bg-white border rounded p-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Uid" />
    <partial name="_Form" />
    <partial name="_CrudFormActions" />
</form>
<div class="bg-white border rounded p-3 mt-3">
    <partial name="_VendorPayments" />
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
