@model IEnumerable<PurchaseInvoice>
@{ ViewData["Title"] = "Purchase Invoices"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-heading mb-1">Purchase Invoices</h1><p class="text-muted mb-0">Manage Purchase Invoices.</p></div><a class="btn btn-primary" asp-action="Create">Add New</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="table-responsive bg-white border rounded p-2"><table id="crudTable" class="table table-striped table-hover w-100"><thead><tr><th>Invoice No</th><th>Date</th><th>Net</th><th>Paid</th><th>Status</th><th style="width:190px">Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.PurchaseInvoiceNo</td><td>@item.PurchaseDate.ToString("yyyy-MM-dd")</td><td>@item.NetAmount.ToString("N2")</td><td>@item.PaidAmount.ToString("N2")</td><td>@item.InvoiceStatus</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
<form asp-action="Cancel" asp-route-id="@item.Uid" method="post" class="d-inline">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this record?');">Cancel</button></form></td></tr> }
</tbody></table></div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
