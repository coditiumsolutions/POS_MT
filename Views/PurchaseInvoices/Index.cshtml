@model IEnumerable<PurchaseInvoiceListItemViewModel>
@{
    ViewData["Title"] = "Purchase Invoices";
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-heading mb-1">Purchase Invoices</h1>
        <p class="text-muted mb-0">Manage Purchase Invoices.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add New</a>
</div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<form method="get" id="purchaseInvoicesFilterForm" class="bg-white border rounded p-2 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-6 col-md-3 col-lg-2">
            <label class="form-label mb-1" for="dateFrom">Date From</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="dateFrom"
                   name="dateFrom"
                   value="@(dateFrom?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <div class="col-sm-6 col-md-3 col-lg-2">
            <label class="form-label mb-1" for="dateTo">Date To</label>
            <input type="date"
                   class="form-control form-control-sm"
                   id="dateTo"
                   name="dateTo"
                   value="@(dateTo?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Clear</a>
        </div>
    </div>
</form>

<div class="d-flex flex-wrap gap-2 align-items-center mb-2">
    <button type="button" id="btnEditPurchase" class="btn btn-sm btn-outline-primary" disabled>Edit</button>
    <button type="button" id="btnViewPurchase" class="btn btn-sm btn-outline-secondary" disabled>View</button>
    <button type="button" id="btnCancelPurchase" class="btn btn-sm btn-outline-warning" disabled>Cancel</button>
    <button type="button" id="btnDeletePurchase" class="btn btn-sm btn-outline-danger" disabled>Delete</button>
</div>

<form id="cancelPurchaseForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>
<form id="deletePurchaseForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-striped table-hover w-100">
        <thead>
            <tr>
                <th style="width:42px" class="text-center">
                    <span class="visually-hidden">Select</span>
                </th>
                <th>Invoice No</th>
                <th>Vendor</th>
                <th>Date</th>
                <th class="text-end">Net</th>
                <th class="text-end">Paid</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var orderDate = item.PurchaseDate.ToString("yyyy-MM-dd HH:mm:ss");
            var displayDate = item.PurchaseDate.ToString("dd-MMM-yyyy HH:mm");
            var vendorLabel = string.IsNullOrWhiteSpace(item.VendorName) ? "-" : item.VendorName;
            <tr class="purchase-invoice-row"
                data-uid="@item.Uid"
                data-status="@item.InvoiceStatus">
                <td class="text-center">
                    <input type="radio"
                           class="form-check-input purchase-invoice-select"
                           name="selectedPurchaseInvoice"
                           value="@item.Uid"
                           data-status="@item.InvoiceStatus"
                           aria-label="Select @item.PurchaseInvoiceNo" />
                </td>
                <td>@item.PurchaseInvoiceNo</td>
                <td>@vendorLabel</td>
                <td data-order="@orderDate">@displayDate</td>
                <td class="text-end">@item.NetAmount.ToString("N2")</td>
                <td class="text-end">@item.PaidAmount.ToString("N2")</td>
                <td>@item.InvoiceStatus</td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        (function () {
            const editUrlBase = '@Url.Action("Edit", "PurchaseInvoices")';
            const viewUrlBase = '@Url.Action("Details", "PurchaseInvoices")';
            const cancelUrlBase = '@Url.Action("Cancel", "PurchaseInvoices")';
            const deleteUrlBase = '@Url.Action("Delete", "PurchaseInvoices")';

            const btnEdit = document.getElementById('btnEditPurchase');
            const btnView = document.getElementById('btnViewPurchase');
            const btnCancel = document.getElementById('btnCancelPurchase');
            const btnDelete = document.getElementById('btnDeletePurchase');
            const cancelForm = document.getElementById('cancelPurchaseForm');
            const deleteForm = document.getElementById('deletePurchaseForm');
            const table = document.getElementById('crudTable');

            let selectedUid = null;
            let selectedStatus = '';

            function updateActions() {
                const hasSelection = selectedUid != null;
                const isCancelled = (selectedStatus || '').toLowerCase() === 'cancelled';
                btnEdit.disabled = !hasSelection || isCancelled;
                btnView.disabled = !hasSelection;
                btnCancel.disabled = !hasSelection || isCancelled;
                btnDelete.disabled = !hasSelection;
            }

            function selectFromRadio(radio) {
                if (!radio) {
                    selectedUid = null;
                    selectedStatus = '';
                    updateActions();
                    return;
                }
                selectedUid = radio.value;
                selectedStatus = radio.getAttribute('data-status') || '';
                updateActions();
            }

            table.addEventListener('change', function (e) {
                const radio = e.target.closest('.purchase-invoice-select');
                if (!radio) return;
                selectFromRadio(radio);
            });

            table.addEventListener('click', function (e) {
                if (e.target.closest('.purchase-invoice-select')) return;
                const row = e.target.closest('.purchase-invoice-row');
                if (!row) return;
                const radio = row.querySelector('.purchase-invoice-select');
                if (!radio) return;
                radio.checked = true;
                selectFromRadio(radio);
            });

            btnEdit.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = editUrlBase + '/' + selectedUid;
            });

            btnView.addEventListener('click', function () {
                if (!selectedUid) return;
                window.location.href = viewUrlBase + '/' + selectedUid;
            });

            btnCancel.addEventListener('click', function () {
                if (!selectedUid) return;
                if (!confirm('Cancel this purchase invoice? Stock will be reversed.')) return;
                cancelForm.action = cancelUrlBase + '/' + selectedUid;
                cancelForm.submit();
            });

            btnDelete.addEventListener('click', function () {
                if (!selectedUid) return;
                if (!confirm('Delete this purchase invoice permanently?')) return;
                deleteForm.action = deleteUrlBase + '/' + selectedUid;
                deleteForm.submit();
            });

            updateActions();
            posDataTable('#crudTable', {
                lengthBelow: true,
                order: [[3, 'desc']],
                columnDefs: [{ orderable: false, targets: 0 }]
            });
        })();
    </script>
}
