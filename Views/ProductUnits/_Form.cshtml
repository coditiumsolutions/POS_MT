@model ProductUnitFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row g-3">
<div class="col-md-4"><label asp-for="UnitCode" class="form-label"></label><input asp-for="UnitCode" class="form-control" /><span asp-validation-for="UnitCode" class="text-danger"></span></div>
<div class="col-md-8"><label asp-for="UnitName" class="form-label"></label><input asp-for="UnitName" class="form-control" /><span asp-validation-for="UnitName" class="text-danger"></span></div>
<div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="DecimalAllowed" class="form-check-input" /><label asp-for="DecimalAllowed" class="form-check-label"></label></div></div>
<div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
</div>
