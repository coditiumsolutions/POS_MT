@model ProductUnit
@{ ViewData["Title"] = "Product Unit Details"; }
<h1 class="page-heading invoice-details-heading mb-3">Product Unit Details</h1>
<div class="bg-white border rounded p-3">
    <div class="invoice-meta-grid invoice-meta-form invoice-meta-readonly">
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Unit Code</div>
            <div class="invoice-meta-field">@Model.UnitCode</div>
            <div class="invoice-meta-title">Unit Name</div>
            <div class="invoice-meta-field">@Model.UnitName</div>
        </div>
        <div class="invoice-meta-row">
            <div class="invoice-meta-title">Decimal Allowed</div>
            <div class="invoice-meta-field">@(Model.DecimalAllowed ? "Yes" : "No")</div>
            <div class="invoice-meta-title">Active</div>
            <div class="invoice-meta-field">@(Model.IsActive ? "Yes" : "No")</div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
