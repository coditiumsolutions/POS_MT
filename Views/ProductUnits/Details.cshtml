@model ProductUnit
@{ ViewData["Title"] = "Product Unit Details"; }
<h1 class="page-heading mb-3">Product Unit Details</h1>
<div class="bg-white border rounded p-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.UnitCode</dd>
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.UnitName</dd>
        <dt class="col-sm-3">Decimal Allowed</dt><dd class="col-sm-9">@(Model.DecimalAllowed ? "Yes" : "No")</dd>
        <dt class="col-sm-3">Active</dt><dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
    </dl>
    <div class="mt-3">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Uid">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>
