@model VendorPaymentFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row g-3">
<div class="col-md-4"><label asp-for="PaymentNo" class="form-label"></label><input asp-for="PaymentNo" class="form-control" /><span asp-validation-for="PaymentNo" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="PaymentDate" class="form-label"></label><input asp-for="PaymentDate" class="form-control" type="datetime-local" /></div>
<div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" /></div>
<div class="col-md-6"><label asp-for="VendorUid" class="form-label"></label><select asp-for="VendorUid" class="form-select" asp-items="ViewBag.Vendors"></select><span asp-validation-for="VendorUid" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="PurchaseInvoiceUid" class="form-label"></label><select asp-for="PurchaseInvoiceUid" class="form-select" asp-items="ViewBag.Invoices"><option value="">-- Optional --</option></select></div>
<div class="col-md-6"><label asp-for="PaymentMethodUid" class="form-label"></label><select asp-for="PaymentMethodUid" class="form-select" asp-items="ViewBag.PaymentMethods"><option value="">-- Select --</option></select></div>
<div class="col-md-6"><label asp-for="ReferenceNo" class="form-label"></label><input asp-for="ReferenceNo" class="form-control" /></div>
<div class="col-md-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="2"></textarea></div>
</div>
