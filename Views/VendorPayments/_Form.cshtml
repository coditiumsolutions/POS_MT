@model VendorPaymentFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="invoice-meta-grid invoice-meta-form">
    <div class="invoice-meta-row">
        <label asp-for="PaymentNo" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="PaymentNo" class="form-control form-control-sm invoice-meta-input" />
            <span asp-validation-for="PaymentNo" class="text-danger"></span>
        </div>
        <label asp-for="PaymentDate" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="PaymentDate" class="form-control form-control-sm invoice-meta-input" type="datetime-local" />
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="Amount" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="Amount" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <label asp-for="VendorUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="VendorUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Vendors"></select>
            <span asp-validation-for="VendorUid" class="text-danger"></span>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="PurchaseInvoiceUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="PurchaseInvoiceUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.Invoices">
                <option value="">-- Optional --</option>
            </select>
        </div>
        <label asp-for="PaymentMethodUid" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <select asp-for="PaymentMethodUid" class="form-select form-select-sm invoice-meta-input" asp-items="ViewBag.PaymentMethods">
                <option value="">-- Select --</option>
            </select>
        </div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="ReferenceNo" class="invoice-meta-title"></label>
        <div class="invoice-meta-field">
            <input asp-for="ReferenceNo" class="form-control form-control-sm invoice-meta-input" />
        </div>
        <div class="invoice-meta-title"></div>
        <div class="invoice-meta-field"></div>
    </div>
    <div class="invoice-meta-row">
        <label asp-for="Remarks" class="invoice-meta-title"></label>
        <div class="invoice-meta-field invoice-meta-field-span">
            <textarea asp-for="Remarks" class="form-control form-control-sm invoice-meta-input" rows="2"></textarea>
        </div>
    </div>
</div>
