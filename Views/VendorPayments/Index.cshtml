@model IEnumerable<VendorPayment>
@{ ViewData["Title"] = "Vendor Payments"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="page-heading mb-1">Vendor Payments</h1><p class="text-muted mb-0">Manage Vendor Payments.</p></div><a class="btn btn-primary" asp-action="Create">Add New</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="table-responsive bg-white border rounded p-2"><table id="crudTable" class="table table-striped table-hover w-100"><thead><tr><th>Payment No</th><th>Date</th><th>VendorUID</th><th>Amount</th><th style="width:190px">Actions</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.PaymentNo</td><td>@item.PaymentDate.ToString("yyyy-MM-dd")</td><td>@item.VendorUid</td><td>@item.Amount.ToString("N2")</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Uid">Edit</a>
<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a></td></tr> }
</tbody></table></div>
@section Scripts { <script>posDataTable('#crudTable');</script> }
