@model IEnumerable<SalesReturnListItemViewModel>
@{
    ViewData["Title"] = "Sales Returns";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h1 class="page-heading mb-1">Sales Returns</h1>
        <p class="text-muted mb-0">Restock returned items and reduce sales totals.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New Return</a>
</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<div class="table-responsive bg-white border rounded p-2">
    <table id="crudTable" class="table table-hover w-100">
        <thead>
            <tr>
                <th>Return No</th>
                <th>Date</th>
                <th class="text-end">Amount</th>
                <th>Remarks</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ReturnNo</td>
                <td>@item.ReturnDate.ToString("dd-MMM-yyyy HH:mm")</td>
                <td class="text-end text-danger">@item.NetAmount.ToString("N2")</td>
                <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "—" : item.Remarks)</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Uid">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>posDataTable('#crudTable');</script>
}
