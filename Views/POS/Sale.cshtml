@model PosSaleViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.PageTitle) ? $"{Model.Mode} POS" : Model.PageTitle;
    string ItemIcon(string? name)
    {
        var n = (name ?? "").ToLowerInvariant();
        if (n.Contains("milk") || n.Contains("dairy") || n.Contains("yogurt") || n.Contains("yoghurt") || n.Contains("cream")) return "bi-cup-straw";
        if (n.Contains("butter") || n.Contains("ghee") || n.Contains("margarine")) return "bi-droplet-fill";
        if (n.Contains("cheese") || n.Contains("topping")) return "bi-circle-half";
        if (n.Contains("bread") || n.Contains("roti") || n.Contains("bun") || n.Contains("loaf")) return "bi-basket2-fill";
        if (n.Contains("egg")) return "bi-egg-fill";
        if (n.Contains("rice") || n.Contains("flour") || n.Contains("atta") || n.Contains("grocery") || n.Contains("pulse") || n.Contains("dal")) return "bi-bag-fill";
        if (n.Contains("oil") || n.Contains("spice") || n.Contains("salt") || n.Contains("sugar") || n.Contains("extra")) return "bi-box-seam-fill";
        if (n.Contains("fruit") || n.Contains("apple") || n.Contains("banana") || n.Contains("mango") || n.Contains("orange")) return "bi-apple";
        if (n.Contains("veg") || n.Contains("salad") || n.Contains("tomato") || n.Contains("onion")) return "bi-flower1";
        if (n.Contains("meat") || n.Contains("mutton") || n.Contains("beef") || n.Contains("bbq") || n.Contains("b.b.q") || n.Contains("barbe")) return "bi-fire";
        if (n.Contains("chicken") || n.Contains("broast") || n.Contains("crispy")) return "bi-egg-fill";
        if (n.Contains("fish") || n.Contains("seafood")) return "bi-water";
        if (n.Contains("pizza") || n.Contains("calzone")) return "bi-pie-chart-fill";
        if (n.Contains("burger") || n.Contains("sandwich")) return "bi-layers-fill";
        if (n.Contains("fries") || n.Contains("fry") || n.Contains("chips")) return "bi-grid-3x2-gap-fill";
        if (n.Contains("pasta") || n.Contains("lasagna") || n.Contains("noodle")) return "bi-intersect";
        if (n.Contains("roll") || n.Contains("wrap")) return "bi-receipt";
        if (n.Contains("drink") || n.Contains("juice") || n.Contains("beverage") || n.Contains("soda") || n.Contains("water") || n.Contains("tea") || n.Contains("coffee")) return "bi-cup-hot-fill";
        if (n.Contains("ice") || n.Contains("dessert") || n.Contains("sweet") || n.Contains("cake")) return "bi-snow2";
        if (n.Contains("deal") || n.Contains("combo") || n.Contains("offer")) return "bi-tags-fill";
        if (n.Contains("deliver")) return "bi-truck";
        if (n.Contains("dawn") || n.Contains("brand")) return "bi-buildings-fill";
        return "bi-box2-fill";
    }

    string CardPrice(decimal price)
        => price == decimal.Truncate(price) ? $"Rs: {price:0}" : $"Rs: {price:N2}";

    string IconTone(string? name)
    {
        var tones = new[] { "blue", "orange", "green", "pink", "teal", "violet", "amber", "rose" };
        var key = name ?? string.Empty;
        var hash = 0;
        foreach (var ch in key)
        {
            hash = (hash * 31) + ch;
        }
        return tones[(hash & 0x7fffffff) % tones.Length];
    }
}
@Html.AntiForgeryToken()
<div id="posAlert" class="alert d-none mb-2" role="alert"></div>

<div id="posSaleLayout"
     class="pos-sale-layout @(Model.UseCardLayout ? "pos-sale-layout--cards" : "") @(Model.EnablePanelToggle ? "pos-sale-layout--interface2" : "") @(Model.EnableBarcodeScan ? "pos-sale-layout--barcode-only" : "")">
    <section class="pos-sale-panel pos-sale-panel--items @(Model.EnableBarcodeScan ? "pos-sale-panel--barcode-only" : "")">
        @if (Model.EnableBarcodeScan)
        {
            <div class="pos-barcode-center">
                <div class="pos-barcode-scan-wrap">
                    <label class="form-label small text-muted mb-1" for="posBarcodeScan">Barcode</label>
                    <input type="text"
                           id="posBarcodeScan"
                           class="form-control form-control-sm pos-barcode-scan-input"
                           placeholder="Scan barcode…"
                           autocomplete="off"
                           autofocus
                           inputmode="none"
                           spellcheck="false" />
                </div>
                <p class="pos-barcode-hint text-muted small mb-0">
                    Scan a barcode or type a product code and press Enter to add to the basket.
                </p>
            </div>
            @* Hidden catalog for barcode/code lookup — no item grid on this screen. *@
            <div id="productsTable" class="d-none" aria-hidden="true">
                @foreach (var item in Model.Products)
                {
                    <div class="pos-product-row"
                         data-uid="@item.Uid"
                         data-code="@item.ProductCode"
                         data-barcode="@(string.IsNullOrWhiteSpace(item.Barcode) ? item.ProductCode : item.Barcode)"
                         data-name="@item.ProductName"
                         data-category-uid="@(item.CategoryUid?.ToString() ?? "")"
                         data-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-stock="@item.StockQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-priced-by-dozen="@(item.PricedByDozen ? "1" : "0")"></div>
                }
            </div>
            @if (Model.Products.Count == 0)
            {
                <div class="p-3 text-muted">No active products found.</div>
            }
        }
        else
        {
        <div class="pos-sale-panel-header pos-sale-panel-header--search">
            <div class="pos-items-filters">
                <select id="posCategorySelect" class="form-select form-select-sm pos-category-select" aria-label="Product category">
                    <option value="">All categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Uid">@cat.CategoryName</option>
                    }
                </select>
                <input type="search" id="productSearch" class="form-control form-control-sm" placeholder="Search items..." />
            </div>
        </div>
            @if (Model.EnablePanelToggle)
            {
                <div class="pos-category-toolbar @(Model.UseCardLayout ? "pos-category-tiles" : "")" id="posCategoryToolbar" role="group" aria-label="Product categories">
                    @{
                        var catTone = 0;
                    }
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary pos-category-btn @(Model.UseCardLayout ? $"pos-cat-tone-{catTone++ % 12} active" : "active")"
                            data-category-uid="">
                        @if (Model.UseCardLayout)
                        {
                            <span class="pos-cat-accent" aria-hidden="true"></span>
                            <span class="pos-cat-icon" aria-hidden="true"><i class="bi bi-grid-fill"></i></span>
                            <span class="pos-cat-label">All Items</span>
                        }
                        else
                        {
                            @:All
                        }
                    </button>
                    @foreach (var cat in Model.Categories)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary pos-category-btn @(Model.UseCardLayout ? $"pos-cat-tone-{catTone++ % 12}" : null)"
                                data-category-uid="@cat.Uid">
                            @if (Model.UseCardLayout)
                            {
                                <span class="pos-cat-accent" aria-hidden="true"></span>
                                <span class="pos-cat-icon" aria-hidden="true"><i class="bi @ItemIcon(cat.CategoryName)"></i></span>
                                <span class="pos-cat-label">@cat.CategoryName</span>
                            }
                            else
                            {
                                @cat.CategoryName
                            }
                        </button>
                    }
                </div>
            }
            @if (Model.UseCardLayout)
            {
                <div class="pos-product-cards" id="productsTable">
                    @foreach (var item in Model.Products)
                    {
                        var iconSource = string.IsNullOrWhiteSpace(item.CategoryName) ? item.ProductName : item.ProductName + " " + item.CategoryName;
                        <button type="button"
                                class="pos-item-card pos-product-row"
                                data-uid="@item.Uid"
                                data-code="@item.ProductCode"
                                data-barcode="@(item.Barcode ?? "")"
                                data-name="@item.ProductName"
                                data-category-uid="@(item.CategoryUid?.ToString() ?? "")"
                                data-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-stock="@item.StockQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-priced-by-dozen="@(item.PricedByDozen ? "1" : "0")"
                                title="@item.ProductCode">
                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                            {
                                <img class="pos-item-card-photo" src="@item.ImagePath" alt="" />
                            }
                            else
                            {
                                <span class="pos-icon-tile pos-icon-tile--lg pos-icon-tone-@IconTone(iconSource)" aria-hidden="true">
                                    <i class="bi @ItemIcon(iconSource)"></i>
                                </span>
                            }
                            <span class="pos-item-card-name">@item.ProductName</span>
                            <span class="pos-item-card-price">@CardPrice(item.SalePrice)</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive pos-sale-table-wrap">
                    <table class="table table-hover table-sm align-middle mb-0" id="productsTable">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Name</th>
                                <th class="text-end">Price</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Products)
                        {
                            <tr class="pos-product-row"
                                data-uid="@item.Uid"
                                data-code="@item.ProductCode"
                                data-barcode="@(item.Barcode ?? "")"
                                data-name="@item.ProductName"
                                data-category-uid="@(item.CategoryUid?.ToString() ?? "")"
                                data-price="@item.SalePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-stock="@item.StockQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-priced-by-dozen="@(item.PricedByDozen ? "1" : "0")"
                                tabindex="0">
                                <td>@item.ProductCode</td>
                                <td>@item.ProductName</td>
                                <td class="text-end pos-item-card-price">@CardPrice(item.SalePrice)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.Products.Count == 0)
            {
                <div class="p-3 text-muted">No active products found.</div>
            }
        }
    </section>

    @if (Model.EnablePanelToggle)
    {
        <div id="posPanelSplitter"
             class="pos-panel-splitter"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize items and basket"
             title="Drag to resize"
             tabindex="0"></div>
    }

    <section class="pos-sale-panel pos-sale-panel--basket">
        <div class="pos-sale-panel-header">
            <h2 class="pos-sale-panel-title" id="basketPanelTitle">Sale = @Model.TodaySaleAmount.ToString("0.##") - (Quantity 0)</h2>
            <div class="pos-sale-toolbar">
                <button type="button" id="btnPrintReceipt" class="btn btn-outline-secondary btn-sm d-none" hidden>
                    <i class="bi bi-printer" aria-hidden="true"></i> Print Receipt
                </button>
                <button type="button" id="btnPay" class="btn btn-success btn-sm">
                    <i class="bi bi-cash-coin" aria-hidden="true"></i> Pay
                </button>
                <button type="button" id="btnClearBasket" class="btn btn-outline-danger btn-sm" title="Clear basket">
                    <i class="bi bi-trash" aria-hidden="true"></i> Clear
                </button>
            </div>
        </div>
        <div class="table-responsive pos-sale-table-wrap">
            <table class="table table-sm align-middle mb-0" id="basketTable">
                <thead>
                    <tr>
                        <th>Item</th>
                        @if (!Model.EnablePanelToggle)
                        {
                            <th class="text-end">Price</th>
                        }
                        <th class="text-center">Qty</th>
                        <th class="text-end">Line</th>
                        <th class="text-center" style="width:3rem;"></th>
                    </tr>
                </thead>
                <tbody id="basketBody">
                    <tr id="basketEmptyRow">
                        <td colspan="@(Model.EnablePanelToggle ? 4 : 5)" class="text-muted text-center py-4">Basket is empty.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="pos-sale-totals">
            <div class="pos-sale-total-row">
                <span>Total Amount</span>
                <strong id="basketTotal">0.00</strong>
            </div>
            <div class="pos-sale-total-row pos-sale-discount-row">
                <label for="basketDiscount">Discount</label>
                <input type="number"
                       id="basketDiscount"
                       class="form-control form-control-sm pos-sale-discount-input"
                       min="0"
                       step="0.01"
                       value="0.00"
                       inputmode="decimal" />
            </div>
            <div class="pos-sale-total-row pos-sale-net-row">
                <span>Net Amount</span>
                <strong id="basketNet">0.00</strong>
            </div>
            @if (string.Equals(Model.Mode, "Cash", StringComparison.OrdinalIgnoreCase))
            {
                <div class="pos-sale-total-row pos-sale-tender-row">
                    <label for="basketCustomerGiven">Customer Given</label>
                    <input type="number"
                           id="basketCustomerGiven"
                           class="form-control form-control-sm pos-sale-discount-input"
                           min="0"
                           step="0.01"
                           value=""
                           placeholder="0.00"
                           inputmode="decimal" />
                </div>
                <div class="pos-sale-total-row pos-sale-change-row">
                    <span>Change</span>
                    <strong id="basketChange">0.00</strong>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
<script>
(function () {
    const posMode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Mode));
    const interface2Basket = @(Model.EnablePanelToggle ? "true" : "false");
    const payUrl = '@Url.Action("Pay", "POS")';
    const antiforgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    const basket = new Map();
    let selectedUid = null;
    let lastReceipt = null;

    const productsTable = document.getElementById('productsTable');
    const cardLayout = productsTable?.classList.contains('pos-product-cards') === true;
    const basketBody = document.getElementById('basketBody');
    const basketEmptyRow = document.getElementById('basketEmptyRow');
    const basketPanelTitle = document.getElementById('basketPanelTitle');
    const basketTotalEl = document.getElementById('basketTotal');
    const basketNetEl = document.getElementById('basketNet');
    const basketDiscountEl = document.getElementById('basketDiscount');
    const basketCustomerGivenEl = document.getElementById('basketCustomerGiven');
    const basketChangeEl = document.getElementById('basketChange');
    const btnClear = document.getElementById('btnClearBasket');
    let lastAddedStock = null;
    let todaySaleAmount = @Model.TodaySaleAmount.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const btnPrint = document.getElementById('btnPrintReceipt');
    const btnPay = document.getElementById('btnPay');
    const searchInput = document.getElementById('productSearch');
    const categorySelect = document.getElementById('posCategorySelect');
    const categoryToolbar = document.getElementById('posCategoryToolbar');
    const alertBox = document.getElementById('posAlert');
    const posSaleLayout = document.getElementById('posSaleLayout');
    const posPanelSplitter = document.getElementById('posPanelSplitter');
    let activeCategoryUid = '';

    if (posSaleLayout && posPanelSplitter) {
        const barcodeOnlyLayout = posSaleLayout.classList.contains('pos-sale-layout--barcode-only');
        const splitStorageKey = barcodeOnlyLayout ? 'pos.barcode.itemsPercent' : 'pos.interface2.itemsPercent';
        const defaultItemsPercent = barcodeOnlyLayout ? 32 : 80;
        const minPercent = 15;
        const maxPercent = 85;

        function applySplit(itemsPercent) {
            const pct = Math.min(maxPercent, Math.max(minPercent, Number(itemsPercent) || defaultItemsPercent));
            posSaleLayout.style.setProperty('--pos-items-pct', pct + '%');
            posSaleLayout.style.setProperty('--pos-basket-pct', (100 - pct) + '%');
            posPanelSplitter.setAttribute('aria-valuenow', String(Math.round(pct)));
            return pct;
        }

        try {
            applySplit(localStorage.getItem(splitStorageKey) || defaultItemsPercent);
        } catch {
            applySplit(defaultItemsPercent);
        }

        posPanelSplitter.setAttribute('aria-valuemin', String(minPercent));
        posPanelSplitter.setAttribute('aria-valuemax', String(maxPercent));

        let dragging = false;

        function splitFromClientX(clientX) {
            const rect = posSaleLayout.getBoundingClientRect();
            if (rect.width <= 0) return;
            const x = clientX - rect.left;
            applySplit((x / rect.width) * 100);
        }

        function onPointerMove(e) {
            if (!dragging) return;
            splitFromClientX(e.clientX);
        }

        function endDrag() {
            if (!dragging) return;
            dragging = false;
            posSaleLayout.classList.remove('pos-sale-layout--resizing');
            document.body.classList.remove('pos-panel-splitter-active');
            window.removeEventListener('pointermove', onPointerMove);
            window.removeEventListener('pointerup', endDrag);
            window.removeEventListener('pointercancel', endDrag);
            const raw = getComputedStyle(posSaleLayout).getPropertyValue('--pos-items-pct').trim().replace('%', '');
            try {
                localStorage.setItem(splitStorageKey, String(Math.round(Number(raw) || defaultItemsPercent)));
            } catch { /* ignore */ }
        }

        posPanelSplitter.addEventListener('pointerdown', function (e) {
            if (e.button !== 0) return;
            e.preventDefault();
            dragging = true;
            posSaleLayout.classList.add('pos-sale-layout--resizing');
            document.body.classList.add('pos-panel-splitter-active');
            posPanelSplitter.setPointerCapture?.(e.pointerId);
            window.addEventListener('pointermove', onPointerMove);
            window.addEventListener('pointerup', endDrag);
            window.addEventListener('pointercancel', endDrag);
            splitFromClientX(e.clientX);
        });

        posPanelSplitter.addEventListener('keydown', function (e) {
            const raw = getComputedStyle(posSaleLayout).getPropertyValue('--pos-items-pct').trim().replace('%', '');
            let pct = Number(raw) || defaultItemsPercent;
            if (e.key === 'ArrowLeft') pct -= 2;
            else if (e.key === 'ArrowRight') pct += 2;
            else if (e.key === 'Home') pct = minPercent;
            else if (e.key === 'End') pct = maxPercent;
            else return;
            e.preventDefault();
            const next = applySplit(pct);
            try { localStorage.setItem(splitStorageKey, String(Math.round(next))); } catch { /* ignore */ }
        });
    }

    function money(n) {
        return Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function parseDiscount() {
        const raw = Number(basketDiscountEl?.value);
        if (!Number.isFinite(raw) || raw < 0) return 0;
        return Math.round(raw * 100) / 100;
    }

    function parseCustomerGiven() {
        if (!basketCustomerGivenEl) return null;
        const rawText = (basketCustomerGivenEl.value || '').trim();
        if (!rawText) return null;
        const raw = Number(rawText);
        if (!Number.isFinite(raw) || raw < 0) return null;
        return Math.round(raw * 100) / 100;
    }

    function syncTotalsDisplay(total) {
        const discount = parseDiscount();
        const capped = Math.min(discount, total);
        if (basketDiscountEl && discount !== capped) {
            basketDiscountEl.value = capped.toFixed(2);
        }
        const net = Math.max(0, Math.round((total - capped) * 100) / 100);
        if (basketTotalEl) basketTotalEl.textContent = money(total);
        if (basketNetEl) basketNetEl.textContent = money(net);

        const given = parseCustomerGiven();
        let change = 0;
        if (given != null && given >= net) {
            change = Math.round((given - net) * 100) / 100;
        }
        if (basketChangeEl) {
            basketChangeEl.textContent = money(change);
            basketChangeEl.classList.toggle('text-danger', given != null && given < net);
        }
        return { total: total, discount: capped, net: net, customerGiven: given, change: change };
    }

    function applyProductFilters() {
        const q = (searchInput?.value || '').trim().toLowerCase();
        productsTable.querySelectorAll('.pos-product-row').forEach(function (row) {
            const text = (
                (row.getAttribute('data-code') || '') + ' ' +
                (row.getAttribute('data-name') || '') + ' ' +
                (row.getAttribute('data-barcode') || '')
            ).toLowerCase();
            const rowCategory = row.getAttribute('data-category-uid') || '';
            const matchesSearch = !q || text.indexOf(q) !== -1;
            const matchesCategory = !activeCategoryUid || rowCategory === activeCategoryUid;
            row.style.display = matchesSearch && matchesCategory ? '' : 'none';
        });
    }

    function findProductRowByScanCode(rawCode, allowNameSearch) {
        const code = (rawCode || '').trim();
        if (!code) return null;
        const lower = code.toLowerCase();
        const rows = Array.from(productsTable.querySelectorAll('.pos-product-row'));
        // Prefer product code (test barcodes print codes), then barcode field.
        let match = rows.find(function (row) {
            return (row.getAttribute('data-code') || '').trim().toLowerCase() === lower;
        });
        if (match) return match;
        match = rows.find(function (row) {
            return (row.getAttribute('data-barcode') || '').trim().toLowerCase() === lower;
        });
        if (match) return match;
        if (allowNameSearch) {
            match = rows.find(function (row) {
                return (row.getAttribute('data-name') || '').trim().toLowerCase() === lower;
            });
            if (match) return match;
            match = rows.find(function (row) {
                return (row.getAttribute('data-name') || '').toLowerCase().indexOf(lower) !== -1;
            });
        }
        return match || null;
    }

    function addProductFromBarcode(rawCode, allowNameSearch) {
        const row = findProductRowByScanCode(rawCode, !!allowNameSearch);
        if (!row) {
            showAlert('warning', 'No product found for "' + (rawCode || '').trim() + '".');
            return false;
        }
        selectRow(row);
        addSelected();
        showAlert('success', 'Added: ' + (row.getAttribute('data-name') || rawCode));
        return true;
    }

    function showAlert(type, message) {
        alertBox.className = 'alert alert-' + type;
        alertBox.textContent = message;
        alertBox.classList.remove('d-none');
    }

    function hideAlert() {
        alertBox.classList.add('d-none');
    }

    function getSelectedRow() {
        if (selectedUid == null) return null;
        return productsTable.querySelector('.pos-product-row[data-uid="' + selectedUid + '"]');
    }

    function selectRow(row) {
        productsTable.querySelectorAll('.pos-product-row.selected').forEach(r => r.classList.remove('selected'));
        if (!row) {
            selectedUid = null;
            return;
        }
        row.classList.add('selected');
        selectedUid = row.getAttribute('data-uid');
    }

    productsTable.addEventListener('click', function (e) {
        const row = e.target.closest('.pos-product-row');
        if (!row) return;
        selectRow(row);
        if (cardLayout) addSelected();
    });

    if (!cardLayout) {
        productsTable.addEventListener('dblclick', function (e) {
            const row = e.target.closest('.pos-product-row');
            if (!row) return;
            selectRow(row);
            addSelected();
        });
    }

    function formatStockQty(n) {
        const v = Number(n);
        if (!Number.isFinite(v)) return '0';
        if (Number.isInteger(v)) return String(v);
        return String(Math.round(v * 1000) / 1000);
    }

    function formatTodaySale(n) {
        const v = Number(n);
        if (!Number.isFinite(v)) return '0';
        if (Number.isInteger(v)) return String(v);
        return String(Math.round(v * 100) / 100);
    }

    function basketQuantityTotal() {
        let total = 0;
        basket.forEach(function (item) {
            const q = Number(item.qty);
            if (Number.isFinite(q)) total += q;
        });
        return total;
    }

    function updateBasketTitle(availableQty) {
        if (!basketPanelTitle) return;
        if (availableQty != null && Number.isFinite(Number(availableQty))) {
            lastAddedStock = Number(availableQty);
        }
        if (basket.size === 0) {
            lastAddedStock = null;
        }
        basketPanelTitle.textContent =
            'Sale = ' + formatTodaySale(todaySaleAmount) +
            ' - (Quantity ' + formatStockQty(basketQuantityTotal()) + ')';
    }

    function isPricedByDozen(rowOrItem) {
        if (!rowOrItem) return false;
        if (typeof rowOrItem.getAttribute === 'function') {
            return rowOrItem.getAttribute('data-priced-by-dozen') === '1';
        }
        return rowOrItem.pricedByDozen === true;
    }

    function addSelected() {
        const row = getSelectedRow();
        if (!row) return;
        const uid = row.getAttribute('data-uid');
        const code = row.getAttribute('data-code');
        const name = row.getAttribute('data-name');
        const price = parseFloat(row.getAttribute('data-price'));
        const stockRaw = parseFloat(row.getAttribute('data-stock'));
        const stock = Number.isFinite(stockRaw) ? stockRaw : 0;
        const pricedByDozen = isPricedByDozen(row);
        // Dozen-priced items: qty is pieces (12 eggs), sale price is per dozen.
        const stepQty = pricedByDozen ? 12 : 1;
        if (basket.has(uid)) {
            const existing = basket.get(uid);
            existing.qty += stepQty;
            existing.stock = stock;
            existing.pricedByDozen = pricedByDozen;
        } else {
            basket.set(uid, { uid, code, name, price, qty: stepQty, stock, pricedByDozen: pricedByDozen });
        }
        hideAlert();
        updateBasketTitle(stock);
        renderBasket();
    }

    btnClear.addEventListener('click', function () {
        if (basket.size === 0) return;
        if (!confirm('Clear all items from the basket?')) return;
        basket.clear();
        updateBasketTitle(null);
        renderBasket();
    });

    searchInput.addEventListener('input', applyProductFilters);

    function syncCategoryControls(uid) {
        activeCategoryUid = (uid || '').trim();
        if (categorySelect) {
            categorySelect.value = activeCategoryUid;
        }
        if (categoryToolbar) {
            categoryToolbar.querySelectorAll('.pos-category-btn').forEach(function (b) {
                const match = (b.getAttribute('data-category-uid') || '') === activeCategoryUid;
                b.classList.toggle('active', match);
            });
        }
        applyProductFilters();
    }

    if (categorySelect) {
        categorySelect.addEventListener('change', function () {
            syncCategoryControls(categorySelect.value || '');
        });
    }

    if (categoryToolbar) {
        categoryToolbar.addEventListener('click', function (e) {
            const btn = e.target.closest('.pos-category-btn');
            if (!btn) return;
            syncCategoryControls(btn.getAttribute('data-category-uid') || '');
        });
    }

    function roundQty(n) {
        return Math.round(n * 1000) / 1000;
    }

    function roundMoney(n) {
        return Math.round(n * 100) / 100;
    }

    function formatQty(n) {
        const v = roundQty(Number(n) || 0);
        if (Number.isInteger(v)) return String(v);
        return String(v);
    }

    function parseQtyInput(raw) {
        const n = Number(String(raw || '').replace(',', '.').trim());
        if (!Number.isFinite(n) || n <= 0) return null;
        return roundQty(n);
    }

    function parseAmountInput(raw) {
        const n = Number(String(raw || '').replace(',', '.').trim());
        if (!Number.isFinite(n) || n <= 0) return null;
        return roundMoney(n);
    }

    function qtyFromAmount(amount, price, pricedByDozen) {
        if (!price || price <= 0) return null;
        if (pricedByDozen) {
            // Line money is dozen-price × dozen-count; piece qty = dozens × 12.
            return roundQty((amount / price) * 12);
        }
        return roundQty(amount / price);
    }

    function amountFromQty(qty, price, pricedByDozen) {
        if (pricedByDozen) {
            // Sale price is per dozen; qty is in pieces.
            return roundMoney(price * (qty / 12));
        }
        return roundMoney(qty * price);
    }

    function payQuantity(item) {
        if (item.pricedByDozen) {
            return roundQty(item.qty / 12);
        }
        return item.qty;
    }

    basketBody.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;
        const uid = btn.getAttribute('data-uid');
        const action = btn.getAttribute('data-action');
        const item = basket.get(uid);
        if (!item) return;

        if (action === 'inc') {
            item.qty = roundQty(item.qty + 1);
        } else if (action === 'dec') {
            item.qty = roundQty(item.qty - 1);
            if (item.qty <= 0) basket.delete(uid);
        } else if (action === 'remove') {
            basket.delete(uid);
        }
        renderBasket();
    });

    basketBody.addEventListener('change', function (e) {
        const qtyInput = e.target.closest('.pos-qty-input');
        const lineInput = e.target.closest('.pos-line-input');
        const priceInput = e.target.closest('.pos-price-input');
        if (!qtyInput && !lineInput && !priceInput) return;

        const input = qtyInput || lineInput || priceInput;
        const uid = input.getAttribute('data-uid');
        const item = basket.get(uid);
        if (!item) return;

        if (priceInput) {
            const price = parseAmountInput(priceInput.value);
            if (price == null) {
                priceInput.value = money(item.price);
                return;
            }
            item.price = price;
        } else if (lineInput) {
            // Enter Line (money) → qty = line ÷ unit price
            const line = parseAmountInput(lineInput.value);
            if (line == null) {
                basket.delete(uid);
            } else {
                const qty = qtyFromAmount(line, item.price, item.pricedByDozen);
                if (qty == null || qty <= 0) {
                    basket.delete(uid);
                } else {
                    item.qty = qty;
                }
            }
        } else {
            const qty = parseQtyInput(qtyInput.value);
            if (qty == null) {
                basket.delete(uid);
            } else {
                item.qty = qty;
            }
        }
        renderBasket();
    });

    basketBody.addEventListener('keydown', function (e) {
        const input = e.target.closest('.pos-qty-input, .pos-line-input, .pos-price-input');
        if (!input) return;
        if (e.key === 'Enter') {
            e.preventDefault();
            input.blur();
        }
    });

    basketBody.addEventListener('focusin', function (e) {
        const input = e.target.closest('.pos-qty-input, .pos-line-input, .pos-price-input');
        if (!input) return;
        requestAnimationFrame(function () { input.select(); });
    });

    function basketItems() {
        return Array.from(basket.values());
    }

    function basketTotal() {
        return basketItems().reduce((sum, item) => sum + amountFromQty(item.qty, item.price, item.pricedByDozen), 0);
    }

    function renderBasket() {
        basketBody.querySelectorAll('tr:not(#basketEmptyRow)').forEach(r => r.remove());

        if (basket.size === 0) {
            basketEmptyRow.style.display = '';
            updateBasketTitle(null);
            if (basketDiscountEl) basketDiscountEl.value = '0.00';
            if (basketCustomerGivenEl) basketCustomerGivenEl.value = '';
            syncTotalsDisplay(0);
            return;
        }

        basketEmptyRow.style.display = 'none';
        let total = 0;

        basket.forEach(function (item) {
            const line = amountFromQty(item.qty, item.price, item.pricedByDozen);
            total += line;
            const priceInput =
                '<input type="number" class="form-control form-control-sm pos-price-input" data-uid="' + item.uid +
                '" min="0.01" step="0.01" inputmode="decimal" value="' + Number(item.price).toFixed(2) +
                '" title="Edit unit price" />';
            const tr = document.createElement('tr');
            if (interface2Basket) {
                const unitPriceText = Number(item.price) === Math.trunc(Number(item.price))
                    ? String(Math.trunc(Number(item.price)))
                    : Number(item.price).toFixed(2);
                tr.innerHTML =
                    '<td><div class="fw-semibold">' + escapeHtml(item.name) + ' - ' + unitPriceText + '</div></td>' +
                    '<td class="text-center">' +
                    '<div class="pos-qty-controls">' +
                    '<button type="button" class="btn btn-sm btn-outline-secondary" data-action="dec" data-uid="' + item.uid + '" title="Decrease"><i class="bi bi-dash-lg"></i></button>' +
                    '<input type="number" class="form-control form-control-sm pos-qty-input" data-uid="' + item.uid +
                    '" min="0.001" step="0.001" inputmode="decimal" value="' + formatQty(item.qty) + '" title="Enter quantity e.g. 0.5 or 0.25" />' +
                    '<button type="button" class="btn btn-sm btn-outline-secondary" data-action="inc" data-uid="' + item.uid + '" title="Increase"><i class="bi bi-plus-lg"></i></button>' +
                    '</div></td>' +
                    '<td class="text-end">' +
                    '<input type="number" class="form-control form-control-sm pos-line-input" data-uid="' + item.uid +
                    '" min="0.01" step="0.01" inputmode="decimal" value="' + line.toFixed(2) +
                    '" title="Enter line total — qty = line ÷ price (e.g. 120 at 240 = 0.5)" />' +
                    '</td>' +
                    '<td class="text-center">' +
                    '<button type="button" class="btn btn-sm btn-outline-danger" data-action="remove" data-uid="' + item.uid + '" title="Remove"><i class="bi bi-x-lg"></i></button>' +
                    '</td>';
            } else {
                tr.innerHTML =
                    '<td><div class="fw-semibold">' + escapeHtml(item.name) + '</div>' +
                    '<div class="small text-muted">' + escapeHtml(item.code) + '</div></td>' +
                    '<td class="text-end">' + priceInput + '</td>' +
                    '<td class="text-center">' +
                    '<div class="pos-qty-controls">' +
                    '<button type="button" class="btn btn-sm btn-outline-secondary" data-action="dec" data-uid="' + item.uid + '" title="Decrease"><i class="bi bi-dash-lg"></i></button>' +
                    '<input type="number" class="form-control form-control-sm pos-qty-input" data-uid="' + item.uid +
                    '" min="0.001" step="0.001" inputmode="decimal" value="' + formatQty(item.qty) + '" title="Enter quantity e.g. 0.5 or 0.25" />' +
                    '<button type="button" class="btn btn-sm btn-outline-secondary" data-action="inc" data-uid="' + item.uid + '" title="Increase"><i class="bi bi-plus-lg"></i></button>' +
                    '</div></td>' +
                    '<td class="text-end">' +
                    '<input type="number" class="form-control form-control-sm pos-line-input" data-uid="' + item.uid +
                    '" min="0.01" step="0.01" inputmode="decimal" value="' + line.toFixed(2) +
                    '" title="Enter line total — qty = line ÷ price (e.g. 120 at 240 = 0.5)" />' +
                    '</td>' +
                    '<td class="text-center">' +
                    '<button type="button" class="btn btn-sm btn-outline-danger" data-action="remove" data-uid="' + item.uid + '" title="Remove"><i class="bi bi-x-lg"></i></button>' +
                    '</td>';
            }
            basketBody.appendChild(tr);
        });

        syncTotalsDisplay(total);
        updateBasketTitle(lastAddedStock);
    }

    if (basketDiscountEl) {
        basketDiscountEl.addEventListener('focus', function () {
            requestAnimationFrame(function () { basketDiscountEl.select(); });
        });
        basketDiscountEl.addEventListener('mouseup', function (e) { e.preventDefault(); });
        basketDiscountEl.addEventListener('input', function () {
            syncTotalsDisplay(basketTotal());
        });
        basketDiscountEl.addEventListener('blur', function () {
            const totals = syncTotalsDisplay(basketTotal());
            basketDiscountEl.value = totals.discount.toFixed(2);
        });
    }

    if (basketCustomerGivenEl) {
        basketCustomerGivenEl.addEventListener('focus', function () {
            requestAnimationFrame(function () { basketCustomerGivenEl.select(); });
        });
        basketCustomerGivenEl.addEventListener('mouseup', function (e) { e.preventDefault(); });
        basketCustomerGivenEl.addEventListener('input', function () {
            syncTotalsDisplay(basketTotal());
        });
        basketCustomerGivenEl.addEventListener('blur', function () {
            const given = parseCustomerGiven();
            if (given == null) {
                basketCustomerGivenEl.value = '';
            } else {
                basketCustomerGivenEl.value = given.toFixed(2);
            }
            syncTotalsDisplay(basketTotal());
        });
    }

    function formatReceiptDateTime(d) {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const day = d.getDate();
        const month = months[d.getMonth()];
        const year = d.getFullYear();
        const hh = String(d.getHours()).padStart(2, '0');
        const mm = String(d.getMinutes()).padStart(2, '0');
        const ss = String(d.getSeconds()).padStart(2, '0');
        return {
            dateText: day + '-' + month + '-' + year,
            timeText: hh + ':' + mm + ':' + ss
        };
    }

    function buildReceiptHtml(data) {
        const rows = data.items.map(function (item) {
            const lineAmt = amountFromQty(item.qty, item.price, item.pricedByDozen);
            return '<tr><td>' + escapeHtml(item.name) + '</td><td style="text-align:center">' + item.qty +
                '</td><td style="text-align:right">' + money(item.price) +
                '</td><td style="text-align:right">' + money(lineAmt) + '</td></tr>';
        }).join('');

        const printed = formatReceiptDateTime(new Date());

        return '<!DOCTYPE html><html><head><title>Customer Bil ' + escapeHtml(data.invoiceNo || '') + '</title>' +
            '<style>body{font-family:Segoe UI,Arial,sans-serif;padding:16px;color:#111;text-align:center}' +
            '.shop-name{font-size:20px;font-weight:700;margin:0 0 4px;letter-spacing:0.02em}' +
            '.shop-address{font-size:12px;margin:0 0 2px;color:#222;font-weight:600}' +
            '.shop-phone{font-size:13px;margin:0 0 10px;color:#111}' +
            '.bill-title{font-size:16px;font-weight:700;margin:0 0 8px;text-align:center}' +
            '.meta{font-size:12px;color:#444;text-align:left;margin:2px 0}' +
            '.meta-center{font-size:12px;color:#444;text-align:center;margin:2px 0 8px}' +
            'table{width:100%;border-collapse:collapse;margin-top:12px;text-align:left}' +
            'th,td{border-bottom:1px solid #ddd;padding:6px 4px;font-size:13px}' +
            'th{text-align:left}.totals{margin-top:12px;font-size:14px;text-align:right}' +
            '.totals div{margin:2px 0}.totals .net{font-size:16px;font-weight:700;margin-top:6px}' +
            '.footer{margin-top:18px;padding-top:10px;border-top:1px dashed #999;font-size:11px;color:#333;text-align:center;line-height:1.45}' +
            '</style></head><body>' +
            '<div class="shop-name">THE FORM SHOP</div>' +
            '<div class="shop-address">SHOP NO 02 SHOPPING GALLERY P-2 BA</div>' +
            '<div class="shop-phone">0311-8858888</div>' +
            '<div class="bill-title">Customer Bil</div>' +
            (data.invoiceNo ? '<div class="meta">Invoice: ' + escapeHtml(data.invoiceNo) + '</div>' : '') +
            '<div class="meta-center">Date: ' + printed.dateText + ' &nbsp;&nbsp; Time: ' + printed.timeText + '</div>' +
            '<table><thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Amount</th></tr></thead><tbody>' +
            rows + '</tbody></table>' +
            '<div class="totals">' +
            '<div>Total Amount: ' + money(data.subTotal != null ? data.subTotal : data.total) + '</div>' +
            ((Number(data.discount) || 0) > 0 ? '<div>Discount: ' + money(data.discount) + '</div>' : '') +
            '<div class="net">Net Amount: ' + money(data.total) + '</div>' +
            '</div>' +
            '<div class="footer">Software By: Coditium Solutions<br>Web: www.coditium.com &nbsp; Mob: 0301-8882992</div>' +
            '<script>window.onload=function(){window.print();}<\\/script></body></html>';
    }

    function printReceipt(data) {
        if (!data || !data.items || data.items.length === 0) {
            showAlert('warning', 'Nothing to print.');
            return;
        }
        const w = window.open('', '_blank', 'width=420,height=640');
        if (!w) {
            showAlert('warning', 'Pop-up blocked. Allow pop-ups to print the receipt.');
            return;
        }
        w.document.open();
        w.document.write(buildReceiptHtml(data));
        w.document.close();
    }

    function showPrintReceiptButton() {
        if (!btnPrint) return;
        btnPrint.classList.remove('d-none');
        btnPrint.hidden = false;
    }

    btnPrint.addEventListener('click', function () {
        if (!lastReceipt) {
            showAlert('warning', 'Pay the invoice first, then print the receipt.');
            return;
        }
        printReceipt(lastReceipt);
    });

    btnPay.addEventListener('click', async function () {
        const items = basketItems();
        if (items.length === 0) {
            showAlert('warning', 'Add items to the basket before paying.');
            return;
        }

        const totals = syncTotalsDisplay(basketTotal());
        if (totals.discount > totals.total) {
            showAlert('warning', 'Discount cannot be greater than the total amount.');
            return;
        }

        if (basketCustomerGivenEl && totals.customerGiven != null && totals.customerGiven < totals.net) {
            showAlert('warning', 'Customer given amount must be at least the net amount.');
            basketCustomerGivenEl.focus();
            return;
        }

        var confirmMsg = 'Confirm payment and save this sale?\nTotal: ' + money(totals.total) +
            '\nDiscount: ' + money(totals.discount) +
            '\nNet Amount: ' + money(totals.net);
        if (totals.customerGiven != null) {
            confirmMsg += '\nCustomer Given: ' + money(totals.customerGiven) +
                '\nChange: ' + money(totals.change);
        }
        if (!confirm(confirmMsg)) return;

        btnPay.disabled = true;
        hideAlert();

        try {
            const response = await fetch(payUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiforgery
                },
                body: JSON.stringify({
                    mode: posMode,
                    clientTransactionId: (window.crypto && crypto.randomUUID)
                        ? crypto.randomUUID()
                        : null,
                    discountAmount: totals.discount,
                    customerGivenAmount: totals.customerGiven,
                    items: items.map(function (item) {
                        return {
                            productUid: parseInt(item.uid, 10),
                            // Dozen-priced: qty in UI is pieces; bill/stock uses dozen count × unit price.
                            quantity: payQuantity(item),
                            unitPrice: item.price
                        };
                    })
                })
            });

            const raw = await response.text();
            let result = null;
            try {
                result = raw ? JSON.parse(raw) : null;
            } catch (parseErr) {
                showAlert('danger', 'Payment failed: ' + (raw || response.statusText || 'unexpected server response').toString().slice(0, 240));
                return;
            }
            if (!response.ok || !result || !result.success) {
                showAlert('danger', (result && result.message) || 'Unable to save the sale.');
                return;
            }

            lastReceipt = {
                items: items.map(function (x) { return { ...x }; }),
                subTotal: totals.total,
                discount: totals.discount,
                total: result.netAmount,
                invoiceNo: result.invoiceNo,
                invoiceDate: result.invoiceDate ? new Date(result.invoiceDate).toLocaleString() : new Date().toLocaleString()
            };

            basket.clear();
            const paidNet = Number(result.netAmount);
            // Sale total is Walk-in / Cash only.
            if (Number.isFinite(paidNet) && String(posMode || '').toLowerCase() === 'cash') {
                todaySaleAmount += paidNet;
            }
            updateBasketTitle(null);
            renderBasket();
            showPrintReceiptButton();
            showAlert('success', result.message + ' You can print the receipt now.');
        } catch (err) {
            showAlert('danger', 'Payment failed. Please try again.' + (err && err.message ? ' (' + err.message + ')' : ''));
        } finally {
            btnPay.disabled = false;
        }
    });

    function escapeHtml(s) {
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    const barcodeScanInput = document.getElementById('posBarcodeScan');
    if (barcodeScanInput) {
        function focusBarcodeScan() {
            requestAnimationFrame(function () {
                barcodeScanInput.focus();
                barcodeScanInput.select();
            });
        }

        barcodeScanInput.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter') return;
            e.preventDefault();
            const code = (barcodeScanInput.value || '').trim();
            barcodeScanInput.value = '';
            if (!code) {
                focusBarcodeScan();
                return;
            }
            addProductFromBarcode(code, false);
            focusBarcodeScan();
        });

        document.getElementById('posSaleLayout')?.addEventListener('mouseup', function (e) {
            if (e.target.closest('input, select, textarea, button, a')) return;
            focusBarcodeScan();
        });

        focusBarcodeScan();
    }
})();
</script>
}
