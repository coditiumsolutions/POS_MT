@model DeliveryHandoverPageViewModel
@{
    Layout = null;
    ViewData["Title"] = $"Delivery list {Model.SupplyDate:dd-MMM-yyyy}";
    var areaGroups = Model.CustomersByArea.ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --ink: #0f172a;
            --muted: #64748b;
            --line: #cbd5e1;
        }

        * { box-sizing: border-box; }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            margin: 0;
            background: #e2e8f0;
        }

        .toolbar {
            width: 210mm;
            margin: 12px auto 0;
            display: flex;
            gap: 0.5rem;
            justify-content: flex-end;
        }

        .toolbar button {
            border: 1px solid #94a3b8;
            background: #0f172a;
            color: #fff;
            border-radius: 4px;
            padding: 0.4rem 0.9rem;
            font-size: 0.875rem;
            cursor: pointer;
        }

        .toolbar button.secondary {
            background: #fff;
            color: #0f172a;
        }

        .sheet {
            width: 210mm;
            min-height: 297mm;
            margin: 12px auto;
            padding: 12mm 12mm 14mm;
            background: #fff;
            box-shadow: 0 1px 8px rgba(15, 23, 42, 0.12);
        }

        h1 {
            margin: 0;
            font-size: 1.35rem;
        }

        .sub {
            margin-top: 0.2rem;
            color: var(--muted);
            font-size: 0.85rem;
        }

        .header {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            border-bottom: 2px solid var(--ink);
            padding-bottom: 0.6rem;
            margin-bottom: 0.75rem;
        }

        .meta {
            text-align: right;
            font-size: 0.85rem;
        }

        .meta strong { display: block; font-size: 1rem; }

        .area-block {
            margin-top: 0.85rem;
            break-inside: avoid;
        }

        .area-block:first-of-type { margin-top: 0; }

        .area-title {
            margin: 0 0 0.35rem;
            padding: 0.3rem 0.45rem;
            background: #0f172a;
            color: #fff;
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .area-meta {
            color: #cbd5e1;
            font-weight: 500;
            font-size: 0.75rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8rem;
        }

        th, td {
            border: 1px solid var(--line);
            padding: 0.18rem 0.35rem;
            vertical-align: middle;
            text-align: left;
            line-height: 1.25;
        }

        th {
            background: #f8fafc;
            font-size: 0.7rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            padding: 0.2rem 0.35rem;
        }

        .name { font-weight: 700; line-height: 1.2; }

        .muted {
            color: var(--muted);
            font-size: 0.72rem;
            line-height: 1.2;
        }

        .qty-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .qty-list li {
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
            line-height: 1.35;
        }

        .qty-list .item-name {
            font-weight: 600;
        }

        .qty-list .item-qty {
            font-variant-numeric: tabular-nums;
            font-weight: 700;
            white-space: nowrap;
            min-width: 2.5rem;
            text-align: right;
        }

        .signoff {
            margin-top: 1.25rem;
            display: flex;
            justify-content: space-between;
            gap: 2rem;
            font-size: 0.85rem;
        }

        .signoff span {
            flex: 1;
            border-top: 1px solid var(--ink);
            padding-top: 0.35rem;
        }

        .empty {
            padding: 1rem 0;
            color: var(--muted);
        }

        @@page { size: A4 portrait; margin: 10mm; }

        @@media print {
            body { background: #fff; }
            .toolbar { display: none !important; }
            .sheet {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
            .area-block { break-inside: avoid; }
            tr { break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" class="secondary" onclick="window.close()">Close</button>
        <button type="button" onclick="window.print()">Print</button>
    </div>
    <div class="sheet">
        <div class="header">
            <div>
                <h1>Delivery list (Area wise)</h1>
                <div class="sub">@Model.ShopName · hand this sheet to the person delivering</div>
            </div>
            <div class="meta">
                <strong>@Model.SupplyDate.ToString("dd-MMM-yyyy")</strong>
                <div>
                    @(Model.SelectedOnly
                        ? "Selected customers"
                        : (!string.IsNullOrWhiteSpace(Model.AreaFilter) ? $"Area: {Model.AreaFilter}" : "All areas"))
                </div>
                <div class="muted">Printed @Model.PrintedAt.ToString("dd-MMM-yyyy HH:mm")</div>
            </div>
        </div>

        @if (Model.Customers.Count == 0)
        {
            <p class="empty">Nothing to deliver for this date.</p>
        }
        else
        {
            @foreach (var areaGroup in areaGroups)
            {
                <div class="area-block">
                    <div class="area-title">
                        Area: @areaGroup.Key
                        <span class="area-meta">· @areaGroup.Count() customer@(areaGroup.Count() == 1 ? "" : "s")</span>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th style="width:45%">Customer</th>
                                <th style="width:55%">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var customer in areaGroup)
                        {
                            <tr>
                                <td>
                                    <div class="name">@customer.CustomerName</div>
                                    <div class="muted">@customer.CustomerCode@(string.IsNullOrWhiteSpace(customer.Phone) ? "" : " · " + customer.Phone)</div>
                                </td>
                                <td>
                                    @if (customer.Items.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        <ul class="qty-list">
                                        @foreach (var item in customer.Items)
                                        {
                                            var itemName = string.IsNullOrWhiteSpace(item.ProductName) ? item.ProductCode : item.ProductName;
                                            <li>
                                                <span class="item-name">@itemName</span>
                                                <span class="item-qty">@item.Quantity.ToString("0.###")</span>
                                            </li>
                                        }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <p class="muted" style="margin-top:0.6rem">
                @areaGroups.Count area@(areaGroups.Count == 1 ? "" : "s") ·
                @Model.Customers.Count customer@(Model.Customers.Count == 1 ? "" : "s").
            </p>
        }

        <div class="signoff">
            <span>Handed to</span>
            <span>Received by</span>
        </div>
    </div>
</body>
</html>
