@model DeliveryHandoverPageViewModel
@{
    Layout = null;
    ViewData["Title"] = $"Delivery list {Model.SupplyDate:dd-MMM-yyyy}";
    var areaGroups = Model.CustomersByArea.ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            --ink: #0f172a;
            --muted: #64748b;
            --line: #cbd5e1;
            --paper: 72mm;
        }

        * { box-sizing: border-box; }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            margin: 0;
            background: #e2e8f0;
        }

        .toolbar {
            width: var(--paper);
            margin: 8px auto 0;
            display: flex;
            gap: 0.35rem;
            justify-content: flex-end;
        }

        .toolbar button {
            border: 1px solid #94a3b8;
            background: #0f172a;
            color: #fff;
            border-radius: 4px;
            padding: 0.3rem 0.65rem;
            font-size: 0.75rem;
            cursor: pointer;
        }

        .toolbar button.secondary {
            background: #fff;
            color: #0f172a;
        }

        .sheet {
            width: var(--paper);
            margin: 8px auto;
            padding: 3mm 2.5mm 4mm;
            background: #fff;
            box-shadow: 0 1px 8px rgba(15, 23, 42, 0.12);
        }

        h1 {
            margin: 0;
            font-size: 0.95rem;
            line-height: 1.2;
        }

        .sub {
            margin-top: 0.15rem;
            color: var(--muted);
            font-size: 0.65rem;
            line-height: 1.25;
        }

        .header {
            display: block;
            border-bottom: 1.5px solid var(--ink);
            padding-bottom: 0.4rem;
            margin-bottom: 0.45rem;
        }

        .meta {
            margin-top: 0.35rem;
            text-align: left;
            font-size: 0.68rem;
            line-height: 1.3;
        }

        .meta strong {
            display: block;
            font-size: 0.8rem;
        }

        .area-block {
            margin-top: 0.55rem;
            break-inside: avoid;
        }

        .area-block:first-of-type { margin-top: 0; }

        .area-title {
            margin: 0 0 0.25rem;
            padding: 0.2rem 0.3rem;
            background: #0f172a;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            line-height: 1.25;
        }

        .area-meta {
            color: #cbd5e1;
            font-weight: 500;
            font-size: 0.62rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.68rem;
            table-layout: fixed;
        }

        th, td {
            border: 1px solid var(--line);
            padding: 0.18rem 0.22rem;
            vertical-align: middle;
            text-align: left;
            line-height: 1.2;
            word-wrap: break-word;
            overflow-wrap: anywhere;
        }

        th {
            background: #f8fafc;
            font-size: 0.58rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
            padding: 0.15rem 0.22rem;
        }

        th.qty-col,
        td.qty-col {
            text-align: center;
            vertical-align: middle;
        }

        .name {
            font-weight: 700;
            line-height: 1.15;
            font-size: 0.7rem;
        }

        .muted {
            color: var(--muted);
            font-size: 0.6rem;
            line-height: 1.15;
        }

        .qty-list {
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.1rem;
        }

        .qty-list .item-qty {
            font-variant-numeric: tabular-nums;
            font-weight: 800;
            white-space: nowrap;
            text-align: center;
            font-size: 1.15rem;
            line-height: 1.15;
        }

        .signoff {
            margin-top: 0.85rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            font-size: 0.68rem;
        }

        .signoff span {
            border-top: 1px solid var(--ink);
            padding-top: 0.25rem;
        }

        .empty {
            padding: 0.6rem 0;
            color: var(--muted);
            font-size: 0.72rem;
        }

        .summary {
            margin-top: 0.45rem;
            font-size: 0.6rem;
            color: var(--muted);
        }

        @@page {
            size: 80mm auto;
            margin: 2mm;
        }

        @@media print {
            body { background: #fff; }
            .toolbar { display: none !important; }
            .sheet {
                width: 100%;
                max-width: 76mm;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
            .area-block { break-inside: avoid; }
            tr { break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" class="secondary" onclick="window.close()">Close</button>
        <button type="button" onclick="window.print()">Print</button>
    </div>
    <div class="sheet">
        <div class="header">
            <div>
                <h1>Delivery list</h1>
                <div class="sub">@Model.ShopName · for delivery</div>
            </div>
            <div class="meta">
                <strong>@Model.SupplyDate.ToString("dd-MMM-yyyy")</strong>
                <div>
                    @(Model.SelectedOnly
                        ? "Selected customers"
                        : (!string.IsNullOrWhiteSpace(Model.AreaFilter) ? $"Area: {Model.AreaFilter}" : "All areas"))
                </div>
                <div class="muted">Printed @Model.PrintedAt.ToString("dd-MMM-yyyy HH:mm")</div>
            </div>
        </div>

        @if (Model.Customers.Count == 0)
        {
            <p class="empty">Nothing to deliver for this date.</p>
        }
        else
        {
            @foreach (var areaGroup in areaGroups)
            {
                <div class="area-block">
                    <div class="area-title">
                        Area: @areaGroup.Key
                        <span class="area-meta">· @areaGroup.Count() customer@(areaGroup.Count() == 1 ? "" : "s")</span>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th style="width:62%">Customer</th>
                                <th class="qty-col" style="width:38%">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var customer in areaGroup)
                        {
                            <tr>
                                <td>
                                    <div class="name">@customer.CustomerName</div>
                                    <div class="muted">@customer.CustomerCode@(string.IsNullOrWhiteSpace(customer.Phone) ? "" : " · " + customer.Phone)</div>
                                </td>
                                <td class="qty-col">
                                    @if (customer.Items.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                    else
                                    {
                                        <ul class="qty-list">
                                        @foreach (var item in customer.Items)
                                        {
                                            <li><span class="item-qty">@item.Quantity.ToString("0.###")</span></li>
                                        }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            <p class="summary">
                @areaGroups.Count area@(areaGroups.Count == 1 ? "" : "s") ·
                @Model.Customers.Count customer@(Model.Customers.Count == 1 ? "" : "s").
            </p>
        }

        <div class="signoff">
            <span>Handed to</span>
            <span>Received by</span>
        </div>
    </div>
</body>
</html>
