@{
    ViewData["Title"] = "POS";
}
<div class="pos-mode-page">
    <header class="pos-mode-hero">
        <h1 class="pos-mode-heading">Select a sales mode</h1>
    </header>

    <div class="pos-mode-grid">
        <a class="pos-mode-card pos-mode-card--cash"
           asp-controller="POS"
           asp-action="Cash"
           title="Cash POS">
            <span class="pos-mode-card__accent" aria-hidden="true"></span>
            <span class="pos-mode-card__icon" aria-hidden="true">
                <i class="bi bi-cash-coin"></i>
            </span>
            <span class="pos-mode-card__body">
                <span class="pos-mode-card__badge">Instant payment</span>
                <span class="pos-mode-card__title">Cash POS</span>
                <span class="pos-mode-card__desc">
                    Walk-in checkout with immediate cash payment. Ideal for counter sales that settle on the spot.
                </span>
            </span>
            <span class="pos-mode-card__cta">
                <span>Open Cash POS</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </span>
        </a>

        <a class="pos-mode-card pos-mode-card--monthly"
           asp-controller="POS"
           asp-action="Credit"
           title="Credit POS">
            <span class="pos-mode-card__accent" aria-hidden="true"></span>
            <span class="pos-mode-card__icon" aria-hidden="true">
                <i class="bi bi-calendar2-month"></i>
            </span>
            <span class="pos-mode-card__body">
                <span class="pos-mode-card__badge">Credit billing</span>
                <span class="pos-mode-card__title">Credit POS</span>
                <span class="pos-mode-card__desc">
                    Bill monthly customers on credit. Invoice now and settle when payment is collected.
                </span>
            </span>
            <span class="pos-mode-card__cta">
                <span>Open Credit POS</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </span>
        </a>

        <a class="pos-mode-card pos-mode-card--supply"
           asp-controller="POS"
           asp-action="MonthlySupply"
           title="Monthly Supply">
            <span class="pos-mode-card__accent" aria-hidden="true"></span>
            <span class="pos-mode-card__icon" aria-hidden="true">
                <i class="bi bi-calendar2-check"></i>
            </span>
            <span class="pos-mode-card__body">
                <span class="pos-mode-card__badge">Customer supply</span>
                <span class="pos-mode-card__title">Monthly Supply</span>
                <span class="pos-mode-card__desc">
                    Select monthly customers for supply planning and follow-up actions.
                </span>
            </span>
            <span class="pos-mode-card__cta">
                <span>Open Monthly Supply</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </span>
        </a>
    </div>
</div>
