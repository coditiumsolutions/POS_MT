@model MonthlySupplyItemsPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Monthly Supply Items";
    var priceMap = ViewBag.ProductPrices as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var priceJson = JsonSerializer.Serialize(priceMap);
    var fromCustomers = string.Equals(Model.ReturnTo, "Customers", StringComparison.OrdinalIgnoreCase);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center flex-wrap gap-2 monthly-supply-items-title-row">
        <span class="monthly-supply-items-heading">Monthly Supply Items</span>
        <span class="text-muted small mb-0">
            Adding items for <strong class="text-body">@Model.ActiveCustomerCode — @Model.ActiveCustomerName</strong>
        </span>
    </div>
    @if (fromCustomers)
    {
        <a class="btn btn-outline-secondary btn-sm"
           asp-controller="Customers"
           asp-action="Index">Back to customers</a>
    }
    else
    {
        <a class="btn btn-outline-secondary btn-sm"
           href="@Url.Action("MonthlySupply", "POS", new {
               area = Model.ListArea,
               supplyDate = Model.SupplyDate?.ToString("yyyy-MM-dd"),
               selected = Model.CustomerUidsQuery
           })">Back to customers</a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="bg-white border rounded p-3 h-100">
            <h2 class="h6 mb-3">Selected Customers</h2>
            <div class="list-group list-group-flush">
                @foreach (var c in Model.SelectedCustomers)
                {
                    var active = c.Uid == Model.ActiveCustomerUid;
                    <a class="list-group-item list-group-item-action @(active ? "active" : "")"
                       href="@Url.Action("MonthlySupplyItems", "POS", new {
                           customerUids = Model.CustomerUidsQuery,
                           activeCustomerUid = c.Uid,
                           returnTo = Model.ReturnTo,
                           area = Model.ListArea,
                           supplyDate = Model.SupplyDate?.ToString("yyyy-MM-dd")
                       })">
                        <div class="fw-semibold">@c.CustomerName</div>
                        <div class="small @(active ? "" : "text-muted")">@c.CustomerCode</div>
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="bg-white border rounded p-3 mb-3">
            <form asp-action="AddMonthlySupplyItem" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CustomerUid" value="@Model.ActiveCustomerUid" />
                <input type="hidden" name="CustomerUids" value="@Model.CustomerUidsQuery" />
                @if (!string.IsNullOrWhiteSpace(Model.ListArea))
                {
                    <input type="hidden" name="Area" value="@Model.ListArea" />
                }
                @if (Model.SupplyDate is DateTime supplyDay)
                {
                    <input type="hidden" name="SupplyDate" value="@supplyDay.ToString("yyyy-MM-dd")" />
                }
                @if (fromCustomers)
                {
                    <input type="hidden" name="ReturnTo" value="Customers" />
                }
                <div class="col-md-4">
                    <label class="form-label" for="ProductUid">Product</label>
                    <select name="ProductUid" id="ProductUid" class="form-select" asp-items="Model.Products" required>
                        <option value="">Select product…</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="Quantity">Quantity</label>
                    <input type="number" step="0.01" min="0.01" name="Quantity" id="Quantity" class="form-control" value="1" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="UnitPrice">Unit Price</label>
                    <input type="number" step="0.01" min="0" name="UnitPrice" id="UnitPrice" class="form-control" value="0" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="DeliveryCharges">Delivery Charges</label>
                    <input type="number" step="0.01" min="0" name="DeliveryCharges" id="DeliveryCharges" class="form-control" value="0" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="ItemTotal">Item Total</label>
                    <input type="text" id="ItemTotal" class="form-control" value="0" readonly tabindex="-1" />
                </div>
                <div class="col-md-12 col-lg-2">
                    <button type="submit" class="btn btn-primary w-100">Add Item</button>
                </div>
            </form>
            <p class="small text-muted mb-0 mt-2">Item Total = (Quantity × Unit Price) + Delivery Charges</p>
        </div>

        <div class="table-responsive bg-white border rounded p-2">
            <table class="table table-striped table-hover w-100 align-middle mb-0" id="monthlySupplyItemsTable">
                <thead>
                    <tr>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Brand</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Delivery Charges</th>
                        <th class="text-end">Item Total</th>
                        <th style="width:90px"></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-muted text-center py-4">No items yet for this customer.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductCode</td>
                            <td>@item.ProductName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.BrandName) ? "—" : item.BrandName)</td>
                            <td class="text-end">@item.Quantity.ToString("0.##")</td>
                            <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end">@item.DeliveryCharges.ToString("N2")</td>
                            <td class="text-end fw-semibold">@item.ItemTotal.ToString("N0")</td>
                            <td>
                                <form asp-action="DeleteMonthlySupplyItem" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Uid" />
                                    <input type="hidden" name="customerUids" value="@Model.CustomerUidsQuery" />
                                    <input type="hidden" name="activeCustomerUid" value="@Model.ActiveCustomerUid" />
                                    @if (!string.IsNullOrWhiteSpace(Model.ListArea))
                                    {
                                        <input type="hidden" name="area" value="@Model.ListArea" />
                                    }
                                    @if (Model.SupplyDate is DateTime deleteSupplyDay)
                                    {
                                        <input type="hidden" name="supplyDate" value="@deleteSupplyDay.ToString("yyyy-MM-dd")" />
                                    }
                                    @if (fromCustomers)
                                    {
                                        <input type="hidden" name="returnTo" value="Customers" />
                                    }
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this item?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const prices = @Html.Raw(priceJson);
            const productSelect = document.getElementById('ProductUid');
            const qty = document.getElementById('Quantity');
            const unitPrice = document.getElementById('UnitPrice');
            const delivery = document.getElementById('DeliveryCharges');
            const itemTotal = document.getElementById('ItemTotal');
            if (!productSelect || !unitPrice || !qty || !delivery || !itemTotal) return;

            function num(el) {
                const v = Number(String(el.value || '').replace(',', '.'));
                return Number.isFinite(v) ? v : 0;
            }

            function syncItemTotal() {
                const total = (num(qty) * num(unitPrice)) + num(delivery);
                itemTotal.value = String(Math.round(total));
            }

            productSelect.addEventListener('change', function () {
                const key = productSelect.value;
                if (key && prices[key] != null) {
                    unitPrice.value = Number(prices[key]).toFixed(2);
                }
                syncItemTotal();
            });

            ['input', 'change'].forEach(function (evt) {
                qty.addEventListener(evt, syncItemTotal);
                unitPrice.addEventListener(evt, syncItemTotal);
                delivery.addEventListener(evt, syncItemTotal);
            });

            syncItemTotal();
        })();
    </script>
}
