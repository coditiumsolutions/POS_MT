@model MonthlySupplyPageViewModel
@{
    ViewData["Title"] = "Monthly Supply";
    var openCustomer = Model.OpenCustomerUid;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h1 class="page-heading mb-1">Monthly Supply</h1>
    </div>
    <div class="text-muted small align-self-center">
        Selected: <strong id="monthlySupplySelectedCount">0</strong>
    </div>
</div>

<div id="monthlySupplyAlert" class="alert d-none mb-2" role="alert"></div>
@if (TempData["Error"] != null)
{
    <div id="monthlySupplyTempAlert" class="alert alert-danger alert-dismissible fade show mb-2" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div id="monthlySupplyTempAlert" class="alert alert-success alert-dismissible fade show mb-2" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Toolbar form only — checkboxes use form="monthlySupplyForm" so expand-panel forms are not nested (nested forms caused HTTP 400). *@
<form asp-action="MonthlySupplyContinue" method="post" id="monthlySupplyForm">
    @Html.AntiForgeryToken()
    @if (!string.IsNullOrWhiteSpace(Model.Area))
    {
        <input type="hidden" name="area" value="@Model.Area" />
    }
</form>

<div class="mb-3 d-flex flex-wrap gap-2 align-items-end">
    <form asp-action="MonthlySupply" method="get" class="d-flex flex-column" id="monthlySupplyAreaFilterForm">
        @if (Model.OpenCustomerUid is int openUid)
        {
            <input type="hidden" name="openCustomer" value="@openUid" />
        }
        <input type="hidden" name="supplyDate" value="@Model.SupplyDate.ToString("yyyy-MM-dd")" />
        @if (Model.SelectedCustomerUids.Count > 0)
        {
            <input type="hidden" name="selected" value="@string.Join(",", Model.SelectedCustomerUids)" />
        }
        <label for="monthlySupplyArea" class="form-label small text-muted mb-1">Area</label>
        <select id="monthlySupplyArea"
                name="area"
                class="form-select form-select-sm"
                style="width:auto; min-width:10rem;"
                asp-items="Model.AreaOptions"
                onchange="this.form.submit()"></select>
    </form>
    <div>
        <label class="form-label small text-muted mb-1" for="supplyDate">Supply date</label>
        <input type="date"
               name="supplyDate"
               id="supplyDate"
               form="monthlySupplyForm"
               class="form-control form-control-sm"
               value="@Model.SupplyDate.ToString("yyyy-MM-dd")"
               required />
    </div>
    <div style="width: 10rem;">
        <label class="form-label small text-muted mb-1" for="monthlySupplyFilter">Filter customer</label>
        <input type="search" id="monthlySupplyFilter" class="form-control form-control-sm" placeholder="Filter…" autocomplete="off" />
    </div>
    <button type="submit"
            form="monthlySupplyForm"
            formmethod="post"
            class="btn btn-sm monthly-supply-action-btn"
            id="monthlySupplyAddSuppliedBtn"
            formaction="@Url.Action("AddMonthlySupplied", "POS")"
            disabled>
        Save Supplied
    </button>
    <button type="submit"
            form="monthlySupplyForm"
            formmethod="post"
            class="btn btn-sm monthly-supply-action-btn"
            id="monthlySupplyCancelOrderBtn"
            formaction="@Url.Action("CancelMonthlySupplied", "POS")"
            disabled
            title="Cancel Save Supplied for selected customers on this date and restore stock">
        Cancel Order
    </button>
    <button type="submit"
            form="monthlySupplyForm"
            formmethod="post"
            class="btn btn-sm monthly-supply-action-btn"
            id="monthlySupplyContinueBtn"
            disabled>
        Add Item(s)
    </button>
</div>

<style>
    .monthly-supply-action-btn {
        min-width: 9.5rem;
        width: 9.5rem;
        color: #fff;
        background-color: #4f46e5;
        border-color: #4338ca;
    }
    .monthly-supply-action-btn:hover:not(:disabled),
    .monthly-supply-action-btn:focus:not(:disabled) {
        color: #fff;
        background-color: #4338ca;
        border-color: #3730a3;
    }
    .monthly-supply-action-btn:disabled {
        color: #fff;
        background-color: #818cf8;
        border-color: #818cf8;
        opacity: 0.75;
    }
</style>

    <div class="table-responsive bg-white border rounded p-2">
        <table id="monthlySupplyTable" class="table table-hover w-100 align-middle mb-0 monthly-supply-grid">
            <thead>
                <tr>
                    <th style="width:42px">
                        <input type="checkbox" id="monthlySupplySelectAll" class="form-check-input" title="Select all" />
                    </th>
                    <th class="monthly-supply-expand-col" style="width:40px" title="Expand row for monthly items" scope="col">
                        <span class="monthly-supply-expand-hdr" aria-hidden="true">&#9654;</span>
                        <span class="visually-hidden">Expand</span>
                    </th>
                    <th>Code</th>
                    <th>Area</th>
                    <th>Customer Name</th>
                    <th>Items</th>
                    <th class="text-end">Delivery Charges</th>
                    <th class="text-end">Item Total</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Customers.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-muted text-center py-4">No monthly customers found.</td>
                </tr>
            }
            else
            {
                foreach (var c in Model.Customers)
                {
                    <tr class="monthly-supply-customer-row"
                        data-customer-uid="@c.Uid"
                        data-customer-code="@c.CustomerCode"
                        data-customer-name="@c.CustomerName"
                        title="Click ▶ or double-click to view monthly items">
                        <td class="monthly-supply-check-cell">
                            <input type="checkbox"
                                   class="form-check-input monthly-supply-check"
                                   form="monthlySupplyForm"
                                   name="selectedCustomerUids"
                                   value="@c.Uid"
                                   data-uid="@c.Uid"
                                   data-name="@c.CustomerName"
                                   @(Model.SelectedCustomerUids.Contains(c.Uid) ? "checked" : null) />
                        </td>
                        <td class="monthly-supply-expand-cell">
                            <button type="button"
                                    class="monthly-supply-twistee"
                                    aria-expanded="false"
                                    aria-label="Show monthly items for @c.CustomerName"
                                    title="Show monthly items">
                                <span class="monthly-supply-twistee-glyph" aria-hidden="true">&#9654;</span>
                            </button>
                        </td>
                        <td>@c.CustomerCode</td>
                        <td>@(string.IsNullOrWhiteSpace(c.Area) ? "—" : c.Area)</td>
                        <td>@c.CustomerName</td>
                        <td class="monthly-supply-preview-cell">
                            <div class="monthly-supply-row-preview text-muted" data-preview-for="@c.Uid">…</div>
                        </td>
                        <td class="text-end monthly-supply-delivery-cell" data-delivery-for="@c.Uid">…</td>
                        <td class="text-end fw-semibold monthly-supply-total-cell" data-total-for="@c.Uid">…</td>
                    </tr>
                    <tr class="monthly-supply-detail-row d-none" data-detail-for="@c.Uid" aria-hidden="true">
                        <td colspan="8" class="p-0 border-0">
                            <div class="monthly-supply-detail-panel">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 px-3 pt-3">
                                    <strong class="monthly-supply-detail-title">Items — @c.CustomerName</strong>
                                    <span class="text-muted small">Supply date above · use Add Item(s) to edit</span>
                                </div>
                                <div class="monthly-supply-items-loading text-muted px-3 pb-3">Loading items…</div>
                                <div class="monthly-supply-items-host d-none px-3 pb-3"></div>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

@section Scripts {
    @if (Model.Customers.Count > 0)
    {
        <script>
            (function () {
                const forDateUrl = '@Url.Action("CustomerMonthlySupplyForDate", "POS")';
                const summariesUrl = '@Url.Action("CustomerMonthlySupplySummaries", "POS")';
                const supplyDateInput = document.getElementById('supplyDate');

                const selectAll = document.getElementById('monthlySupplySelectAll');
                const checks = Array.from(document.querySelectorAll('.monthly-supply-check'));
                const countLabel = document.getElementById('monthlySupplySelectedCount');
                const continueBtn = document.getElementById('monthlySupplyContinueBtn');
                const addSuppliedBtn = document.getElementById('monthlySupplyAddSuppliedBtn');
                const cancelOrderBtn = document.getElementById('monthlySupplyCancelOrderBtn');
                const filterInput = document.getElementById('monthlySupplyFilter');
                const openCustomerUid = @(openCustomer.HasValue ? openCustomer.Value.ToString() : "null");
                const allCustomerUids = [@string.Join(",", Model.Customers.Select(c => c.Uid))];

                let activeCustomerUid = null;
                const loadedCustomers = new Set();

                function refreshCount() {
                    const selected = checks.filter(function (c) { return c.checked; }).length;
                    countLabel.textContent = String(selected);
                    continueBtn.disabled = selected === 0;
                    if (addSuppliedBtn) {
                        addSuppliedBtn.disabled = selected === 0;
                    }
                    if (cancelOrderBtn) {
                        cancelOrderBtn.disabled = selected === 0;
                    }
                    if (selectAll) {
                        selectAll.checked = selected > 0 && selected === checks.length;
                        selectAll.indeterminate = selected > 0 && selected < checks.length;
                    }
                }

                const form = document.getElementById('monthlySupplyForm');
                const liveAlert = document.getElementById('monthlySupplyAlert');
                const tempAlert = document.getElementById('monthlySupplyTempAlert');

                function showProcessing(message) {
                    if (!liveAlert) return;
                    liveAlert.className = 'alert alert-info mb-2';
                    liveAlert.textContent = message;
                    liveAlert.classList.remove('d-none');
                    liveAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }

                if (tempAlert) {
                    tempAlert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }

                // Disabling the clicked submit button in the same click turn cancels the POST in many browsers.
                function lockToolbarAfterSubmit(activeBtn, busyLabel) {
                    if (activeBtn) activeBtn.textContent = busyLabel;
                    if (cancelOrderBtn && cancelOrderBtn !== activeBtn) cancelOrderBtn.disabled = true;
                    if (continueBtn && continueBtn !== activeBtn) continueBtn.disabled = true;
                    if (addSuppliedBtn && addSuppliedBtn !== activeBtn) addSuppliedBtn.disabled = true;
                    window.setTimeout(function () {
                        if (activeBtn) activeBtn.disabled = true;
                    }, 0);
                }

                if (addSuppliedBtn && form) {
                    addSuppliedBtn.addEventListener('click', function (e) {
                        const selected = checks.filter(function (c) { return c.checked; }).length;
                        if (selected === 0) {
                            e.preventDefault();
                            return;
                        }
                        const day = getSupplyDateValue();
                        if (!supplyDateInput || !supplyDateInput.value) {
                            e.preventDefault();
                            showProcessing('Select a supply date before saving.');
                            return;
                        }
                        showProcessing('Saving supplied for ' + selected + ' customer(s) on ' + day + '…');
                        lockToolbarAfterSubmit(addSuppliedBtn, 'Saving…');
                    });
                }

                if (cancelOrderBtn) {
                    cancelOrderBtn.addEventListener('click', function (e) {
                        const selected = checks.filter(function (c) { return c.checked; }).length;
                        if (selected === 0) {
                            e.preventDefault();
                            return;
                        }
                        const day = getSupplyDateValue();
                        if (!confirm('Cancel supplied order for ' + selected + ' customer(s) on ' + day + '?\n\nStock will be restored to inventory (same as a sales return).')) {
                            e.preventDefault();
                            return;
                        }
                        showProcessing('Cancelling order for ' + selected + ' customer(s) on ' + day + '…');
                        lockToolbarAfterSubmit(cancelOrderBtn, 'Cancelling…');
                    });
                }

                if (selectAll) {
                    selectAll.addEventListener('change', function () {
                        checks.forEach(function (c) { c.checked = selectAll.checked; });
                        refreshCount();
                    });
                }

                checks.forEach(function (c) {
                    c.addEventListener('change', refreshCount);
                    c.addEventListener('click', function (e) { e.stopPropagation(); });
                });

                function detailRowFor(uid) {
                    return document.querySelector('.monthly-supply-detail-row[data-detail-for="' + uid + '"]');
                }

                function customerRowFor(uid) {
                    return document.querySelector('.monthly-supply-customer-row[data-customer-uid="' + uid + '"]');
                }

                function setTwisteeExpanded(customerRow, expanded) {
                    const btn = customerRow?.querySelector('.monthly-supply-twistee');
                    if (!btn) return;
                    btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                    btn.setAttribute('title', expanded ? 'Hide monthly items' : 'Show monthly items');
                }

                function closeAllDetails() {
                    document.querySelectorAll('.monthly-supply-detail-row').forEach(function (row) {
                        row.classList.add('d-none');
                        row.setAttribute('aria-hidden', 'true');
                    });
                    document.querySelectorAll('.monthly-supply-customer-row').forEach(function (row) {
                        row.classList.remove('monthly-supply-row-expanded');
                        setTwisteeExpanded(row, false);
                    });
                    activeCustomerUid = null;
                }

                function formatMoney(n) {
                    return Number(n).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }

                function escapeHtml(text) {
                    if (text == null) return '';
                    return String(text)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;');
                }

                function getSupplyDateValue() {
                    return (supplyDateInput && supplyDateInput.value) ? supplyDateInput.value : new Date().toISOString().slice(0, 10);
                }

                function formatShortQty(n) {
                    const v = Number(n) || 0;
                    return Number.isInteger(v) ? String(v) : v.toLocaleString(undefined, { maximumFractionDigits: 2 });
                }

                function shortItemName(name) {
                    const text = String(name || '—').trim();
                    return text.length > 22 ? text.slice(0, 20) + '…' : text;
                }

                function buildPreviewHtml(lines) {
                    if (!lines || !lines.length) {
                        return '<span class="monthly-supply-preview-empty">—</span>';
                    }
                    const parts = lines.map(function (line) {
                        const name = shortItemName(line.name || line.productName || line.productCode);
                        const qty = formatShortQty(line.qty != null ? line.qty : line.quantity);
                        const price = formatMoney(line.price != null ? line.price : line.unitPrice);
                        return '<span class="monthly-supply-preview-item">' +
                            '<span class="monthly-supply-preview-name">' + escapeHtml(name) + '</span>' +
                            ' <span class="monthly-supply-preview-qp">' + escapeHtml(qty) + '×' + escapeHtml(price) + '</span>' +
                            '</span>';
                    });
                    return parts.join('<span class="monthly-supply-preview-sep"> · </span>');
                }

                function setRowPreview(customerUid, lines, totalDelivery, totalAmount) {
                    const el = document.querySelector('.monthly-supply-row-preview[data-preview-for="' + customerUid + '"]');
                    if (el) {
                        el.classList.remove('text-muted');
                        el.innerHTML = buildPreviewHtml(lines);
                    }
                    const deliveryEl = document.querySelector('.monthly-supply-delivery-cell[data-delivery-for="' + customerUid + '"]');
                    if (deliveryEl) {
                        deliveryEl.classList.remove('text-muted');
                        deliveryEl.textContent = formatMoney(totalDelivery || 0);
                    }
                    const totalEl = document.querySelector('.monthly-supply-total-cell[data-total-for="' + customerUid + '"]');
                    if (totalEl) {
                        totalEl.classList.remove('text-muted');
                        totalEl.textContent = Number(totalAmount || 0).toLocaleString(undefined, { maximumFractionDigits: 0 });
                    }
                }

                function loadRowPreviews() {
                    if (!allCustomerUids.length) return;
                    const day = getSupplyDateValue();
                    document.querySelectorAll('.monthly-supply-row-preview').forEach(function (el) {
                        el.classList.add('text-muted');
                        el.textContent = '…';
                    });
                    document.querySelectorAll('.monthly-supply-delivery-cell, .monthly-supply-total-cell').forEach(function (el) {
                        el.classList.add('text-muted');
                        el.textContent = '…';
                    });
                    fetch(summariesUrl + '?supplyDate=' + encodeURIComponent(day) + '&customerUids=' + encodeURIComponent(allCustomerUids.join(',')), {
                        headers: { 'Accept': 'application/json' }
                    }).then(function (res) {
                        if (!res.ok) throw new Error('Failed to load summaries');
                        return res.json();
                    }).then(function (payload) {
                        const byUid = {};
                        (payload.customers || []).forEach(function (row) {
                            byUid[row.customerUid] = row;
                        });
                        allCustomerUids.forEach(function (uid) {
                            const row = byUid[uid] || {};
                            setRowPreview(uid, row.lines || [], row.totalDeliveryCharges || 0, row.totalAmount || 0);
                        });
                    }).catch(function () {
                        document.querySelectorAll('.monthly-supply-row-preview').forEach(function (el) {
                            el.classList.add('text-muted');
                            el.textContent = '—';
                        });
                        document.querySelectorAll('.monthly-supply-delivery-cell, .monthly-supply-total-cell').forEach(function (el) {
                            el.classList.add('text-muted');
                            el.textContent = '—';
                        });
                    });
                }

                function renderItems(host, customerUid, payload) {
                    const effective = payload.effective || [];
                    const day = payload.supplyDate || getSupplyDateValue();
                    const deliverLines = effective.filter(function (line) {
                        return !line.isSkipped && Number(line.quantity) > 0;
                    });

                    let previewDelivery = 0;
                    let previewTotal = 0;
                    const previewLines = deliverLines.map(function (line) {
                        const qty = Number(line.quantity) || 0;
                        const price = Number(line.unitPrice) || 0;
                        const delivery = Number(line.deliveryCharges) || 0;
                        const itemTotal = line.itemTotal != null
                            ? Number(line.itemTotal)
                            : Math.round((qty * price) + delivery);
                        previewDelivery += delivery;
                        previewTotal += itemTotal;
                        return {
                            name: line.productName || line.productCode,
                            qty: qty,
                            price: price
                        };
                    });
                    setRowPreview(customerUid, previewLines, previewDelivery, previewTotal);

                    if (!deliverLines.length) {
                        host.innerHTML =
                            '<div class="monthly-supply-simple-panel">' +
                            '<p class="text-muted mb-0 py-2">No items to deliver on <strong>' + escapeHtml(day) + '</strong>. Use <strong>Add Item(s)</strong> to set standing supply.</p>' +
                            '</div>';
                        return;
                    }

                    let rows = '';
                    let totalQty = 0;
                    let totalDelivery = 0;
                    let totalAmount = 0;
                    deliverLines.forEach(function (line, index) {
                        const qty = Number(line.quantity) || 0;
                        const price = Number(line.unitPrice) || 0;
                        const delivery = Number(line.deliveryCharges) || 0;
                        const lineTotal = line.itemTotal != null
                            ? Number(line.itemTotal)
                            : Math.round((qty * price) + delivery);
                        totalQty += qty;
                        totalDelivery += delivery;
                        totalAmount += lineTotal;
                        const note = line.isOverride ? ' <span class="text-muted small">(day qty)</span>' : '';
                        rows +=
                            '<tr>' +
                            '<td class="text-muted">' + (index + 1) + '</td>' +
                            '<td>' + escapeHtml(line.productName || line.productCode || '—') + note + '</td>' +
                            '<td class="text-end">' + formatMoney(qty) + '</td>' +
                            '<td class="text-end">' + formatMoney(price) + '</td>' +
                            '<td class="text-end">' + formatMoney(delivery) + '</td>' +
                            '<td class="text-end fw-semibold">' + Number(lineTotal).toLocaleString(undefined, { maximumFractionDigits: 0 }) + '</td>' +
                            '</tr>';
                    });

                    host.innerHTML =
                        '<div class="monthly-supply-simple-panel">' +
                        '<div class="table-responsive border rounded bg-white">' +
                        '<table class="table table-sm table-striped align-middle mb-0 monthly-supply-simple-table">' +
                        '<thead class="table-light"><tr>' +
                        '<th style="width:2.5rem">#</th>' +
                        '<th>Item</th>' +
                        '<th class="text-end">Qty</th>' +
                        '<th class="text-end">Price</th>' +
                        '<th class="text-end">Delivery Charges</th>' +
                        '<th class="text-end">Item Total</th>' +
                        '</tr></thead>' +
                        '<tbody>' + rows + '</tbody>' +
                        '<tfoot><tr class="fw-semibold">' +
                        '<td></td><td class="text-end">Total</td>' +
                        '<td class="text-end">' + formatMoney(totalQty) + '</td>' +
                        '<td></td>' +
                        '<td class="text-end">' + formatMoney(totalDelivery) + '</td>' +
                        '<td class="text-end">' + Number(totalAmount).toLocaleString(undefined, { maximumFractionDigits: 0 }) + '</td>' +
                        '</tr></tfoot>' +
                        '</table></div>' +
                        '<p class="text-muted small mb-0 mt-2">For ' + escapeHtml(day) + ' · ' + deliverLines.length + ' item(s) · Item Total = (Qty × Price) + Delivery Charges</p>' +
                        '</div>';
                }

                function loadItems(customerUid, detailRow, force) {
                    const host = detailRow.querySelector('.monthly-supply-items-host');
                    const loading = detailRow.querySelector('.monthly-supply-items-loading');
                    const day = getSupplyDateValue();
                    const cacheKey = customerUid + '|' + day;
                    if (!force && loadedCustomers.has(cacheKey)) {
                        loading.classList.add('d-none');
                        host.classList.remove('d-none');
                        return Promise.resolve();
                    }

                    loading.classList.remove('d-none');
                    host.classList.add('d-none');
                    loading.textContent = 'Loading supply…';

                    return fetch(forDateUrl + '?customerUid=' + encodeURIComponent(customerUid) + '&supplyDate=' + encodeURIComponent(day), {
                        headers: { 'Accept': 'application/json' }
                    }).then(function (res) {
                        if (!res.ok) throw new Error('Failed to load supply');
                        return res.json();
                    }).then(function (payload) {
                        loadedCustomers.add(cacheKey);
                        renderItems(host, customerUid, payload);
                        loading.classList.add('d-none');
                        host.classList.remove('d-none');
                    }).catch(function () {
                        loading.textContent = 'Could not load supply. Try again.';
                        host.classList.add('d-none');
                    });
                }

                if (supplyDateInput) {
                    supplyDateInput.addEventListener('change', function () {
                        loadedCustomers.clear();
                        loadRowPreviews();
                        if (activeCustomerUid) {
                            loadItems(activeCustomerUid, detailRowFor(activeCustomerUid), true);
                        }
                    });
                }

                function openCustomerDetail(uid) {
                    const detailRow = detailRowFor(uid);
                    const customerRow = customerRowFor(uid);
                    if (!detailRow || !customerRow) return;

                    if (activeCustomerUid === uid) {
                        closeAllDetails();
                        return;
                    }

                    closeAllDetails();
                    activeCustomerUid = uid;
                    detailRow.classList.remove('d-none');
                    detailRow.setAttribute('aria-hidden', 'false');
                    customerRow.classList.add('monthly-supply-row-expanded');
                    setTwisteeExpanded(customerRow, true);
                    loadItems(uid, detailRow, false);
                    detailRow.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }

                document.querySelectorAll('.monthly-supply-customer-row').forEach(function (row) {
                    row.addEventListener('dblclick', function (e) {
                        if (e.target.closest('.monthly-supply-check-cell')) return;
                        const uid = parseInt(row.getAttribute('data-customer-uid'), 10);
                        if (!uid) return;
                        openCustomerDetail(uid);
                    });

                    const twistee = row.querySelector('.monthly-supply-twistee');
                    if (twistee) {
                        twistee.addEventListener('click', function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            const uid = parseInt(row.getAttribute('data-customer-uid'), 10);
                            if (!uid) return;
                            openCustomerDetail(uid);
                        });
                    }
                });

                if (filterInput) {
                    filterInput.addEventListener('input', function () {
                        const q = filterInput.value.trim().toLowerCase();
                        document.querySelectorAll('.monthly-supply-customer-row').forEach(function (row) {
                            const text = row.textContent.toLowerCase();
                            const uid = row.getAttribute('data-customer-uid');
                            const detail = detailRowFor(uid);
                            const show = !q || text.indexOf(q) >= 0;
                            row.classList.toggle('d-none', !show);
                            if (!show && detail) {
                                detail.classList.add('d-none');
                                if (activeCustomerUid === parseInt(uid, 10)) {
                                    activeCustomerUid = null;
                                }
                            }
                        });
                    });
                }

                refreshCount();
                loadRowPreviews();

                if (openCustomerUid) {
                    openCustomerDetail(openCustomerUid);
                }
            })();
        </script>
    }
}
