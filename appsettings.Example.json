{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "POS_MT": "Server=YOUR_SQL_SERVER;Database=POS_MT;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=30",
    "POS_MT_Central": "Server=YOUR_CENTRAL_SQL_SERVER;Database=POS_MT;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=15",
    "POS_MT_Offline": "Data Source=App_Data/pos-offline.db"
  },
  "PosHub": {
    "Mode": "Standard",
    "ShopName": "Shop",
    "StatusPollSeconds": 15,
    "SyncIntervalSeconds": 30,
    "SyncEnabled": true,
    "OfflineSqlitePath": "App_Data/pos-offline.db"
  },
  "Urls": "http://0.0.0.0:5227",
  "StockMovementAnalysis": {
    "FastMovingMaxDaysSinceSale": 30,
    "SlowMovingMinDaysSinceSale": 30,
    "DeadStockMinDaysSinceSale": 90,
    "TrendWindowDays": 30,
    "DecliningTrendRatio": 0.7,
    "MinimumStockToInclude": 0
  }
}
