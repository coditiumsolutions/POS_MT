{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "POS_MT.Services.Sync": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5227",
  "ConnectionStrings": {
    "POS_MT": "Server=YOUR_CENTRAL_SQL_SERVER;Database=POS_MT;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=30",
    "POS_MT_Central": "Server=YOUR_CENTRAL_SQL_SERVER;Database=POS_MT;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true;Connect Timeout=15",
    "POS_MT_Offline": "Data Source=App_Data/pos-offline.db"
  },
  "PosHub": {
    "Mode": "LocalHub",
    "ShopName": "Main Shop",
    "StatusPollSeconds": 10,
    "SyncIntervalSeconds": 30,
    "SyncEnabled": true,
    "OfflineSqlitePath": "App_Data/pos-offline.db"
  }
}
